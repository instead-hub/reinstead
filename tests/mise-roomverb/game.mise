game "roomverb"

lang ru

include stdlib

extend events
  Assist:

room computer "компьютер"

verb Assist
  target = computer
  words = "ассист/ировать"
  patterns = ["{noun}/вн : Assist"]

extend verb #Assist
  target = computer
  words = "ассистировать"

impl computer
  on Assist = "Помощь."

# --- тестовая комната: транскрипт должен что-то видеть ---

room test_room "тестовая комната"
  dsc = "Тестовая комната."

fn start(load)
  player:move test_room
