name: t
lang: ru
include: stdlib

fn helper(s: obj, w: obj): |
  say [[helper]]

obj box:
  words: коробка
  title: Коробка
  score_value: 0

patch box:
  before Take: |
    if s.score_value + 1 > 0:
      say [[патч]]
  on Take: |
    say [[метод]]
  after Drop: use helper
  on Wait: use helper
  on Open, Close: use helper
  after Any: use helper
  on Any: use helper
  on Default: use helper
