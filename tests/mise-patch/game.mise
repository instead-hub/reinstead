game "t"

lang ru

include stdlib

fn helper()
  [[helper]]

obj box "коробка"
  title = "Коробка"
  score_value = 0

impl box
  before Take =
    if s.score_value + 1 > 0
      [[взяли]]
  on Take = [[метод]]
  after Drop = "use &helper"
  on Wait = "use &helper"
  on Open, Close = "use &helper"
  after Any = "use &helper"
  on Any = "use &helper"
  on Default = "use &helper"

# --- тестовая комната: транскрипт должен что-то видеть ---

room test_room "тестовая комната"
  dsc = "Тестовая комната."

impl box
  found_in = test_room

fn start(load)
  player:move test_room
