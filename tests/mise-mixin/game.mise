name: t
lang: ru
include: stdlib

mixin Talkative:
  heard: false
  before Talk: |
    s.heard = true
    say [[поговорили]]

mixin Flying:
  before Climb: |
    say [[взлетел]]

class Bird:
  attrs: animate
  mixin: Flying

Bird eagle:
  words: орёл

obj parrot:
  words: попугай
  mixin: Talkative

obj crow:
  words: ворона
  mixin: Talkative
  before Talk: |
    say [[кар]]
