game "t"

lang ru

include stdlib

mixin Talkative
  heard = false
  before Talk
    s.heard = true
    [[поговорили]]

mixin Flying
  before Climb
    [[взлетел]]

class Bird : animate, Flying

Bird eagle "орёл"

obj parrot "попугай" : Talkative

obj crow "ворона" : Talkative
  before Talk
    [[кар]]
