name: kinds
lang: ru
include: stdlib

fn tick(s: obj): |
  pass

props:
  treasure: ref | fn(s: obj)

type mood:
  - calm, angry

extend type mood:
  - tired

extend refs:
  - home_to

setup:
  fmt: verbose
  take: statue
  game:
    hint_verbs: { "#Look" }
  hero:
    words: ты
  start: |
    player:move hall

story intro:
  dsc: [[Пролог.]]
  after Enter: |
    say [[История началась.]]

scenery sky:
  words: небо
  dsc: [[Небо в облаках.]]

room hall:
  words: зал
  dsc: [[Большой зал.]]
  dict: { "зал" }
  inside: sky
  on Enter: |
    say [[Вы вошли.]]
  on Walk: |
    say [[Вы идёте.]]
  on Look: |
    say [[Вы осматриваетесь.]]
  post Look: |
    say [[Уже осмотрелись.]]
  life Give, Show: |
    say [[Жизнь кипит.]]
  after Turn: |
    say [[Повернулись.]]
  compass_look: |
    if to:
      pass
  scope: |
    pass
  enter: |
    w:noun()
  exit: |
    pass
  onenter: |
    w:noun()
  onexit: |
    pass
  each_turn: |
    pass
  found_in: |
    pass
  door_to: |
    pass
  when_open: |
    pass
  when_closed: |
    pass
  when_on: |
    pass
  when_off: |
    pass
  s_to: garden

door gate:
  words: ворота
  d_to: hall
  n_to: garden

Door gate2:
  words: калитка
  from: hall
  to: garden
  door_to: |
    return hall

room garden:
  words: сад
  dsc: [[Тихий сад.]]
  home_to: hall
  scope:
    - statue
    - relic
  default_Event: Exam

obj statue:
  words: статуя
  attrs: scenery
  mood: calm
  treasure: relic

obj relic:
  words: реликвия
  mood: tired
  disabled: true
  daemon: use tick
  when_open: [[Открыто.]]
  help: [[Подсказка.]]
  disp: [[Реликвия.]]
  gfx: [[relic.png]]
  found_in:
    - garden
  word: |
    return 'реликвия'

obj key:
  words: ключ

obj casket:
  words: шкатулка
  attrs: lockable, locked
  with_key: key
  capacity: 2

verb Probe:
  tag: #Probe
  words: пробовать
  prio: 10
  hint: |
    say [[Подсказка.]]
  patterns:
    - {noun}/вн : Probe

impl game:
  dict: { ["зал/вн"] = "зал" }
  var time: 0
  var Look: 2
