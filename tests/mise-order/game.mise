game "order"

lang ru

include stdlib

# Всё ниже нарочно стоит в «неправильном» порядке: компилятор сам решает, что
# за чем эмиттить — класс-родитель раньше ребёнка, объект раньше `impl`,
# глагол раньше `extend verb` и раньше `verb … for объект` (если цель глагола
# не готова к загрузке, игра падает и транскрипт не пишется вовсе).

extend verb #Exam
  words = "смотри"

event InspectKid: Kid

fn lua_two() -> num
  lua
    return hidden_two

verb Peg for sphere
  words = "покрут/ить"
  patterns = ["{noun}/вн : Peg"]

impl sphere
  found_in = test_room

Kid kid "детёныш"
  x = lua_two

class Kid(Base) : Talkative
  x: num

class Base
  hp = calc_hp

obj sphere "сфера"
  dsc = "Гладкая сфера."
  before Peg = "покрутили"

mixin Talkative
  before Talk = "поговорили"

fn calc_hp() -> num
  return 7 + bonus_val

fn bonus_val()
  return BONUS

const BONUS = 3

lua
  local hidden_two = 2

room test_room "тестовая комната"
  dsc = "Тестовая комната."

impl kid
  found_in = test_room

fn start(load)
  player:move test_room

impl game
  before Inv =
    say "kid: hp={kid.hp} x={kid.x}"
