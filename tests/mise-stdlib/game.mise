name: stdlib
lang: ru
include: stdlib

room hall:
  words: зал
  dsc: [[Зал.]]
  OnError: |
    say (err)

fn describe(s: obj) -> str: |
  return 'Ящик.'

lua: |lua
  function lua_probe(s, w, wh)
    return false
  end

obj box:
  words: ящик
  attrs: container,open
  description: &describe
  before Take: &lua_probe

obj note:
  words: записка
  before Disrobe: 'pass'
  description: 'use heal'
  scope: { box, note }

fn probe(w: obj, t: tbl, ev: event): |
  time()
  time(5)
  say(time())
  hasnt(w, open)
  once(w, 'tag')
  once(w)
  w:once tag
  w:once
  subaction(ev)
  subaction(ev, w, w)
  xaction(ev, w)
  daemonStart(w)
  daemonStop(w)
  enable(w)
  disable(w)
  isDaemon(w)
  getDaemons()
  disabled(w)
  walkin(hall)
  take(w)
  drop(w)
  pairs(t)
  ipairs(t)
  walkout()
  visits(w)
  xevent()
  visited(w)
  access(w)
  offerslight(w)
  visible_scope(hall)
  inroom(w)
  thedark(w)
  multi_alias(w)
  gram(w)
  walkback()
  walkback(w)
  walkback
  remove(w)
  add(inv(), w)
  del(inv(), w)
  inv():add(w)
  say(0)
  append(0)
  say(box)
  say('x', 1, w)
  line(1, 2)
  push(w)
  push(w, w)
  pop()
  pop(w)
  pop
  empty()
  empty(w)
  empty
  if empty:
    say(0)
  check_held(w)
  check_live(w)
  check_touch()
  check_worn(w)
  clear()
  cls_prompt()
  need_scene(w, true)
  player_moved()
  lifeon(w)
  lifeoff(w)
  call_before(w, ev)
  runmethods(before, Take, w)
  runorval(w, 'inv')
  theme_name()
  pclr()
  ref('box')
  arg_word(1)
  tiny()
  music('x')
  rnd(1)
  local xs = inv()
  len(xs)
  local daemons = getDaemons()
  len(daemons)
