name: Хейди
lang: ru
include: stdlib

patch game:
  hint_verbs: { "#Exam", "#Walk", "#Take", "#Drop" }

setup:
  dsc: [[^Пример простой игры на Inform.
^Авторы: Роджер Фирт (Roger Firth) и Соня Кессерих (Sonja Kesserich).
^Перевод Юрия Салтыкова a.k.a. G.A. Garinson^
^Перевод на МЕТАПАРСЕР 3 выполнил Петр Косых.
^
]]
  hero:
    words: ты/жр,2л
    description: Здесь нет зеркала.
    capacity: 1
  start: |
    player:move before_cottage

room before_cottage:
  words: перед домом
  title: Перед домом
  dsc: Ты стоишь около избушки, на восток от которой раскинулся лес.
  e_to: forest
  in_to: |
    say Такой славный денек... Он слишком хорош, чтобы прятаться внутри.
  cant_go: Единственный путь ведет на восток.
  with:
    obj cottage:
      words: домик,дом|избушка,избу*,терем*,коттедж*,хат*,строени*
      attrs: scenery
      description: Домик мал и неказист, но ты очень счастлива, живя здесь.
      before Enter: [[Такой славный денек...
                    Он слишком хорош, чтобы прятаться внутри.]]

room forest:
  words: чаща|лес
  title: В лесной чаще
  dsc: [[На западе, сквозь густую листву, можно разглядеть небольшое строение.^
            Тропинка ведет на северо-восток.]]
  w_to: before_cottage
  ne_to: clearing
  with:
    obj bird:
      words: птенчик,птенец|птица,птичка|детёныш
      attrs: ~animate
      description: Слишком мал, чтобы летать, птенец беспомощно попискивает.
      before Listen: Жалобный писк испуганной птички разрывает тебе сердце.^Надо помочь!

room clearing:
  words: полянка,поляна
  title: Полянка
  dsc: [[Посреди полянки стоит высокий платан.
             Тропинка вьется меж деревьев, уводя на юго-запад.]]
  sw_to: forest
  u_to: top_of_tree
  with:
    obj nest:
      words: гнездо|мох|прутики,прутья
      attrs: container, open
      description: |
        say Гнездо сплетено из прутиков и аккуратно устлано мхом.
        content s
    obj tree:
      words: платан|дерево|ствол
      attrs: scenery
      description: [[Величавое дерево стоит посреди поляны.
        Кажется, по его стволу будет несложно влезть наверх.]]
      before Climb: |
        player:move top_of_tree

room top_of_tree:
  words: верхушка
  title: На верхушке дерева
  dsc: На этой высоте цепляться за ствол уже не так удобно.
  d_to: clearing
  after Drop: |
    w:move clearing
    pass
  with:
    obj branch:
      words: сук|ветка
      attrs: supporter, static
      description: Сук достаточно ровный и крепкий, чтобы на нем надежно держалось что-то не очень большое.
      each_turn: |
        if bird:inside nest and nest:inside branch:
          walk happyend

ending happyend:
  title: Конец
  dsc: Поздравляем! Вы прошли игру.
