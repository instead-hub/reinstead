game "say"

lang ru

include stdlib

fn note(t: str)
  lua
    p(t)

obj x "вещь"

fn start(load)
  player:move test_room

impl game
  before Inv =
    "x"
    "x:noun()"
    say (x:noun)
    line "line text"
    "append text"~
    note "raw words"
    note (x:noun)

room test_room "тестовая комната"
  dsc = "Тестовая комната."

impl x
  found_in = test_room
