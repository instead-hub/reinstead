game "say"

lang ru

include stdlib

fn note(t: str)
  lua
    p(t)

fn raw_ml() -> str
  lua
    return [[m
n]]

fn slen(t: str) -> num
  lua
    return #t

fn esc_ml() -> str
  return "a\nb"

fn tri_ml() -> str
  return """
c
d"""

obj x "вещь"
  pri = 3

fn start(load)
  player:move test_room

impl game
  before Inv =
    "x"
    "x:noun()"
    say (x:noun)
    line "line text"
    "append text"~
    note "raw words"
    note (x:noun)
    say "ml={slen esc_ml},{slen tri_ml},{slen raw_ml}"
    # `..` слабее `+`, как в Lua: склеиваем уже сумму
    say ("n=" .. x.pri + 1)
    say (x.pri + 1 .. "!")

room test_room "тестовая комната"
  dsc = "Тестовая комната."

impl x
  found_in = test_room
