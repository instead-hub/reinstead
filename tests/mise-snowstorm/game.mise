name: Метель
version: 2.1
author: Peter Kosyh & Pakowacz
info: Что тебя ждёт за снежной пеленой?
lang: ru
fmt: dash, quotes

global:
  blizzard: 0

lua:
~~~lua
function pic_push(name)
end

function pic_pop()
end

function pic_set(name)
end

include "pic"
--"фонарик,фонарь"
--"сообщения|сообщение"
~~~

story intro:
  text: "Старенький синий седан едет по заснеженной трассе. Внутри машины -- двое.^^\n\t\tВедёт машину усталая женщина лет 35. На заднем сидении справа сидит её дочь -- девочка-подросток.^^\n\t\tДевочка прислонилась лбом к холодному стеклу. Мать продолжает начатый разговор...^^\n\t\t-- Вот увидишь, тебе там понравится."
  enter(): ~~~do
    pic_set('1')
  ~~~
  next_to: "В машине"

obj браслет:
  words: "браслет"
  attrs: clothing
  on:
    after wear: "Надев браслет на правое запястье, ты чувствуешь, что на душе у тебя потеплело."
    disrobe(s): ~~~do
      if visited 'gotmirror':
        p "Тебе кажется, что в этом странном месте лучше никогда не снимать этот браслет!"
      else:
        return false
    ~~~
    exam(s): ~~~do
      p "Этот детский браслет мама подарила тебе на Рождество, когда тебе было ещё 9 лет.\nПросто игрушка. Леска, на которую нанизаны бусинки и пластмассовое сердечко.";
      if s:once():
        p "Странно, что он оказался в бардачке... Ты думала, что он давно потерялся."
    ~~~
    give(s, w): ~~~do
      if w ^ 'королева':
        walk 'badend4'
        return
      return false
    ~~~

class Title(cutscene):
  attrs: noprompt
  on:
    default(s, ev): ~~~do
      if ev == 'Next':
        return false
      mp:clear()
      me():need_scene(true)
    ~~~
  OnError(s): ~~~do
    mp:clear()
    std.pclr()
  ~~~
  title: false

class Prop:
  attrs: scenery
  on:
    default(s, ev): ~~~do
      p ("Тебе нет дела до ", s:noun 'рд', ".")
    ~~~

class Useless:
  on:
    default(s, ev): ~~~do
      p ("Тебе нет дела до ", s:noun 'рд', ".")
    ~~~

room "В машине":
  words: "машина"
  on:
    listen(s): ~~~do
      if seen '#мама':
        p "Ты слышишь шум мотора и музыку, доносящуюся из радио.";
      else:
        p "В машине играет радио."
    ~~~
  before_Cry(s): ~~~do
    if seen '#мама':
      p "-- Прекрати истерику! -- произносит мать."
    else:
      return false
  ~~~
  daemon(s): ~~~do
    local t = { "Машину потряхивает на снежных ухабах."; "По другую сторону окна кружатся снежинки."; "Вы проезжаете мимо занесённых снегом коттеджей."; "Машину слегка заносит на снежной дороге."; }
    if blizzard >= 2:
      blizzard = blizzard + 1
      if blizzard < 7 and blizzard > 3:
        pic_set '2-pan-left'
      if blizzard > 5:
        enable '#заправка'
        disable '#метель'
        if blizzard == 7:
          p "Мать заглушила двигатель."
          return
        if blizzard == 8:
          pic_set '7'
          p "-- Подожди меня, я скоро вернусь. -- говорит тебе мать и выходит из машины, захлопывая за собой дверь.";
          remove '#мама'
          return
        if blizzard == 11:
          p "Ты ждёшь мать, но её все нет. Может быть, выйти из машины?"
          return
        if blizzard > 8:
          return
        p "Вы подъезжаете к заправке."
        return
    if here() == s and rnd(100) <= 25:
      pn (t[rnd(#t)])
  ~~~
  dsc: "Ты сидишь на заднем сидении машины и смотришь в окно."
  enter(s): ~~~do
    s:daemonStart()
    _'#мама':daemonStart()
  ~~~
  exit(): ~~~do
    if seen '#мама':
      _'#мама':daemonStop()
  ~~~
  out_to(s): ~~~do
    if blizzard < 7:
      p "Лучше не делать этого, пока машина движется."
    elseif seen '#мама':
      p "Там холодно."
    else:
      s:daemonStop()
      if not have 'скрипка':
        move('скрипка', 'машина')
      if not have 'телефон':
        move('телефон', 'бардачок')
      walk 'метель1'
  ~~~
  with:
    obj #мама:
      words: "мать,мама,женщина"
      attrs: animate
      on:
        ask, tell, talk(s): ~~~do
          if visited 'разговор1':
            if _'телефон'.seen and have 'телефон':
              p "-- Я не буду с тобой разговаривать, пока ты не отдашь мне телефон! Ну же!"
              return
            if blizzard > 0:
              if blizzard >= 2:
                p "-- Мама! Это важно!^"
                if not disabled '#заправка':
                  p "-- Сейчас заправимся и поговорим."
                else:
                  p "-- Скоро заправка, подожди пять минут и поговорим!"
                return
              p "-- Мама! Посмотри, там справа. Что то странное...^"
              p "-- Не отвлекай меня от дороги!"
              pic_set '6'
              blizzard = 2
              return
            p "Ты не решаешься поговорить с ней."
            return
          walk 'разговор1'
        ~~~
        exam: "Твоя мать очень много работает и поэтому выглядит усталой."
        kiss: "Ты зла на свою мать и сейчас ваши отношения нельзя назвать близкими."
      daemon(s): ~~~do
        local t = { "-- Ты не собираешься со мной поговорить?"; "-- Почему ты молчишь?"; "-- Давай поговорим?"; "-- Ну, чего ты молчишь?"; }
        s.time = s.time + 1
        if s.time > 3:
          if rnd(3) == 1:
            p (t[rnd(#t)])
            p " -- обращается к тебе мать.";
      ~~~
      init_dsc: "Машину ведёт твоя мать."
      time: 0
    Prop:
      words: "бардачок"
      on:
        exam(s): ~~~do
          if _'телефон':inside 'бардачок':
            p "Бардачок закрыт."
            return
          p "Тебе нет до него дела."
        ~~~
        open: "Ты не можешь дотянуться до него с заднего сидения."
    Prop:
      words: "дверь"
      on:
        close: "Дверь закрыта."
        enter(s): ~~~do
          mp:xaction("Exit")
        ~~~
        open(s): ~~~do
          mp:xaction("Exit")
        ~~~
    Prop:
      words: "руль|радио"
    obj #метель:
      words: "метель,буря|смерч|клубы"
      attrs: scenery
      disabled: true
      on:
        default: "Она пока ещё далеко."
        exam: "Буря, метель или ... смерч? Что бы это ни было, оно пугает тебя."
    obj:
      words: "окно,стекло"
      nam: "#окно"
      attrs: scenery, openable
      on:
        open: "Слишком холодно, чтобы опускать стекло."
        search, exam(s): ~~~do
          if not disabled '#заправка':
            p "За стеклом ты видишь смутный силуэт заправки.";
            return
          if visited 'разговор1' and _'телефон'.seen:
            if blizzard == 0:
              pn "Разглядывая белоснежный пейзаж, ты замечаешь вдали нечто странное."
              enable '#метель'
              blizzard = 1
              pic_set '5'
            pn "Ты видишь, как по земле ползут огромные клубы пара или снега."
            p "Огромная снежная буря, накрывая деревья, движется к трассе!"
            return
          p "Ты видишь, как за стеклом кружится метель.";
          if s:once():
            pic_set '2-pan-left'
        ~~~
    Prop #заправка:
      words: "заправка"
      disabled: true
      on:
        exam: "Сквозь метель ты едва различаешь темные очертания заправки."
  with: скрипка

talk разговор1:
  title: false
  enter: ~~~do
    pic_set('3')
  ~~~
  intro: [[-- Я говорю, тебе там понравится. Там хорошая школа, я узнавала... И музыкальная школа совсем недалеко. -- ты слышишь в голосе матери настойчивость.]];
  option:
    ask: 'Я устала терять друзей.',
    reply: '-- Ты же знаешь, что это необходимо! Я должна работать, чтобы ты смогла учиться в хорошем вузе! И это не конец света! На новом месте заведёшь новых друзей.',
    goto: дальше
  option:
    ask: 'Хорошо, мама...',
    reply: '-- Ну что ты вечно строишь из себя мученика? Ты всего-лишь меняешь школу. Я работаю на твоё будущее и никакой благодарности!',
    goto: дальше
  label дальше:
    option:
      ask: 'Я заранее знаю всё, что ты скажешь!';
      reply: '-- Ну зачем ты так? Ты стала такой грубой!';
    option:
      ask: 'Ты меня не поймёшь.';
      reply: '-- А тебе не приходило в голову, что мне тоже было 13 лет?';
    option:
      ask: 'Просто мне очень плохо.';
      reply: '-- Ты ведёшь себя как эгоистичный ребёнок. Ты думаешь мне легко?';
      option:
        ask: 'Я ненавижу твою работу!',
        reply: '-- Ты неблагодарная! Вместо поддержки, ты снова треплешь мне нервы!';
        option:
          ask: 'Я устала от твоих скандалов. Замолчи!';
          reply: '-- Ты это матери говоришь? Таким тоном? Как ты... можешь!';
        option:
          ask: 'Давай просто закончим этот разговор.';
          reply: '-- Ты жестокая! Я отдала тебе все! И это моя самая большая ошибка!';
          option:
            ask: 'Мама, прекрати!';
            do: ~~~do
              p '-- Да, не ожидала я... Что у меня такая дочь...';
              if have 'телефон':
                DaemonStart 'телефон'
              walkback()
            ~~~
      option:
        ask: 'Ты могла бы сменить работу...',
        reply: '-- Да? И получать гроши. И кто оплатит твоё обучение?';

obj телефон:
  words: `function(s) pr (-"мобильный телефон,телефон,мобильник,смартфон"); if s.flash then pr "|фонарик,фонарь" end if have(s) and here() ^ 'В машине' then pr "|сообщения|сообщение"; end  end`
  attrs: switchable, on, multi
  on:
    exam(s): ~~~do
      if not s:has 'on':
        p "Телефон выключен."
        return
      if s:has 'light':
        p "В телефоне включён фонарик."
        return
      if seen '#мама':
        p "Ты собираешься проверить новые сообщения, но\nтвоя мать замечает это в зеркале заднего вида.^\n-- Ты круглые сутки сидишь с телефоном! Отдай его мне, сейчас же!";
        s.seen = true
        s:daemonStop()
      else:
        if not s.flash and mp:thedark():
          p "Тебе приходит в голову мысль, что можно посветить телефоном..."
          s.flash = true
          return
        if not s.compass:
          p "Странно, нет приёма..."
        if here()^'поле' or here()^'В лесу':
          if not s.compass:
            p "Но в твоём смартфоне есть компас. И, похоже, он работает! Теперь ты можешь ориентироваться по сторонам света."
            s.compass = true
          else:
            p "Здорово, что в твоём смарфоне есть компас! В целях экономии батареи ты включаешь режим \"в полёте\"."
        else:
          p "Это твой старенький китайский смартфон. В основном, ты используешь его для социальных сетей."
          p "А сейчас он служит тебе компасом."
          if s.flash then p "И фонариком." end
    ~~~
    give(s, w): ~~~do
      if w ^ '#мама':
        p "Ты протягиваешь телефон матери, она молча забирает его и кладёт в бардачок."
        if not s.seen:
          s.seen = true
          s:daemonStop()
          p "^Мать выглядит немного удивлённой -- ведь ты обычно тяжело расстаёшься со своим смартфоном."
        move(s, 'бардачок')
        pic_set '4'
        return
      return false
    ~~~
    switchoff(s): ~~~do
      if s:has 'light':
        p "Ты выключила фонарик в телефоне."
        s:attr '~light'
        pl:need_scene(true)
        return
      if s:multi_alias() == 2:
        p "Фонарик и так выключен."
        return
      if s.compass:
        p "Если ты выключишь телефон, ты лишишься компаса."
        return
      if not s.seen:
        p "Ты не любишь, когда твой смартфон выключен."
        return
      return false
    ~~~
    switchon(s): ~~~do
      if s:multi_alias() == 2:
        s:before_Light()
        return
      if not s.flash and mp:thedark():
        p "Тебе приходит в голову мысль, что в телефоне есть фонарик и его можно включить..."
        s.flash = true
        return
      return false
    ~~~
  before_Burn,Light(s): ~~~do
    s.flash = true
    if s:has 'light':
      p "Фонарик в телефоне и так включён."
      return
    if not mp:thedark():
      p "Тут и так светло."
      return
    p "Ты включила в мобильнике фонарик."
    pl:need_scene(true)
    s:attr 'light'
  ~~~
  compass: false
  daemon(s): ~~~do
    if rnd(10) > 3:
      p "Ты слышишь сигнал входящего сообщения на своём смартфоне."
  ~~~
  each_turn(s): ~~~do
    if here() ^ 'пещера2' and s:has'light' and not here().solved:
      p "В ту же секунду ты слышишь хлопанье крыльев и успеваешь заметить,\nкак множество чёрных теней бросаются к тебе с потолка. Инстинктивно ты успеваешь выключить фонарик. Удивительно, но это успокаивает тварей. Некоторое время ты слышишь шум их крыльев. Затем всё затихает."
      s:attr'~light'
      return
    if here():has 'light' and s:has 'light':
      p "В целях экономии заряда ты выключила фонарик."
      s:attr '~light'
  ~~~
  flash: false
  seen: false

obj скрипка:
  words: "скрипка"
  on:
    exam: "Твоя скрипка. Тебе остался год, чтобы закончить музыкальную школу. Если честно, благодаря музыкальной школе ты стала ненавидеть музыку."
  after_Play: "У тебя сейчас нет настроения играть."
  init_dsc: "Рядом лежит скрипка."

verb Attack2:
  words: "[|раз]бить,[|раз]бей"
  patterns:
    - {noun}/вн,scene : Attack

verb PutOn:
  words: "повес/ить"
  patterns:
    - {noun}/вн,held на {noun}/вн,scene : PutOn
    - ~ на {noun}/вн,scene {noun}/вн,held : PutOn reverse

verb Play:
  words: "играть,сыграть"
  patterns:
    - на {noun}/пр : Play
    - " : Play"
  on(s, w): ~~~do
    if not w:
      mp:xaction("Play", _'скрипка')
      return
    if w ~= _'скрипка':
      p "Ты умеешь играть только на скрипке."
      return
    if not have 'скрипка':
      p "Сначала тебе нужно взять скрипку в руки."
      return
    return false
  ~~~

verb Light:
  words: "[|по|под]свети/ть,[|по|свеч/у,освети/ть"
  patterns:
    - {noun}/тв,held : Light
  on(s, w): ~~~do
    if mp:check_held(w):
      return
    p "{#First} не {#if_hint/#first,plural,могут,может} светить."
  ~~~
  hint: `function(s) return mp:thedark() and have 'телефон'  end`

verb Cry:
  words: "[|по|за]крич/ать,[|по]звать,крикн/уть,[|за|по]плак/ать,[|за|по]плач/ь"
  patterns:
    - ": Cry"
  on(s, w): "Это тебе не поможет."

verb Fun:
  words: "[|по|рас|за]смеяться,[|по|за|рас]смей/ся,[|по|за|рас]смею/сь,[|по|за|рас]хохо/таться"
  patterns:
    - ": Fun"
  on(s, w): "Ты глупо смеёшься."

verb Knock:
  words: "[|по]стуч/ать"
  patterns:
    - в {noun}/вн : Knock
    - по {noun}/дт : Knock
  on(s, w): ~~~do
    if mp:check_live(w):
      return
    if mp.args[1].word == 'в':
      p "Ты постучала в"
      p (w:noun'вн', ".")
    else:
      p "Ты постучала по"
      p (w:noun'дт', ".")
    p "Ничего не произошло."
  ~~~

verb Tune:
  words: "настро/ить,настра/ивать"
  patterns:
    - {noun}/вн : Tune
  on(s, w): ~~~do
    p ("Тебе не нужно настраивать ", w:noun 'вн', ".")
  ~~~

verb Photo:
  words: "[|с|по]фото/графировать"
  patterns:
    - "Photo"
  on(s): ~~~do
    if not have 'телефон':
      p "Дебе нечем делать снимки.";
    elseif mp:thedark():
      p "Нет света. Может быть, посветить телефоном?"
    else:
      local t = { "Ты делаешь пару неудачных фоток и удаляешь их из телефона."; "Ты сделала удачную фотку."; "Ты сделала пару фоток и селфи."; }
      p(t[rnd(#t)])
  ~~~

setup:
  dsc: false
  take: телефон
  hero:
    words: ты/жр,2л
    description: "Тебя зовут Вера. Тебе почти 13 лет."
    on:
      letgo(s, w, ww): ~~~do
        if w ^ 'телефон':
          local s = w
          if s.compass and ww ~= pl:
            p "В телефоне есть компас, который тебе нужен."
            return
          return false
        elseif w ^ 'скрипка' and here() ^ 'пещера2' and mp:thedark():
          p "Ты не хочешь расставаться со своей скрипкой."
          return
        elseif w ^ 'осколки':
          local s = w
          if not here() ^ 'пещера2':
            return false
          p "Ты бросаешь осколки кристалла на пол пещеры. Маленькие светящиеся огоньки рассыпаются по ледяной поверхности. В тот же момент, пещеру заполняет шум хлопающих крыльев.";
          here().solved = true
          drop(s)
          return
        return false
      ~~~
  init: ~~~do
    if theme.name() == '.mobile' or theme.name() == '.mobile2':
      mp.togglehelp = true
      mp.autohelp = true
      mp.autohelp_limit = 1000
      mp.compl_thresh = 0
    else:
      mp.togglehelp = false
      mp.autohelp = false
      mp.autohelp_limit = 8
      mp.compl_thresh = 1
  ~~~
  start: ~~~do
    if not load:
      move(pl, 'intro')
  ~~~
  game:
    hint_verbs: `{"#Exam","#Drop","#LookIn","#ThrowAt","#Walk","#Take","#Play","#Give","#Touch","#Attack2","#Talk","#Cry","#Open","#Close","#Jump","#Wait","#Wear","#Sit","#Exit","#SwitchOn","#SwitchOff","#PutOn","#Light"}`

story метель1:
  text: "Ты открываешь дверь и толкаешь её наружу.^^\n\t\tТы чувствуешь, как ветер давит на дверь с другой стороны, но ты сильней и вот -- дверь открыта.^^\n\t\tХолод, вместе с вихрем злых снежинок, быстро забирается внутрь салона.^^\n\t\tТы выходишь из машины когда...^^\n\t\tНа тебя обрушивается..."
  enter(s): ~~~do
    pic_set('75')
    if std.ref'mplayer':
      lifeon 'mplayer'
  ~~~
  exit(s): ~~~do
    pic_set('81')
  ~~~
  next_to: "метель2"
  title: false

Title метель2:
  text: "{$fmt y,50%}{$fmt c|{$fmt b|МЕТЕЛЬ}}^^\n{$fmt c|Игра на ЗОК-2019}^^^\n{$fmt em|{$fmt c|Код: Пётр Косых^Графика: Pakowacz}}"
  exit(s): ~~~do
    pic_set('20-pan')
  ~~~
  next_to: "поле"

obj машина:
  words: "машина|дверь"
  attrs: container, openable, open, static, enterable, light
  on:
    after close(s): ~~~do
      if _'перо':inside(s) and not have 'перо':
        p "Когда ты захлопнула дверь машины, перо упало с крыши в снег."
        move('перо', 'поле')
        return
      return false
    ~~~
    switchoff: "Двигатель не работает."
    switchon: "Тебе не удаётся завести машину. Впрочем, ты все-равно не умеешь водить."
  description(s): ~~~do
    if s:multi_alias() == 2:
      p "Тебе нет дела до двери."
      return
    return false
  ~~~
  dsc(s): ~~~do
    p "В снегу стоит машина.";
    if _'перо':where() == s and _'перо':hasnt 'moved':
      _'перо':init_dsc()
  ~~~
  inside_dsc: "Ты находишься в машине."
  with:
    obj радио:
      words: "радио"
      attrs: static, switchable, on
      on:
        after switchon: "Ты включаешь радио. Шум помех нарушает тишину."
      before_Turn,Tune(s): ~~~do
        if s:hasnt 'on':
          p "Радио выключено."
          return
        p "Ты пытаешься поймать какую-нибудь волну, но на всех частотах только шум помех.";
      ~~~
      when_off: false
      when_on: "Радио в машине издаёт помехи."
    obj бардачок:
      words: "бардачок|перчаточный ящик"
      attrs: static, openable, container
      on:
        exam(s): ~~~do
          if s:hasnt'open':
            p "Бардачок закрыт."
            return
          return false
        ~~~
      when_closed: "Твоё внимание привлекает бардачок."
      when_open: "Бардачок открыт."
      with: браслет

handler have_compass(): ~~~do
  return have 'телефон' and _'телефон'.compass
~~~

handler check_compass(w): ~~~do
  if w == 'u_to' or w == 'd_to' or w == 'in_to' or w == 'out_to':
    return
  if not have_compass():
    p [[Чтобы ориентироваться в пространстве, тебе нужен компас.]]
    return true
  return
~~~

class Area(room):
  cant_go(s, w): ~~~do
    if check_compass(w):
      return
    return false
  ~~~
  compass_look(s, w): ~~~do
    if check_compass(w):
      return
    if w == 'u_to':
      mp:xaction("Exam", _'#небо')
      return
    if w == 'd_to':
      mp:xaction("Exam", _'#снег')
      return
    return false
  ~~~

class Snow:
  words: "снег"
  attrs: scenery, supporter
  on:
    after receive(s, w): ~~~do
      move(w, here())
      return false
    ~~~
    enter, walk: "Ты и так стоишь среди снега."
    receive(s, w): ~~~do
      if here() ^ 'В лесу':
        p ("Потом ", w:noun'вн', " сложно будет найти.")
      else:
        return false
    ~~~
    take(s): "Тебе не хочется играть в снежки."

class Sky:
  words: "небо|облака"
  attrs: scenery
  on:
    default: "Небо далеко..."
    exam(s): "Бледное небо нависло над головой. Солнца не видно."

Area поле:
  words: "поле"
  on:
    listen(s): ~~~do
      if _'радио':hasnt'on':
        p "Стоит звенящая тишина.";
      else:
        p "Ты слышишь шум радиопомех из машины."
    ~~~
    walk(s): ~~~do
      if where(pl) ^ 'машина':
        p "Машина не заводится. Придётся выйти и идти пешком."
        return
      return false
    ~~~
  before_Cry: "-- Ма-маааааа! -- нет ответа."
  dsc(s): ~~~do
    p "Ты стоишь в заснеженном поле."
    if have_compass():
      p "На западе начинается хвойный лес."
    else:
      p "Неподалёку начинается хвойный лес.";
  ~~~
  n_to,ne_to,e_to,se_to,s_to(s, t): ~~~do
    if mp.event == 'Exam':
      return false
    if check_compass('w_to'):
      return
    p ("Ты идешь некоторое время на ", (_('@'..t).word), ".")
    p ("Ничего не меняется. Вокруг все-такой же пустынный пейзаж. Ты решаешь вернуться к машине.")
  ~~~
  onenter(s): ~~~do
    if visited(s):
      return
    p "Холод. Ты лежишь в снегу и медленно приходишь в себя.^\nНекоторое время ты смотришь в небо. Затем поднимаешься на ноги и оглядываешься.^\nСтранно, но ты не видишь никакой заправки. Впрочем, и трассы тоже.";
  ~~~
  out_to(): "Сначала нужно решить, куда тебе идти."
  w_to,nw_to,sw_to(s): ~~~do
    if check_compass('w_to'):
      return
    return "#лес"
  ~~~
  with:
    Sky:
      nam: "#небо"
    Snow:
      nam: "#снег"
      on:
        exam(s): ~~~do
          p "Ты видишь запорошенные снегом следы, которые ведут в лес."
          enable '#следы'
        ~~~
    obj:
      words: "хвойный лес,лес|чаща|деревья"
      nam: "#лес"
      attrs: scenery
      on:
        default: "Лес далеко."
        exam: "На деревьях лежит снег."
        walk, enter, climb(s): ~~~do
          walk 'В лесу';
        ~~~
    obj #следы:
      attrs: scenery
      on:
        exam: "Следы уже почти скрылись под свежим снегом."
    Prop:
      words: "колёса|колесо|двери"
  with: машина

lua:
~~~lua
game:dict {
  ["деревья/мн,С"] = {
    "деревья/им";
    "деревья/вн";
    "деревьев/рд";
    "деревьями/тв";
    "деревьях/пр";
    "деревьям/дт";
  };
  ["огонь/вн"] = "огонь";
  ["стены/рд"] = "стен";
  ["голем/рд"] = "голема";
  ["голем/дт"] = "голему";
  ["голем/тв"] = "големом";
  ["голем/вн"] = "голема";
  ["голем/пр"] = "големе";
}
~~~

obj олень:
  words: "олень"
  attrs: supporter
  disabled: true
  on:
    enter, climb(s): ~~~do
      if where(pl) == s:
        p "Но ты уже и так на олене."
        return
      if not s.sit:
        s:before_Touch()
        return
      if not have 'перо':
        p "Ты подумала, что тебе стоит сначала взять с собой перо странной совы. Кто знает, куда умчит тебя олень?"
        return
      s:daemonStop()
      s.sit = false
      if here() ^ 'В лесу':
        walk 'к хребту'
      else:
        walk 'к поляне'
    ~~~
    exam(s): ~~~do
      if s.sit:
        p "Олень стоит перед тобой на коленях."
      else:
        if s:once():
          p "Ты замечаешь, что у оленя странные глаза."
        else:
          p "Чёрные дырки-глаза оленя пугают тебя."
    ~~~
    touch, talk, ask, tell, kiss(s): ~~~do
      s.step = 4
      p "Олень попятился и шумно задышал, жадно втягивая морозный воздух."
    ~~~
  daemon(s): ~~~do
    s.step = s.step + 1
    if s.step > 5:
      p "Олень скрылся в лесу."
      s:disable()
      s:daemonStop()
      s.step = 0;
    return
  ~~~
  init_dsc: "Ты видишь на поляне оленя."
  life_Give,Show(s, w): ~~~do
    if not w ^ 'перо':
      return false
    if s.sit:
      p "Олень никак не отреагировал."
      return
    s.sit = true
    p "Ты подносишь перо к носу оленя. Чувствуя прикосновение, он шумно втягивает в себя воздух. Затем он опускается перед тобой на колени.";
    s:daemonStop()
  ~~~
  sit: false
  step: 0
  with:
    obj:
      words: "глаза оленя,глаза,дыр*"
      attrs: scenery
      on:
        default: "Тебе не нравятся глаза оленя."
        exam: "Вместо глаз у оленя чёрные дырки."
    Prop:
      words: "рога оленя,рога"

handler forest_scenery(s): ~~~do
  disable 'сова'
  disable 'олень'
  disable '#ручей'
  disable '#поляна'
  if s.depth == 0:
    enable 'сова'
  elseif s.depth == 2:
    enable '#ручей'
  elseif s.depth == 3:
    enable '#поляна'
    enable 'олень'
    pic_set '22'
    _'олень'.step = 0
    _'олень'.sit = false
    _'олень':daemonStart()
~~~

Area "В лесу":
  words: "лес|чаща"
  on:
    drop(s, w): ~~~do
      p ("Зачем бросать ", w:noun'вн', " в лесу?")
    ~~~
  before_Cry: "-- Ма-маааааа! -- нет ответа."
  depth: 0
  dsc(s): ~~~do
    p "Ты находишься в хвойном лесу."
    if s.depth == 0:
      if not have_compass():
        p "Между деревьями ты видишь снежное поле.";
      else:
        p "Между деревьями на востоке ты видишь снежное поле.";
    elseif s.depth == 1:
      p "Тебя окружают деревья."
    elseif s.depth == 2:
      p "Ты видишь здесь замёрзший ручей."
    elseif s.depth == 3:
      p "Ты вышла на небольшую поляну."
    elseif (s.depth - 4) % 2 == 0:
      p "Лес становится всё гуще."
    elseif (s.depth - 4) % 2 == 1:
      p "Деревья окружают тебя со всех сторон."
  ~~~
  e_to,se_to,ne_to(s, t): ~~~do
    if check_compass(t):
      return
    if s.depth == 0:
      return '#поле'
    pl:need_scene(true)
    s.depth = s.depth - 1
    p ("Ты идешь некоторое время на ", (_('@'..t).word), ".")
    if s.depth == 0:
      p "За деревьями на востоке ты видишь снежное поле."
    forest_scenery(s)
  ~~~
  enter(s): ~~~do
    if seen 'сова':
      _'сова':daemonStart()
  ~~~
  out_to(s): ~~~do
    if s.depth == 0:
      return '#поле';
    return false
  ~~~
  s_to,n_to(s, t): ~~~do
    if check_compass(t):
      return
    if s.depth <= 1:
      p "Ты решила, что идти вдоль границы леса не очень хорошая идея."
    else:
      p "Ты решила, что лучше держаться западного направления."
  ~~~
  title: "Лес"
  w_to,nw_to,sw_to(s, t): ~~~do
    if check_compass(t):
      return
    s.depth = s.depth + 1
    if s.depth > 8 then s.depth = 6 + rnd(3) end
    forest_scenery(s)
    pl:need_scene(true)
    p ("Ты идешь некоторое время на ", (_('@'..t).word), ".")
    if s.depth > 7 and rnd(100) < 30:
      p "^Ты можешь идти так целую вечность..."
  ~~~
  with:
    Sky:
      nam: "#небо"
    Snow:
      nam: "#снег"
      on:
        exam(s): ~~~do
          if here().depth == 0:
            p "Здесь едва заметный след теряется.";
          else:
            return false
        ~~~
    obj #поле:
      attrs: scenery
      on:
        default: "Поле далеко."
        exam: "Снежное поле выглядит бескрайним."
        walk, enter, climb(s): ~~~do
          if here().depth == 0:
            walk 'поле'
          else:
            p "Поле где-то на востоке."
        ~~~
    Prop #деревья:
      words: "деревья|дерево|сосна,ветк*"
      on:
        enter, climb: "Первые ветки находятся высоко. У тебя не получится забраться."
        exam(s): ~~~do
          if s:hint'plural':
            p "Деревья покрыты снегом.";
          else:
            p "Ветви дерева покрыты снегом.";
        ~~~
    obj сова:
      words: "полярная сова,сова,птица"
      on:
        exam(s): ~~~do
          p "Тебе кажется, что это полярная сова. Только у неё странные глаза.";
          if here() ^ 'поле':
            pn()
            _'#глаза совы':before_Exam()
        ~~~
        touch(s): ~~~do
          if where(s) ^ 'В лесу':
            p "Она слишком высоко."
            return
          if not s.seen:
            p "Сначала хорошо бы рассмотреть, с чем имеешь дело."
            return
          if s.talked:
            p "Тебе не очень хочется иметь с ней дело."
          else:
            p "Ты осторожно дотронулась до птицы.^"
            p "Сова вздрогнула и её глаза-дырки уставились на тебя."
        ~~~
      daemon(s): ~~~do
        if s.talked:
          return
        if s:where() ^ 'В лесу' and where(s) ^ 'В лесу' and _'В лесу'.depth == 0 and rnd(3) == 1:
          p "Хлопая крыльями сова улетела в сторону поля."
          move(s, 'поле')
        elseif here() ^ 'поле' and where(s) ^ 'поле' and s.talked and rnd(3) == 1:
          p "Хлопая крыльями сова улетела в сторону леса."
          move(s, 'В лесу')
        return
      ~~~
      dsc(s): ~~~do
        if where(s) ^ 'поле':
          p "На машине сидит сова."
        else:
          p "На ветке сосны сидит сова."
      ~~~
      init_dsc: "Ты замечаешь большую сову, сидящую на ветке сосны."
      seen: false
      talk_to(s): ~~~do
        if where(s) ^ 'В лесу':
          p "Хлопая крыльями сова улетела в сторону поля."
          move(s, 'поле')
          return
        if not s.seen:
          p "Сначала хорошо бы рассмотреть, с чем имеешь дело."
          return
        if s.talked:
          p "-- Что всё это значит?^\n-- Я сделала то, что мне повелела госпожа.";
          p "^Сова хлопнула крыльями и улетела."
          remove(s)
          s:daemonStop()
          return
        return 'разговор с совой'
      ~~~
      talked: false
      with:
        obj:
          words: "глаза совы,глаза,дыр*"
          nam: "#глаза совы"
          on:
            default: "Тебе не нравятся эти глаза."
            exam(s): ~~~do
              p "На месте глаз у совы зияют чёрные дырки.";
              if not _'сова'.seen:
                p "^Интересно, видит ли она тебя?"
              _'сова'.seen = true
            ~~~
    Prop #поляна:
      words: "поляна"
      attrs: scenery
      disabled: true
    Prop #ручей:
      words: "ручей"
      attrs: scenery
      disabled: true
  with: олень

obj перо:
  words: "перо"
  on:
    exam(s): ~~~do
      p "Белое перо."
      if have(s):
        p "Зачем оно тебе?";
      else:
        p "Его оставила сова с дырками вместо глаз."
    ~~~
  init_dsc(s): ~~~do
    if s:hasnt 'moved' and where(pl) ^ 'машина':
      return
    p "На крыше машины лежит белое перо.";
  ~~~

talk "разговор с совой":
  title: false
  enter: ~~~do
    pic_set '21'
  ~~~
  intro: [[-- О, я слышу тебя, дитя! -- ответ птицы напугал тебя.]],
  option:
    ask: "Ты меня не видишь?";
    reply: "-- Я тебя чувствую...";
  option:
    ask: "Ты умеешь говорить?";
    reply: "-- Я разговариваю с тобой.";
  option:
    ask: "Что с твоими глазами?";
    reply: "-- Такой меня сделала моя госпожа.";
    option:
      ask: "Кто твоя госпожа?";
      reply: "-- Она вызвала меня. Она сказала, чтобы я передала тебе...";
      option:
        ask: "Что?";
        reply: "-- Твоя мама ждёт тебя во дворце. Поспеши.";
        goto: deep
      option:
        ask: "Ты видела мою маму?";
        reply: "-- Твоя мама ждёт тебя во дворце. Поспеши.";
        goto: deep
  label deep:
    option:
      ask: "Где этот дворец?";
      reply: "-- Он за ледяным хребтом на западе.";
      option:
        ask: "Это далеко?";
        do: ~~~do
          p "-- Расстояние -- всего лишь время. А время здесь замёрзло. Возьми перо. По нему тебя узнают другие слуги госпожи.";
          move ('перо', 'машина')
          _'перо':attr '~moved'
          _'сова'.talked = true
          walkout()
        ~~~
    option:
      ask: "Что за бред ты несёшь.";
      reply: "-- Моя госпожа сказала мне передать тебе...";
      option:
        ask: "Ладно, ладно...";
        reply: "-- Поспеши же, дитя!";

story "к хребту":
  text: "Ты садишься на оленя и он поднимается с колен.^^\n\t\tВы мчитесь через лес на запад. Снова и снова олень ловко огибает встречные деревья и вы оставляете их позади.^^\n\t\tПостепенно лес начинает редеть и сквозь деревья ты видишь ледяные горы.^^\n\t\tОлень остановился перед ледяной стеной и опустился, чтобы ты могла слезть."
  next_to: "Ледяные горы"
  onexit(s, to): ~~~do
    p"Ты слезаешь с оленя."
    move('олень', to)
  ~~~
  title: false

story "к поляне":
  text: "Ты садишься на оленя и он поднимается с колен.^^\n\t\tВы мчитесь через лес на восток. Снова и снова олень ловко огибает встречные деревья и вы оставляете их позади.^^\n\t\tПостепенно лес начинает редеть.^^\n\t\tОлень остановился и опустился на колени, чтобы ты могла слезть."
  next_to: "В лесу"
  onexit(s, to): ~~~do
    p"Ты слезаешь с оленя."
    move('олень', to)
  ~~~
  title: false

Area "Ледяные горы":
  dsc: "Ты стоишь перед ледяной стеной, которая продолжается на север и юг. На востоке начинается лес."
  e_to,ne_to,se_to: "#лес"
  in_to: "#стена"
  nw_to,sw_to,n_to,s_to(s): "По этому направлению нет ничего интересного. Такая же ледяная стена."
  onexit(s, t): ~~~do
    if t ^ 'пещера' and not visited 'пещера':
      pic_set '23-pan'
  ~~~
  title: "У ледяных гор"
  w_to: "#стена"
  with:
    obj:
      words: "хвойный лес,лес|чаща|деревья"
      nam: "#лес"
      attrs: scenery
      on:
        default: "Лес далеко."
        exam: "На деревьях лежит снег."
        walk, enter, climb(s): "В этом лесу можно ходить вечность."
    Snow:
      nam: "#снег"
    Sky:
      nam: "#небо"
    obj:
      words: `function(s) pr (-"ледяная стена,стена|лёд|лед|поверхность|скала|гора|горы/жр"); if s.light > 0 then pr (-"|свечение/ср|свет") end  end`
      nam: "#стена"
      attrs: scenery
      on:
        attack(s): "Скала {$fmt em|выглядит} твёрдой. Ты решила не рисковать."
        climb: "У тебя вряд ли это получится. Стена отвесная."
        enter, walk(s): ~~~do
          if s.light == 0:
            p "Как ты это сделаешь? Стена твёрдая, гладкая и скользкая."
            return
          walk 'пещера'
        ~~~
        exam(s): ~~~do
          if s.light > 0:
            p "Сквозь лёд ты видишь фиолетовое свечение."
          else:
            p "Ледяная стена отвесно уходит вверх. Её поверхность выглядит скользкой."
        ~~~
        taste: "А язык не приклеится?"
        touch, push(s): ~~~do
          p "Ты касаешься ладонью гладкой ледяной поверхности.";
          if s.light > 0:
            p "Как странно, твоя рука проходит сквозь лёд!"
            s.light = 2
          else:
            s.light = 1
          s:daemonStart();
        ~~~
      before_Knock(s): ~~~do
        if s.light == 0:
          return false
        p "Ты попыталась постучать по стене, но у тебя это не вышло! Рука прошла сквозь лёд!"
      ~~~
      daemon(s): ~~~do
        if player_moved():
          s.light = 0
          s:daemonStop()
          return
        if s.light == 1:
          p "Ты замечаешь, что под поверхностью льда разливается фиолетовое свечение."
        elseif s.light == 2:
          p "Фиолетовое свечение под поверхностью льда усиливается!"
        elseif s.light == 3:
          p "Фиолетовое свечение ослабевает."
        else:
          s:daemonStop()
          s.light = 0
          return
        s.light = s.light + 1
      ~~~
      light: 0

room пещера:
  words: "пещера"
  attrs: ~light
  Play(s, w): ~~~do
    if not w or not have 'скрипка':
      return false
    if not w then w = _'скрипка' end
    if not w ^ 'скрипка':
      return false
    if _'#кристаллы'.try == 0 or _'#кристаллы'.broken:
      return false
    _'#кристаллы'.broken = true
    pic_set '24'
    p "Интересно... А что если? Не успев додумать мысль, ты уже берёшь скрипку в руки.^^\nТы извлекаешь \"ми\" второй октавы. Сначала ничего не происходит, но затем ты слышишь, как странный кристалл отзывается\nна звук твоей скрипки.^^\nЗвуки скрипки и кристалла усиливают друг друга в резонансе. Ты почти физически ощущаешь, как\nнапряжение кристалла достигает своего пика. И, наконец, он шумно взрывается на мелкие осколки."
    enable 'осколки'
  ~~~
  dark_dsc: "Ты видишь слабое свечение в темноте."
  dsc: "Ты находишься внутри небольшой ледяной пещеры. У восточной стены ты видишь странное свечение.^\nПещера продолжается на северо-запад."
  e_to: "#свечение"
  nw_to(s): ~~~do
    if mp:thedark() and not visited'пещера2':
      p "Ты же не видишь куда идти."
      return
    return 'пещера2'
  ~~~
  onenter(s): ~~~do
    if not visited(s):
      p "Доверившись интуиции, ты входишь в фиолетовое свечение, которое вдруг заполняет всё вокруг. Шаг. Еще один. И вдруг ты оказываешься в полной темноте. Если не считать слабого свечения позади."
  ~~~
  out_to: "Ледяные горы"
  title(s): ~~~do
    if mp:thedark():
      p "В темноте"
    else:
      p "Ледяная пещера"
  ~~~
  with:
    obj #свечение:
      words: "свечение"
      attrs: scenery, luminous
      on:
        exam(s): ~~~do
          p "Этим путём ты попала сюда. Вероятно, с помощью него можно выйти наружу.";
          p "^Ты обращаешь внимание, что источником странного свечения служат фиолетовые кристаллы, растущие из стены."
          enable '#кристаллы'
        ~~~
        walk, climb, enter(s): ~~~do
          walk 'Ледяные горы';
        ~~~
      before_Touch,Push,Knock: "Твоя рука проходит сквозь свечение."
    Prop #стены:
      words: "стены|стена|пол|потолок"
      attrs: luminous
      on:
        exam(s): ~~~do
          if mp:thedark():
            p "В полной темноте это будет сложно."
          else:
            return false
        ~~~
      before_Touch,Push,Knock: "Похоже, ты находишься в ледяной пещере."
    obj #кристаллы:
      words: "кристаллы|кристалл"
      attrs: luminous, static
      disabled: true
      on:
        exam: "Полупрозрачные кристаллы растут прямо из льда."
        touch(s): ~~~do
          if s.try == 0 or s.broken:
            return false
          else:
            p "Ты чувствуешь как кристалл вибрирует."
        ~~~
      before_Attack,Knock(s): ~~~do
        if s.broken:
          p "Ты уже разрушила один кристалл."
          return
        if s.try == 2:
          p "Ты постучала по звонкому кристаллу."
        else:
          p "Ты постучала по одному из кристаллов."
        if s.try == 0:
          s.try = 1
          p "Ответом был мелодичный звенящий звук. Твой музыкальный слух определил его как \"фа\" малой октавы, что\n\t\t\t\tнаходится вне диапазона твоей скрипки. Интересно, они все звучат одинаково?"
        elseif s.try == 1:
          p "На этот раз звук оказался более высоким. Ты определила его как {$fmt em|\"ми\"} второй октавы."
          p "^Ты решила запомнить этот кристалл."
          s.try = 2
        else:
          p "Звенящий звук кристалла долго отражается от ледяных стен. Ты чувствуешь вибрацию."
      ~~~
      broken: false
      try: 0
    obj осколки:
      words: "осколки кристалла,осколок*|осколки|кусочки|куски"
      attrs: luminous
      disabled: true
      on:
        exam: "Осколки кристалла пульсируют слабым фиолетовым свечением."
        take(s): ~~~do
          if here() ^ 'пещера2' and here().solved:
            p "Ты боишься беспокоить летучих мышей."
            return
          return false
        ~~~
      before_Light: "Свет испускаемый осколками очень тусклый для этого."

obj ообрыв:
  words: "обрыв,разлом|пропасть"
  attrs: scenery, container, open
  on:
    enter: "Прыгнуть в пропасть? Тебе нужно найти маму, а не сбегать от проблем..."
    exam(s): "Глубокий разлом во льду. Света фонарика недостаточно, чтобы оценить его глубину. К счастью, ширина разлома не превышает двух метров."
    jumpover(s): ~~~do
      p "Ты разбегаешься и прыгаешь через пропасть..."
      if here() ^ 'обрыв':
        walk 'Другая сторона'
      else:
        walk 'обрыв'
    ~~~
    receive(s, w): ~~~do
      p ("Ты потом не сможешь достать ", w:noun 'вн', " из пропасти.")
    ~~~

room пещера2:
  words: "пещера"
  attrs: ~light
  on:
    listen(s): ~~~do
      if s.solved:
        p "Ты слышишь отвратительный писк и хлопанье крыльев."
      else:
        p "Стоит мёртвая тишина."
    ~~~
  dsc(s): ~~~do
    pn "Стены этой части пещеры испещрены небольшими отверстиями.";
    if from() ^ 'пещера':
      p "Ты попала сюда с юго-востока. Пещера продолжается на юго-запад."
    else:
      p "Ты попала сюда с юго-запада. Пещера продолжается на юго-восток."
    if not s.solved:
      p "^^Твой взгляд прикован к потолку, который усеян чёрными лоскутками. Ты вздрагиваешь, когда ответ приходит тебе в голову. Пещера заполнена летучими мышами!"
    else:
      p "^^Ты видишь, как странные чёрные твари дерутся за фиолетовые осколки кристалла,\nкотрые ты рассыпала по полу пещеры.";
  ~~~
  out_to(s): ~~~do
    if from() ^ 'пещера':
      return 'пещера'
    else:
      return 'обрыв'
  ~~~
  se_to,e_to: "пещера"
  solved: false
  sw_to,w_to(s): ~~~do
    if mp:thedark() and not visited'обрыв':
      p "Сложно сделать это в полной темноте."
      return
    return 'обрыв';
  ~~~
  title: "Пещера с летучими мышами"
  with:
    Prop:
      words: "стены|стена|пол|потолок"
    obj #мыши:
      words: "летучие мыши,мыши,твари,мышь*"
      attrs: concealed, animate
      on:
        attack: "Тебе не удастся убить их всех."
      description(s): ~~~do
        p "Тебе они не нравятся. Называя вещи своими словами -- ты их панически боишься.";
        if here().solved:
          p "^Но кажется, они поглощены борьбой за светящимися осколками кристалла."
      ~~~
      life_Show,Give: "Пока они заняты, лучше их не беспокоить."
    obj:
      words: "отверстия|дырки|дыры"
      attrs: scenery, container
      on:
        receive: "Не стоит туда соваться."
      description: "Тебе приходит в голову, что эти отверстия могут быть норами. Лучше держаться от них подальше."

room обрыв:
  attrs: ~light
  dsc: "На западе гладкий пол пещеры заканчивается обрывом. Выход находится на юго-востоке."
