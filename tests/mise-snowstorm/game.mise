name: Метель
version: 2.1
author: Peter Kosyh & Pakowacz
info: Что тебя ждёт за снежной пеленой?
lang: ru
fmt: dash, quotes
events: Say

global:
  blizzard: 0

lua:
~~~lua
function pic_push(name)
end

function pic_pop()
end

function pic_set(name)
end

include "pic"
--"фонарик,фонарь"
--"сообщения|сообщение"
~~~

story intro:
  text: "Старенький синий седан едет по заснеженной трассе. Внутри машины -- двое.^^\n\t\tВедёт машину усталая женщина лет 35. На заднем сидении справа сидит её дочь -- девочка-подросток.^^\n\t\tДевочка прислонилась лбом к холодному стеклу. Мать продолжает начатый разговор...^^\n\t\t-- Вот увидишь, тебе там понравится."
  enter(): ~~~do
    pic_set('1')
  ~~~
  next_to: В машине

obj браслет:
  words: браслет
  attrs: clothing
  on:
    after wear: Надев браслет на правое запястье, ты чувствуешь, что на душе у тебя потеплело.
    disrobe(s): ~~~do
      if visited 'gotmirror':
        say Тебе кажется, что в этом странном месте лучше никогда не снимать этот браслет!
      else:
        pass
    ~~~
    exam(s): ~~~do
      say "Этот детский браслет мама подарила тебе на Рождество, когда тебе было ещё 9 лет.\nПросто игрушка. Леска, на которую нанизаны бусинки и пластмассовое сердечко."
      if s:once():
        say Странно, что он оказался в бардачке... Ты думала, что он давно потерялся.
    ~~~
    give(s, w): ~~~do
      if w ^ 'королева':
        walk 'badend4'
        stop
      pass
    ~~~

class Title(cutscene):
  attrs: noprompt
  on:
    default(s, ev): ~~~do
      if ev == 'Next':
        pass
      mp:clear()
      me():need_scene(true)
    ~~~
  OnError(s): ~~~do
    mp:clear()
    std.pclr()
  ~~~
  title: false

class Prop:
  attrs: scenery
  on:
    default(s, ev): ~~~do
      say "Тебе нет дела до ", s:noun 'рд', "."
    ~~~

class Useless:
  on:
    default(s, ev): ~~~do
      say "Тебе нет дела до ", s:noun 'рд', "."
    ~~~

room "В машине":
  words: машина
  on:
    listen(s): ~~~do
      if seen '#мама':
        say Ты слышишь шум мотора и музыку, доносящуюся из радио.
      else:
        say В машине играет радио.
    ~~~
  before cry(s): ~~~do
    if seen '#мама':
      say -- Прекрати истерику! -- произносит мать.
    else:
      pass
  ~~~
  daemon(s): ~~~do
    local t = { "Машину потряхивает на снежных ухабах."; "По другую сторону окна кружатся снежинки."; "Вы проезжаете мимо занесённых снегом коттеджей."; "Машину слегка заносит на снежной дороге."; }
    if blizzard >= 2:
      blizzard = blizzard + 1
      if blizzard < 7 and blizzard > 3:
        pic_set '2-pan-left'
      if blizzard > 5:
        enable '#заправка'
        disable '#метель'
        if blizzard == 7:
          say Мать заглушила двигатель.
          stop
        if blizzard == 8:
          pic_set '7'
          say -- Подожди меня, я скоро вернусь. -- говорит тебе мать и выходит из машины, захлопывая за собой дверь.
          remove '#мама'
          stop
        if blizzard == 11:
          say Ты ждёшь мать, но её все нет. Может быть, выйти из машины?
          stop
        if blizzard > 8:
          stop
        say Вы подъезжаете к заправке.
        stop
    if here() == s and rnd(100) <= 25:
      line t[rnd(#t)]
  ~~~
  dsc: Ты сидишь на заднем сидении машины и смотришь в окно.
  enter(s): ~~~do
    s:daemonStart()
    _'#мама':daemonStart()
  ~~~
  exit(): ~~~do
    if seen '#мама':
      _'#мама':daemonStop()
  ~~~
  out_to(s): ~~~do
    if blizzard < 7:
      say Лучше не делать этого, пока машина движется.
    elseif seen '#мама':
      say Там холодно.
    else:
      s:daemonStop()
      if not have 'скрипка':
        move('скрипка', 'машина')
      if not have 'телефон':
        move('телефон', 'бардачок')
      walk 'метель1'
  ~~~
  with:
    obj #мама:
      words: мать,мама,женщина
      attrs: animate
      on:
        ask, tell, talk(s): ~~~do
          if visited 'разговор1':
            if телефон.seen and have 'телефон':
              say -- Я не буду с тобой разговаривать, пока ты не отдашь мне телефон! Ну же!
              stop
            if blizzard > 0:
              if blizzard >= 2:
                say -- Мама! Это важно!^
                if not disabled '#заправка':
                  say -- Сейчас заправимся и поговорим.
                else:
                  say -- Скоро заправка, подожди пять минут и поговорим!
                stop
              say -- Мама! Посмотри, там справа. Что то странное...^
              say -- Не отвлекай меня от дороги!
              pic_set '6'
              blizzard = 2
              stop
            say Ты не решаешься поговорить с ней.
            stop
          walk 'разговор1'
        ~~~
        exam: Твоя мать очень много работает и поэтому выглядит усталой.
        kiss: Ты зла на свою мать и сейчас ваши отношения нельзя назвать близкими.
      daemon(s): ~~~do
        local t = { "-- Ты не собираешься со мной поговорить?"; "-- Почему ты молчишь?"; "-- Давай поговорим?"; "-- Ну, чего ты молчишь?"; }
        s.time = s.time + 1
        if s.time > 3:
          if rnd(3) == 1:
            say t[rnd(#t)]
            say  -- обращается к тебе мать.
      ~~~
      init_dsc: Машину ведёт твоя мать.
      time: 0
    Prop:
      words: бардачок
      on:
        exam(s): ~~~do
          if телефон:inside 'бардачок':
            say Бардачок закрыт.
            stop
          say Тебе нет до него дела.
        ~~~
        open: Ты не можешь дотянуться до него с заднего сидения.
    Prop:
      words: дверь
      on:
        close: Дверь закрыта.
        enter(s): ~~~do
          mp:xaction("Exit")
        ~~~
        open(s): ~~~do
          mp:xaction("Exit")
        ~~~
    Prop:
      words: руль|радио
    obj #метель:
      words: метель,буря|смерч|клубы
      attrs: scenery
      disabled: true
      on:
        default: Она пока ещё далеко.
        exam: Буря, метель или ... смерч? Что бы это ни было, оно пугает тебя.
    obj:
      words: окно,стекло
      nam: #окно
      attrs: scenery, openable
      on:
        open: Слишком холодно, чтобы опускать стекло.
        search, exam(s): ~~~do
          if not disabled '#заправка':
            say За стеклом ты видишь смутный силуэт заправки.
            stop
          if visited 'разговор1' and телефон.seen:
            if blizzard == 0:
              line Разглядывая белоснежный пейзаж, ты замечаешь вдали нечто странное.
              enable '#метель'
              blizzard = 1
              pic_set '5'
            line Ты видишь, как по земле ползут огромные клубы пара или снега.
            say Огромная снежная буря, накрывая деревья, движется к трассе!
            stop
          say Ты видишь, как за стеклом кружится метель.
          if s:once():
            pic_set '2-pan-left'
        ~~~
    Prop #заправка:
      words: заправка
      disabled: true
      on:
        exam: Сквозь метель ты едва различаешь темные очертания заправки.
  with: скрипка

talk разговор1:
  title: false
  enter: ~~~do
    pic_set('3')
  ~~~
  intro: -- Я говорю, тебе там понравится. Там хорошая школа, я узнавала... И музыкальная школа совсем недалеко. -- ты слышишь в голосе матери настойчивость.
  option:
    ask: Я устала терять друзей.
    reply: -- Ты же знаешь, что это необходимо! Я должна работать, чтобы ты смогла учиться в хорошем вузе! И это не конец света! На новом месте заведёшь новых друзей.
    goto: дальше
  option:
    ask: Хорошо, мама...
    reply: -- Ну что ты вечно строишь из себя мученика? Ты всего-лишь меняешь школу. Я работаю на твоё будущее и никакой благодарности!
    goto: дальше
  label дальше:
    option:
      ask: Я заранее знаю всё, что ты скажешь!
      reply: -- Ну зачем ты так? Ты стала такой грубой!
    option:
      ask: Ты меня не поймёшь.
      reply: -- А тебе не приходило в голову, что мне тоже было 13 лет?
    option:
      ask: Просто мне очень плохо.
      reply: -- Ты ведёшь себя как эгоистичный ребёнок. Ты думаешь мне легко?
      option:
        ask: Я ненавижу твою работу!
        reply: -- Ты неблагодарная! Вместо поддержки, ты снова треплешь мне нервы!
        option:
          ask: Я устала от твоих скандалов. Замолчи!
          reply: -- Ты это матери говоришь? Таким тоном? Как ты... можешь!
        option:
          ask: Давай просто закончим этот разговор.
          reply: -- Ты жестокая! Я отдала тебе все! И это моя самая большая ошибка!
          option:
            ask: Мама, прекрати!
            do: ~~~do
              say -- Да, не ожидала я... Что у меня такая дочь...
              if have 'телефон':
                DaemonStart 'телефон'
              walkback()
            ~~~
      option:
        ask: Ты могла бы сменить работу...
        reply: -- Да? И получать гроши. И кто оплатит твоё обучение?

obj телефон:
  words: `function(s) pr (-"мобильный телефон,телефон,мобильник,смартфон"); if s.flash then pr "|фонарик,фонарь" end if have(s) and here() ^ 'В машине' then pr "|сообщения|сообщение"; end  end`
  attrs: switchable, on, multi
  on:
    exam(s): ~~~do
      if not s:has on:
        say Телефон выключен.
        stop
      if s:has light:
        say В телефоне включён фонарик.
        stop
      if seen '#мама':
        say "Ты собираешься проверить новые сообщения, но\nтвоя мать замечает это в зеркале заднего вида.^\n-- Ты круглые сутки сидишь с телефоном! Отдай его мне, сейчас же!"
        s.seen = true
        s:daemonStop()
      else:
        if not s.flash and mp:thedark():
          say Тебе приходит в голову мысль, что можно посветить телефоном...
          s.flash = true
          stop
        if not s.compass:
          say Странно, нет приёма...
        if here()^'поле' or here()^'В лесу':
          if not s.compass:
            say Но в твоём смартфоне есть компас. И, похоже, он работает! Теперь ты можешь ориентироваться по сторонам света.
            s.compass = true
          else:
            say "Здорово, что в твоём смарфоне есть компас! В целях экономии батареи ты включаешь режим \"в полёте\"."
        else:
          say Это твой старенький китайский смартфон. В основном, ты используешь его для социальных сетей.
          say А сейчас он служит тебе компасом.
          if s.flash then p "И фонариком." end
    ~~~
    give(s, w): ~~~do
      if w ^ '#мама':
        say Ты протягиваешь телефон матери, она молча забирает его и кладёт в бардачок.
        if not s.seen:
          s.seen = true
          s:daemonStop()
          say ^Мать выглядит немного удивлённой -- ведь ты обычно тяжело расстаёшься со своим смартфоном.
        move(s, 'бардачок')
        pic_set '4'
        stop
      pass
    ~~~
    switchoff(s): ~~~do
      if s:has light:
        say Ты выключила фонарик в телефоне.
        s:attr ~light
        pl:need_scene(true)
        stop
      if s:multi_alias() == 2:
        say Фонарик и так выключен.
        stop
      if s.compass:
        say Если ты выключишь телефон, ты лишишься компаса.
        stop
      if not s.seen:
        say Ты не любишь, когда твой смартфон выключен.
        stop
      pass
    ~~~
    switchon(s): ~~~do
      if s:multi_alias() == 2:
        s:before_Light()
        stop
      if not s.flash and mp:thedark():
        say Тебе приходит в голову мысль, что в телефоне есть фонарик и его можно включить...
        s.flash = true
        stop
      pass
    ~~~
  before burn, light(s): ~~~do
    s.flash = true
    if s:has light:
      say Фонарик в телефоне и так включён.
      stop
    if not mp:thedark():
      say Тут и так светло.
      stop
    say Ты включила в мобильнике фонарик.
    pl:need_scene(true)
    s:attr light
  ~~~
  compass: false
  daemon(s): ~~~do
    if rnd(10) > 3:
      say Ты слышишь сигнал входящего сообщения на своём смартфоне.
  ~~~
  each_turn(s): ~~~do
    if here() ^ 'пещера2' and s:has light and not here().solved:
      say "В ту же секунду ты слышишь хлопанье крыльев и успеваешь заметить,\nкак множество чёрных теней бросаются к тебе с потолка. Инстинктивно ты успеваешь выключить фонарик. Удивительно, но это успокаивает тварей. Некоторое время ты слышишь шум их крыльев. Затем всё затихает."
      s:attr ~light
      stop
    if here():has light and s:has light:
      say В целях экономии заряда ты выключила фонарик.
      s:attr ~light
  ~~~
  flash: false
  seen: false

obj скрипка:
  words: скрипка
  on:
    exam: Твоя скрипка. Тебе остался год, чтобы закончить музыкальную школу. Если честно, благодаря музыкальной школе ты стала ненавидеть музыку.
  after play: У тебя сейчас нет настроения играть.
  init_dsc: Рядом лежит скрипка.

verb Attack2:
  words: [|раз]бить,[|раз]бей
  patterns:
    - {noun}/вн,scene : Attack

verb PutOn:
  words: повес/ить
  patterns:
    - {noun}/вн,held на {noun}/вн,scene : PutOn
    - ~ на {noun}/вн,scene {noun}/вн,held : PutOn reverse

verb Play:
  words: играть,сыграть
  patterns:
    - на {noun}/пр : Play
    - " : Play"
  on(s, w): ~~~do
    if not w:
      mp:xaction("Play", скрипка)
      stop
    if w ~= скрипка:
      say Ты умеешь играть только на скрипке.
      stop
    if not have 'скрипка':
      say Сначала тебе нужно взять скрипку в руки.
      stop
    pass
  ~~~

verb Light:
  words: [|по|под]свети/ть,[|по|свеч/у,освети/ть
  patterns:
    - {noun}/тв,held : Light
  on(s, w): ~~~do
    if mp:check_held(w):
      stop
    say "{#First} не {#if_hint/#first,plural,могут,может} светить."
  ~~~
  hint: `function(s) return mp:thedark() and have 'телефон'  end`

verb Cry:
  words: [|по|за]крич/ать,[|по]звать,крикн/уть,[|за|по]плак/ать,[|за|по]плач/ь
  patterns:
    - : Cry
  on(s, w): Это тебе не поможет.

verb Fun:
  words: [|по|рас|за]смеяться,[|по|за|рас]смей/ся,[|по|за|рас]смею/сь,[|по|за|рас]хохо/таться
  patterns:
    - : Fun
  on(s, w): Ты глупо смеёшься.

verb Knock:
  words: [|по]стуч/ать
  patterns:
    - в {noun}/вн : Knock
    - по {noun}/дт : Knock
  on(s, w): ~~~do
    if mp:check_live(w):
      stop
    if mp.args[1].word == 'в':
      say Ты постучала в
      say w:noun'вн', "."
    else:
      say Ты постучала по
      say w:noun'дт', "."
    say Ничего не произошло.
  ~~~

verb Tune:
  words: настро/ить,настра/ивать
  patterns:
    - {noun}/вн : Tune
  on(s, w): ~~~do
    say "Тебе не нужно настраивать ", w:noun 'вн', "."
  ~~~

verb Photo:
  words: [|с|по]фото/графировать
  patterns:
    - Photo
  on(s): ~~~do
    if not have 'телефон':
      say Дебе нечем делать снимки.
    elseif mp:thedark():
      say Нет света. Может быть, посветить телефоном?
    else:
      local t = { "Ты делаешь пару неудачных фоток и удаляешь их из телефона."; "Ты сделала удачную фотку."; "Ты сделала пару фоток и селфи."; }
      say t[rnd(#t)]
  ~~~

setup:
  dsc: false
  take: телефон
  hero:
    words: ты/жр,2л
    description: Тебя зовут Вера. Тебе почти 13 лет.
    on:
      letgo(s, w, ww): ~~~do
        if w ^ 'телефон':
          local s = w
          if s.compass and ww ~= pl:
            say В телефоне есть компас, который тебе нужен.
            stop
          pass
        elseif w ^ 'скрипка' and here() ^ 'пещера2' and mp:thedark():
          say Ты не хочешь расставаться со своей скрипкой.
          stop
        elseif w ^ 'осколки':
          local s = w
          if not here() ^ 'пещера2':
            pass
          say Ты бросаешь осколки кристалла на пол пещеры. Маленькие светящиеся огоньки рассыпаются по ледяной поверхности. В тот же момент, пещеру заполняет шум хлопающих крыльев.
          here().solved = true
          drop(s)
          stop
        pass
      ~~~
  init: ~~~do
    if theme.name() == '.mobile' or theme.name() == '.mobile2':
      mp.togglehelp = true
      mp.autohelp = true
      mp.autohelp_limit = 1000
      mp.compl_thresh = 0
    else:
      mp.togglehelp = false
      mp.autohelp = false
      mp.autohelp_limit = 8
      mp.compl_thresh = 1
  ~~~
  start: ~~~do
    if not load:
      move(pl, 'intro')
  ~~~
  game:
    hint_verbs: `{"#Exam","#Drop","#LookIn","#ThrowAt","#Walk","#Take","#Play","#Give","#Touch","#Attack2","#Talk","#Cry","#Open","#Close","#Jump","#Wait","#Wear","#Sit","#Exit","#SwitchOn","#SwitchOff","#PutOn","#Light"}`

story метель1:
  text: "Ты открываешь дверь и толкаешь её наружу.^^\n\t\tТы чувствуешь, как ветер давит на дверь с другой стороны, но ты сильней и вот -- дверь открыта.^^\n\t\tХолод, вместе с вихрем злых снежинок, быстро забирается внутрь салона.^^\n\t\tТы выходишь из машины когда...^^\n\t\tНа тебя обрушивается..."
  enter(s): ~~~do
    pic_set('75')
    if std.ref'mplayer':
      lifeon 'mplayer'
  ~~~
  exit(s): ~~~do
    pic_set('81')
  ~~~
  next_to: метель2
  title: false

Title метель2:
  text: "{$fmt y,50%}{$fmt c|{$fmt b|МЕТЕЛЬ}}^^\n{$fmt c|Игра на ЗОК-2019}^^^\n{$fmt em|{$fmt c|Код: Пётр Косых^Графика: Pakowacz}}"
  exit(s): ~~~do
    pic_set('20-pan')
  ~~~
  next_to: поле

obj машина:
  words: машина|дверь
  attrs: container, openable, open, static, enterable, light
  on:
    after close(s): ~~~do
      if перо:inside(s) and not have 'перо':
        say Когда ты захлопнула дверь машины, перо упало с крыши в снег.
        move('перо', 'поле')
        stop
      pass
    ~~~
    switchoff: Двигатель не работает.
    switchon: Тебе не удаётся завести машину. Впрочем, ты все-равно не умеешь водить.
  description(s): ~~~do
    if s:multi_alias() == 2:
      say Тебе нет дела до двери.
      stop
    pass
  ~~~
  dsc(s): ~~~do
    say В снегу стоит машина.
    if перо:where() == s and перо:hasnt moved:
      перо:init_dsc()
  ~~~
  inside_dsc: Ты находишься в машине.
  with:
    obj радио:
      words: радио
      attrs: static, switchable, on
      on:
        after switchon: Ты включаешь радио. Шум помех нарушает тишину.
      before turn, tune(s): ~~~do
        if s:hasnt on:
          say Радио выключено.
          stop
        say Ты пытаешься поймать какую-нибудь волну, но на всех частотах только шум помех.
      ~~~
      when_off: false
      when_on: Радио в машине издаёт помехи.
    obj бардачок:
      words: бардачок|перчаточный ящик
      attrs: static, openable, container
      on:
        exam(s): ~~~do
          if s:hasnt open:
            say Бардачок закрыт.
            stop
          pass
        ~~~
      when_closed: Твоё внимание привлекает бардачок.
      when_open: Бардачок открыт.
      with: браслет

handler have_compass(): ~~~do
  return have 'телефон' and телефон.compass
~~~

handler check_compass(w): ~~~do
  if w == 'u_to' or w == 'd_to' or w == 'in_to' or w == 'out_to':
    stop
  if not have_compass():
    say Чтобы ориентироваться в пространстве, тебе нужен компас.
    return true
  stop
~~~

class Area(room):
  cant_go(s, w): ~~~do
    if check_compass(w):
      stop
    pass
  ~~~
  compass_look(s, w): ~~~do
    if check_compass(w):
      stop
    if w == 'u_to':
      mp:xaction("Exam", _'#небо')
      stop
    if w == 'd_to':
      mp:xaction("Exam", _'#снег')
      stop
    pass
  ~~~

class Snow:
  words: снег
  attrs: scenery, supporter
  on:
    after receive(s, w): ~~~do
      move(w, here())
      pass
    ~~~
    enter, walk: Ты и так стоишь среди снега.
    receive(s, w): ~~~do
      if here() ^ 'В лесу':
        say "Потом ", w:noun'вн', " сложно будет найти."
      else:
        pass
    ~~~
    take(s): Тебе не хочется играть в снежки.

class Sky:
  words: небо|облака
  attrs: scenery
  on:
    default: Небо далеко...
    exam(s): Бледное небо нависло над головой. Солнца не видно.

Area поле:
  words: поле
  on:
    listen(s): ~~~do
      if радио:hasnt on:
        say Стоит звенящая тишина.
      else:
        say Ты слышишь шум радиопомех из машины.
    ~~~
    walk(s): ~~~do
      if where(pl) ^ 'машина':
        say Машина не заводится. Придётся выйти и идти пешком.
        stop
      pass
    ~~~
  before cry: -- Ма-маааааа! -- нет ответа.
  dsc(s): ~~~do
    say Ты стоишь в заснеженном поле.
    if have_compass():
      say На западе начинается хвойный лес.
    else:
      say Неподалёку начинается хвойный лес.
  ~~~
  n_to,ne_to,e_to,se_to,s_to(s, t): ~~~do
    if mp.event == 'Exam':
      pass
    if check_compass('w_to'):
      stop
    say "Ты идешь некоторое время на ", (_('@'..t).word), "."
    say Ничего не меняется. Вокруг все-такой же пустынный пейзаж. Ты решаешь вернуться к машине.
  ~~~
  onenter(s): ~~~do
    if visited(s):
      stop
    say "Холод. Ты лежишь в снегу и медленно приходишь в себя.^\nНекоторое время ты смотришь в небо. Затем поднимаешься на ноги и оглядываешься.^\nСтранно, но ты не видишь никакой заправки. Впрочем, и трассы тоже."
  ~~~
  out_to(): ~~~do
    say Сначала нужно решить, куда тебе идти.
    ~~~
  w_to,nw_to,sw_to(s): ~~~do
    if check_compass('w_to'):
      stop
    return "#лес"
  ~~~
  with:
    Sky:
      nam: #небо
    Snow:
      nam: #снег
      on:
        exam(s): ~~~do
          say Ты видишь запорошенные снегом следы, которые ведут в лес.
          enable '#следы'
        ~~~
    obj:
      words: хвойный лес,лес|чаща|деревья
      nam: #лес
      attrs: scenery
      on:
        default: Лес далеко.
        exam: На деревьях лежит снег.
        walk, enter, climb(s): ~~~do
          walk 'В лесу';
        ~~~
    obj #следы:
      attrs: scenery
      on:
        exam: Следы уже почти скрылись под свежим снегом.
    Prop:
      words: колёса|колесо|двери
  with: машина

lua:
~~~lua
game:dict {
  ["деревья/мн,С"] = {
    "деревья/им";
    "деревья/вн";
    "деревьев/рд";
    "деревьями/тв";
    "деревьях/пр";
    "деревьям/дт";
  };
  ["огонь/вн"] = "огонь";
  ["стены/рд"] = "стен";
  ["голем/рд"] = "голема";
  ["голем/дт"] = "голему";
  ["голем/тв"] = "големом";
  ["голем/вн"] = "голема";
  ["голем/пр"] = "големе";
}
~~~

obj олень:
  words: олень
  attrs: supporter
  disabled: true
  on:
    enter, climb(s): ~~~do
      if where(pl) == s:
        say Но ты уже и так на олене.
        stop
      if not s.sit:
        s:before_Touch()
        stop
      if not have 'перо':
        say Ты подумала, что тебе стоит сначала взять с собой перо странной совы. Кто знает, куда умчит тебя олень?
        stop
      s:daemonStop()
      s.sit = false
      if here() ^ 'В лесу':
        walk 'к хребту'
      else:
        walk 'к поляне'
    ~~~
    exam(s): ~~~do
      if s.sit:
        say Олень стоит перед тобой на коленях.
      else:
        if s:once():
          say Ты замечаешь, что у оленя странные глаза.
        else:
          say Чёрные дырки-глаза оленя пугают тебя.
    ~~~
    touch, talk, ask, tell, kiss(s): ~~~do
      s.step = 4
      say Олень попятился и шумно задышал, жадно втягивая морозный воздух.
    ~~~
  daemon(s): ~~~do
    s.step = s.step + 1
    if s.step > 5:
      say Олень скрылся в лесу.
      s:disable()
      s:daemonStop()
      s.step = 0;
    stop
  ~~~
  init_dsc: Ты видишь на поляне оленя.
  life_Give,Show(s, w): ~~~do
    if not w ^ 'перо':
      pass
    if s.sit:
      say Олень никак не отреагировал.
      stop
    s.sit = true
    say Ты подносишь перо к носу оленя. Чувствуя прикосновение, он шумно втягивает в себя воздух. Затем он опускается перед тобой на колени.
    s:daemonStop()
  ~~~
  sit: false
  step: 0
  with:
    obj:
      words: глаза оленя,глаза,дыр*
      attrs: scenery
      on:
        default: Тебе не нравятся глаза оленя.
        exam: Вместо глаз у оленя чёрные дырки.
    Prop:
      words: рога оленя,рога

handler forest_scenery(s): ~~~do
  disable 'сова'
  disable 'олень'
  disable '#ручей'
  disable '#поляна'
  if s.depth == 0:
    enable 'сова'
  elseif s.depth == 2:
    enable '#ручей'
  elseif s.depth == 3:
    enable '#поляна'
    enable 'олень'
    pic_set '22'
    олень.step = 0
    олень.sit = false
    олень:daemonStart()
~~~

Area "В лесу":
  words: лес|чаща
  on:
    drop(s, w): ~~~do
      say "Зачем бросать ", w:noun'вн', " в лесу?"
    ~~~
  before cry: -- Ма-маааааа! -- нет ответа.
  depth: 0
  dsc(s): ~~~do
    say Ты находишься в хвойном лесу.
    if s.depth == 0:
      if not have_compass():
        say Между деревьями ты видишь снежное поле.
      else:
        say Между деревьями на востоке ты видишь снежное поле.
    elseif s.depth == 1:
      say Тебя окружают деревья.
    elseif s.depth == 2:
      say Ты видишь здесь замёрзший ручей.
    elseif s.depth == 3:
      say Ты вышла на небольшую поляну.
    elseif (s.depth - 4) % 2 == 0:
      say Лес становится всё гуще.
    elseif (s.depth - 4) % 2 == 1:
      say Деревья окружают тебя со всех сторон.
  ~~~
  e_to,se_to,ne_to(s, t): ~~~do
    if check_compass(t):
      stop
    if s.depth == 0:
      return '#поле'
    pl:need_scene(true)
    s.depth = s.depth - 1
    say "Ты идешь некоторое время на ", (_('@'..t).word), "."
    if s.depth == 0:
      say За деревьями на востоке ты видишь снежное поле.
    forest_scenery(s)
  ~~~
  enter(s): ~~~do
    if seen 'сова':
      сова:daemonStart()
  ~~~
  out_to(s): ~~~do
    if s.depth == 0:
      return '#поле';
    pass
  ~~~
  s_to,n_to(s, t): ~~~do
    if check_compass(t):
      stop
    if s.depth <= 1:
      say Ты решила, что идти вдоль границы леса не очень хорошая идея.
    else:
      say Ты решила, что лучше держаться западного направления.
  ~~~
  title: Лес
  w_to,nw_to,sw_to(s, t): ~~~do
    if check_compass(t):
      stop
    s.depth = s.depth + 1
    if s.depth > 8 then s.depth = 6 + rnd(3) end
    forest_scenery(s)
    pl:need_scene(true)
    say "Ты идешь некоторое время на ", (_('@'..t).word), "."
    if s.depth > 7 and rnd(100) < 30:
      say ^Ты можешь идти так целую вечность...
  ~~~
  with:
    Sky:
      nam: #небо
    Snow:
      nam: #снег
      on:
        exam(s): ~~~do
          if here().depth == 0:
            say Здесь едва заметный след теряется.
          else:
            pass
        ~~~
    obj #поле:
      attrs: scenery
      on:
        default: Поле далеко.
        exam: Снежное поле выглядит бескрайним.
        walk, enter, climb(s): ~~~do
          if here().depth == 0:
            walk 'поле'
          else:
            say Поле где-то на востоке.
        ~~~
    Prop #деревья:
      words: деревья|дерево|сосна,ветк*
      on:
        enter, climb: Первые ветки находятся высоко. У тебя не получится забраться.
        exam(s): ~~~do
          if s:hint plural:
            say Деревья покрыты снегом.
          else:
            say Ветви дерева покрыты снегом.
        ~~~
    obj сова:
      words: полярная сова,сова,птица
      on:
        exam(s): ~~~do
          say Тебе кажется, что это полярная сова. Только у неё странные глаза.
          if here() ^ 'поле':
            line
            _'#глаза совы':before_Exam()
        ~~~
        touch(s): ~~~do
          if where(s) ^ 'В лесу':
            say Она слишком высоко.
            stop
          if not s.seen:
            say Сначала хорошо бы рассмотреть, с чем имеешь дело.
            stop
          if s.talked:
            say Тебе не очень хочется иметь с ней дело.
          else:
            say Ты осторожно дотронулась до птицы.^
            say Сова вздрогнула и её глаза-дырки уставились на тебя.
        ~~~
      daemon(s): ~~~do
        if s.talked:
          stop
        if s:where() ^ 'В лесу' and where(s) ^ 'В лесу' and _'В лесу'.depth == 0 and rnd(3) == 1:
          say Хлопая крыльями сова улетела в сторону поля.
          move(s, 'поле')
        elseif here() ^ 'поле' and where(s) ^ 'поле' and s.talked and rnd(3) == 1:
          say Хлопая крыльями сова улетела в сторону леса.
          move(s, 'В лесу')
        stop
      ~~~
      dsc(s): ~~~do
        if where(s) ^ 'поле':
          say На машине сидит сова.
        else:
          say На ветке сосны сидит сова.
      ~~~
      init_dsc: Ты замечаешь большую сову, сидящую на ветке сосны.
      seen: false
      talk_to(s): ~~~do
        if where(s) ^ 'В лесу':
          say Хлопая крыльями сова улетела в сторону поля.
          move(s, 'поле')
          stop
        if not s.seen:
          say Сначала хорошо бы рассмотреть, с чем имеешь дело.
          stop
        if s.talked:
          say "-- Что всё это значит?^\n-- Я сделала то, что мне повелела госпожа."
          say ^Сова хлопнула крыльями и улетела.
          remove(s)
          s:daemonStop()
          stop
        return 'разговор с совой'
      ~~~
      talked: false
      with:
        obj:
          words: глаза совы,глаза,дыр*
          nam: #глаза совы
          on:
            default: Тебе не нравятся эти глаза.
            exam(s): ~~~do
              say На месте глаз у совы зияют чёрные дырки.
              if not сова.seen:
                say ^Интересно, видит ли она тебя?
              сова.seen = true
            ~~~
    Prop #поляна:
      words: поляна
      attrs: scenery
      disabled: true
    Prop #ручей:
      words: ручей
      attrs: scenery
      disabled: true
  with: олень

obj перо:
  words: перо
  on:
    exam(s): ~~~do
      say Белое перо.
      if have(s):
        say Зачем оно тебе?
      else:
        say Его оставила сова с дырками вместо глаз.
    ~~~
  init_dsc(s): ~~~do
    if s:hasnt moved and where(pl) ^ 'машина':
      stop
    say На крыше машины лежит белое перо.
  ~~~

talk "разговор с совой":
  title: false
  enter: ~~~do
    pic_set '21'
  ~~~
  intro: -- О, я слышу тебя, дитя! -- ответ птицы напугал тебя.
  option:
    ask: Ты меня не видишь?
    reply: -- Я тебя чувствую...
  option:
    ask: Ты умеешь говорить?
    reply: -- Я разговариваю с тобой.
  option:
    ask: Что с твоими глазами?
    reply: -- Такой меня сделала моя госпожа.
    option:
      ask: Кто твоя госпожа?
      reply: -- Она вызвала меня. Она сказала, чтобы я передала тебе...
      option:
        ask: Что?
        reply: -- Твоя мама ждёт тебя во дворце. Поспеши.
        goto: deep
      option:
        ask: Ты видела мою маму?
        reply: -- Твоя мама ждёт тебя во дворце. Поспеши.
        goto: deep
  label deep:
    option:
      ask: Где этот дворец?
      reply: -- Он за ледяным хребтом на западе.
      option:
        ask: Это далеко?
        do: ~~~do
          say -- Расстояние -- всего лишь время. А время здесь замёрзло. Возьми перо. По нему тебя узнают другие слуги госпожи.
          move ('перо', 'машина')
          перо:attr ~moved
          сова.talked = true
          walkout()
        ~~~
    option:
      ask: Что за бред ты несёшь.
      reply: -- Моя госпожа сказала мне передать тебе...
      option:
        ask: Ладно, ладно...
        reply: -- Поспеши же, дитя!

story "к хребту":
  text: "Ты садишься на оленя и он поднимается с колен.^^\n\t\tВы мчитесь через лес на запад. Снова и снова олень ловко огибает встречные деревья и вы оставляете их позади.^^\n\t\tПостепенно лес начинает редеть и сквозь деревья ты видишь ледяные горы.^^\n\t\tОлень остановился перед ледяной стеной и опустился, чтобы ты могла слезть."
  next_to: Ледяные горы
  onexit(s, to): ~~~do
    say Ты слезаешь с оленя.
    move('олень', to)
  ~~~
  title: false

story "к поляне":
  text: "Ты садишься на оленя и он поднимается с колен.^^\n\t\tВы мчитесь через лес на восток. Снова и снова олень ловко огибает встречные деревья и вы оставляете их позади.^^\n\t\tПостепенно лес начинает редеть.^^\n\t\tОлень остановился и опустился на колени, чтобы ты могла слезть."
  next_to: В лесу
  onexit(s, to): ~~~do
    say Ты слезаешь с оленя.
    move('олень', to)
  ~~~
  title: false

Area "Ледяные горы":
  dsc: Ты стоишь перед ледяной стеной, которая продолжается на север и юг. На востоке начинается лес.
  e_to,ne_to,se_to: #лес
  in_to: #стена
  nw_to,sw_to,n_to,s_to(s): ~~~do
    say По этому направлению нет ничего интересного. Такая же ледяная стена.
    ~~~
  onexit(s, t): ~~~do
    if t ^ 'пещера' and not visited 'пещера':
      pic_set '23-pan'
  ~~~
  title: У ледяных гор
  w_to: #стена
  with:
    obj:
      words: хвойный лес,лес|чаща|деревья
      nam: #лес
      attrs: scenery
      on:
        default: Лес далеко.
        exam: На деревьях лежит снег.
        walk, enter, climb(s): В этом лесу можно ходить вечность.
    Snow:
      nam: #снег
    Sky:
      nam: #небо
    obj:
      words: `function(s) pr (-"ледяная стена,стена|лёд|лед|поверхность|скала|гора|горы/жр"); if s.light > 0 then pr (-"|свечение/ср|свет") end  end`
      nam: #стена
      attrs: scenery
      on:
        attack(s): Скала {$fmt em|выглядит} твёрдой. Ты решила не рисковать.
        climb: У тебя вряд ли это получится. Стена отвесная.
        enter, walk(s): ~~~do
          if s.light == 0:
            say Как ты это сделаешь? Стена твёрдая, гладкая и скользкая.
            stop
          walk 'пещера'
        ~~~
        exam(s): ~~~do
          if s.light > 0:
            say Сквозь лёд ты видишь фиолетовое свечение.
          else:
            say Ледяная стена отвесно уходит вверх. Её поверхность выглядит скользкой.
        ~~~
        taste: А язык не приклеится?
        touch, push(s): ~~~do
          say Ты касаешься ладонью гладкой ледяной поверхности.
          if s.light > 0:
            say Как странно, твоя рука проходит сквозь лёд!
            s.light = 2
          else:
            s.light = 1
          s:daemonStart();
        ~~~
      before knock(s): ~~~do
        if s.light == 0:
          pass
        say Ты попыталась постучать по стене, но у тебя это не вышло! Рука прошла сквозь лёд!
      ~~~
      daemon(s): ~~~do
        if player_moved():
          s.light = 0
          s:daemonStop()
          stop
        if s.light == 1:
          say Ты замечаешь, что под поверхностью льда разливается фиолетовое свечение.
        elseif s.light == 2:
          say Фиолетовое свечение под поверхностью льда усиливается!
        elseif s.light == 3:
          say Фиолетовое свечение ослабевает.
        else:
          s:daemonStop()
          s.light = 0
          stop
        s.light = s.light + 1
      ~~~
      light: 0

room пещера:
  words: пещера
  attrs: ~light
  Play(s, w): ~~~do
    if not w or not have 'скрипка':
      pass
    if not w then w = скрипка end
    if not w ^ 'скрипка':
      pass
    if _'#кристаллы'.try == 0 or _'#кристаллы'.broken:
      pass
    _'#кристаллы'.broken = true
    pic_set '24'
    say "Интересно... А что если? Не успев додумать мысль, ты уже берёшь скрипку в руки.^^\nТы извлекаешь \"ми\" второй октавы. Сначала ничего не происходит, но затем ты слышишь, как странный кристалл отзывается\nна звук твоей скрипки.^^\nЗвуки скрипки и кристалла усиливают друг друга в резонансе. Ты почти физически ощущаешь, как\nнапряжение кристалла достигает своего пика. И, наконец, он шумно взрывается на мелкие осколки."
    enable 'осколки'
  ~~~
  dark_dsc: Ты видишь слабое свечение в темноте.
  dsc: "Ты находишься внутри небольшой ледяной пещеры. У восточной стены ты видишь странное свечение.^\nПещера продолжается на северо-запад."
  e_to: #свечение
  nw_to(s): ~~~do
    if mp:thedark() and not visited'пещера2':
      say Ты же не видишь куда идти.
      stop
    return 'пещера2'
  ~~~
  onenter(s): ~~~do
    if not visited(s):
      say Доверившись интуиции, ты входишь в фиолетовое свечение, которое вдруг заполняет всё вокруг. Шаг. Еще один. И вдруг ты оказываешься в полной темноте. Если не считать слабого свечения позади.
  ~~~
  out_to: Ледяные горы
  title(s): ~~~do
    if mp:thedark():
      say В темноте
    else:
      say Ледяная пещера
  ~~~
  with:
    obj #свечение:
      words: свечение
      attrs: scenery, luminous
      on:
        exam(s): ~~~do
          say Этим путём ты попала сюда. Вероятно, с помощью него можно выйти наружу.
          say ^Ты обращаешь внимание, что источником странного свечения служат фиолетовые кристаллы, растущие из стены.
          enable '#кристаллы'
        ~~~
        walk, climb, enter(s): ~~~do
          walk 'Ледяные горы';
        ~~~
      before touch, push, knock: Твоя рука проходит сквозь свечение.
    Prop #стены:
      words: стены|стена|пол|потолок
      attrs: luminous
      on:
        exam(s): ~~~do
          if mp:thedark():
            say В полной темноте это будет сложно.
          else:
            pass
        ~~~
      before touch, push, knock: Похоже, ты находишься в ледяной пещере.
    obj #кристаллы:
      words: кристаллы|кристалл
      attrs: luminous, static
      disabled: true
      on:
        exam: Полупрозрачные кристаллы растут прямо из льда.
        touch(s): ~~~do
          if s.try == 0 or s.broken:
            pass
          else:
            say Ты чувствуешь как кристалл вибрирует.
        ~~~
      before attack, knock(s): ~~~do
        if s.broken:
          say Ты уже разрушила один кристалл.
          stop
        if s.try == 2:
          say Ты постучала по звонкому кристаллу.
        else:
          say Ты постучала по одному из кристаллов.
        if s.try == 0:
          s.try = 1
          say "Ответом был мелодичный звенящий звук. Твой музыкальный слух определил его как \"фа\" малой октавы, что\n\t\t\t\tнаходится вне диапазона твоей скрипки. Интересно, они все звучат одинаково?"
        elseif s.try == 1:
          say "На этот раз звук оказался более высоким. Ты определила его как {$fmt em|\"ми\"} второй октавы."
          say ^Ты решила запомнить этот кристалл.
          s.try = 2
        else:
          say Звенящий звук кристалла долго отражается от ледяных стен. Ты чувствуешь вибрацию.
      ~~~
      broken: false
      try: 0
    obj осколки:
      words: осколки кристалла,осколок*|осколки|кусочки|куски
      attrs: luminous
      disabled: true
      on:
        exam: Осколки кристалла пульсируют слабым фиолетовым свечением.
        take(s): ~~~do
          if here() ^ 'пещера2' and here().solved:
            say Ты боишься беспокоить летучих мышей.
            stop
          pass
        ~~~
      before light: Свет испускаемый осколками очень тусклый для этого.

obj ообрыв:
  words: обрыв,разлом|пропасть
  attrs: scenery, container, open
  on:
    enter: Прыгнуть в пропасть? Тебе нужно найти маму, а не сбегать от проблем...
    exam(s): Глубокий разлом во льду. Света фонарика недостаточно, чтобы оценить его глубину. К счастью, ширина разлома не превышает двух метров.
    jumpover(s): ~~~do
      say Ты разбегаешься и прыгаешь через пропасть...
      if here() ^ 'обрыв':
        walk 'Другая сторона'
      else:
        walk 'обрыв'
    ~~~
    receive(s, w): ~~~do
      say "Ты потом не сможешь достать ", w:noun 'вн', " из пропасти."
    ~~~

room пещера2:
  words: пещера
  attrs: ~light
  on:
    listen(s): ~~~do
      if s.solved:
        say Ты слышишь отвратительный писк и хлопанье крыльев.
      else:
        say Стоит мёртвая тишина.
    ~~~
  dsc(s): ~~~do
    line Стены этой части пещеры испещрены небольшими отверстиями.
    if from() ^ 'пещера':
      say Ты попала сюда с юго-востока. Пещера продолжается на юго-запад.
    else:
      say Ты попала сюда с юго-запада. Пещера продолжается на юго-восток.
    if not s.solved:
      say ^^Твой взгляд прикован к потолку, который усеян чёрными лоскутками. Ты вздрагиваешь, когда ответ приходит тебе в голову. Пещера заполнена летучими мышами!
    else:
      say "^^Ты видишь, как странные чёрные твари дерутся за фиолетовые осколки кристалла,\nкотрые ты рассыпала по полу пещеры."
  ~~~
  out_to(s): ~~~do
    if from() ^ 'пещера':
      return 'пещера'
    else:
      return 'обрыв'
  ~~~
  se_to,e_to: пещера
  solved: false
  sw_to,w_to(s): ~~~do
    if mp:thedark() and not visited'обрыв':
      say Сложно сделать это в полной темноте.
      stop
    return 'обрыв';
  ~~~
  title: Пещера с летучими мышами
  with:
    Prop:
      words: стены|стена|пол|потолок
    obj #мыши:
      words: летучие мыши,мыши,твари,мышь*
      attrs: concealed, animate
      on:
        attack: Тебе не удастся убить их всех.
      description(s): ~~~do
        say Тебе они не нравятся. Называя вещи своими словами -- ты их панически боишься.
        if here().solved:
          say ^Но кажется, они поглощены борьбой за светящимися осколками кристалла.
      ~~~
      life_Show,Give: "Пока они заняты, лучше их не беспокоить."
    obj:
      words: отверстия|дырки|дыры
      attrs: scenery, container
      on:
        receive: Не стоит туда соваться.
      description: Тебе приходит в голову, что эти отверстия могут быть норами. Лучше держаться от них подальше.

room обрыв:
  attrs: ~light
  dsc: На западе гладкий пол пещеры заканчивается обрывом. Выход находится на юго-востоке.
  out_to: пещера2
  se_to,e_to: пещера2
  w_to: ообрыв
  with:
    Prop:
      words: стены|стена|пол|потолок
  with: ообрыв

obj отверстие:
  words: `function() pr (-"отверстие|выход|дырка|дыра"); if here() ^ 'За ледяной стеной' then pr (-"|пещера") end  end`
  attrs: scenery
  on:
    enter, walk, climb(s): ~~~do
      if here() ^ 'Другая сторона':
        walk 'За ледяной стеной';
      else:
        walk 'Другая сторона'
    ~~~
    exam: Отверстие достаточно широкое для того, чтобы пролезть в него.

room "Другая сторона":
  words: пещера
  dsc: "Здесь светло. Свет поступает в пещеру через широкое отверстие на западе.\nПропасть находится на востоке."
  e_to: ообрыв
  out_to: отверстие
  title: Пещера
  w_to: отверстие
  with:
    Prop:
      words: стены|стена|пол|потолок
  with: ообрыв, отверстие

room "За ледяной стеной":
  words: плато/ср
  cant_go(s): На плато не видно ничего интересного, кроме скалы.
  dsc(): ~~~do
    say Ты находишься на снежном плато, рядом со входом в пещеру. Ледяные горы окружают плато со всех сторон. Может быть поэтому, стоит мёртвая тишина.
    say На западе, в центре плато возвышается ледяная скала.
  ~~~
  e_to: отверстие
  in_to: отверстие
  title: Плато
  w_to: #замок
  with:
    Prop:
      words: горы/но,мн|стена|стены
    Snow:
      nam: #снег
    Sky:
      nam: #небо
    obj:
      words: скала|замок|дворец|вершины
      nam: #замок
      attrs: scenery
      on:
        default: Сначала к скале нужно подойти.
        enter, walk, climb(s): ~~~do
          walk 'У замка'
        ~~~
        exam: Остроконечные вершины ледяной громады высоко возвышаются над плато.
  with: отверстие

obj ворота:
  words: разлом|проход|отверстие|щель|вход
  attrs: scenery
  disabled: true
  on:
    walk, enter, climb(s): ~~~do
      if here() ^ 'У замка':
        mp:xaction("Enter", _'#замок')
      else:
        walk 'У замка'
    ~~~
  description: Высота разлома с неровными краями достигает трёх метров, а ширина -- двух. Верх отверстия имеет форму арки.

obj голем:
  words: `function(s) if s:has'animate' then p (-"ледяной человек/ед,мр,од|человек|статуя|голем/ед,мр,од"); else p (-"статуя|ледяной человек|человек"); end  end`
  attrs: ~animate
  on:
    any(s, e): ~~~do
      if e == 'Exam' or e == 'Walk' or e == 'Climb' or e == 'Enter':
        pass
      if not disabled 'дверь' or not visited 'королева-диалог':
        pass
      say Сначала к голему нужно подойти.
    ~~~
    climb: Это не так просто сделать.
    take, push, pull(s): ~~~do
      say s:Noun(), " весит не меньше сотни килограмм. Как ты это сделаешь?"
    ~~~
    taste: А язык не приклеится?
    walk, enter, climb(s): ~~~do
      if visited 'королева-диалог' and disabled 'дверь':
        say Ты последовала за големом. Обогнув колонну и подойдя к северной стене, ты заметила небольшую деревянную дверь.
        enable 'дверь'
        stop
      pass
    ~~~
  description(s): ~~~do
    if s:has animate:
      say Высота ледяного человека около двух метров. У него есть руки и ноги, но вместо головы лишь небольшой выступ.
      if visited 'королева-диалог' and disabled 'дверь':
        say Сейчас голем стоит у северной части зала и ждет тебя.
    else:
      say Статуя сделана из льда и изображает двухметрового человека с массивным телосложением.
  ~~~
  init_dsc(s): ~~~do
    if s:has animate:
      say У стены стоит ледяной человек.
    else:
      say Твоё внимание привлекает огромная ледяная статуя.
  ~~~
  life_Give,Show,ThrowAt(s, w): ~~~do
    if w ^ 'перо':
      if disabled 'ворота':
        say "Едва ты достала перо, как статуя сдвинулась с места. Сделав два шага по направлению к тебе,\nстрашный ледяной человек остановился.^"
        enable 'ворота'
        say -- Госпожа ждёт тебя! -- прогремел голос с двух метровой высоты.^
        say После этих слов голем размахнулся и ударил своим кулаком в стену.
        say Стена с треском раскололась и в ней образовался проход.
        s:attr animate
      else:
        if not visited 'Тронный зал':
          say -- Госпожа ждёт тебя! -- прогремел голос с двух метровой высоты.
        else:
          say -- Я узнал тебя.
      stop
    pass
  ~~~
  with:
    Prop:
      words: ноги|руки|голова|выступ

room "У замка":
  dsc(s): ~~~do
    say Ты стоишь у подножия ледяной скалы. Отвесная стена уходит высоко вверх.
    if not disabled 'ворота':
      say В стене зияет разлом.
    say Пещера, с помощью которой ты прошла сквозь горы, находится на востоке.
  ~~~
  e_to: За ледяной стеной
  in_to: #замок
  onenter(s): ~~~do
    if not visited(s):
      pic_set '25'
  ~~~
  title: У подножия скалы
  w_to: #замок
  with:
    obj:
      words: скала|гора|замок|дворец|стена
      nam: #замок
      attrs: scenery
      on:
        enter, walk, climb(s): ~~~do
          if disabled 'ворота':
            pass
          if голем:hasnt moved:
            move('голем', 'Тронный зал')
          walk 'Тронный зал';
        ~~~
        taste: А язык не приклеится?
      description: Острые вершины скалы устремлены в небо.
      with: ворота
    Snow:
      nam: #снег
    Sky:
      nam: #небо
  with: голем

obj королева:
  words: мама,мать,королева,женщина
  attrs: animate
  on:
    kiss, touch(s): Тебе кажется, что это не твоя мама. Тебе становится страшно.
    walk(s): ~~~do
      return _'#трон':before_Walk()
    ~~~
  before talk, say, ask, tell(s): ~~~do
    if not s.queen:
      say Сначала ты хочешь рассмотреть её внимательней.
    else:
      s:daemonStop()
      if visited'королева-диалог':
        say "-- Ты уже готова стать моей дочерью?^\n-- Нет!^\n-- Ну что же, я подожду."
      else:
        if браслет:has worn:
          walk 'королева-диалог'
        else:
          walk 'badend2'
  ~~~
  daemon(s): ~~~do
    local tt = { "-- Иди ко мне скорее, моё дитя!", "-- Что же ты медлишь? Обними и поцелуй свою мать!", "-- Я так долго тебя ждала!", "-- Теперь всё будет хорошо, я буду любить тебя всегда!", "-- Мы будем вместе!", }
    say tt[rnd(#tt)], " -- произносит твоя мать с трона."
  ~~~
  description(s): ~~~do
    s.queen = true
    if _'Тронный зал'.near:
      say "Женщина похожа на твою маму, но в чертах её лица ты видишь что-то незнакомое, чужое и, поэтому, неприятное.\nНо больше всего тебя пугают её глаза. Они закрыты. Ты растерянно вглядываешься в её лицо, снова и снова пытаясь отыскать родные черты."
    else:
      say Это твоя мама! Не может быть! Что это за место? Что она тут делает? Столько вопросов!
  ~~~
  init_dsc(s): ~~~do
    say На троне сидит твоя мама.
    if s.queen:
      say Или это не мама?
  ~~~
  queen: false
  with:
    obj:
      words: лицо
      description(s): ~~~do
        if _'Тронный зал'.near:
          королева:description()
        else:
          say Отсюда плохо видно её лицо.
      ~~~
    obj:
      words: глаза
      description(s): ~~~do
        if _'Тронный зал'.near:
          if not visited 'королева-диалог':
            say Её глаза закрыты. Как будто она спит. Тебе становится страшно.
          else:
            say "Ты стараешься не думать о глазах твоей {$fmt em|новой} мамы."
        else:
          say Отсюда плохо видны её глаза.
      ~~~

room "Тронный зал":
  words: зал
  on:
    default(s, e, w): ~~~do
      if not w:
        pass
      if not w ^ 'королева' and not w ^ '#трон':
        pass
      if e == 'Exam' or s.near:
        pass
      if e == 'Walk':
        pass
      say Сначала нужно подойти к трону.
    ~~~
  dsc(s): ~~~do
    say "Ты находишься в огромном зале. В центре зала установлен трон. Все пространство зала залито светом, который отражается\nот ледяных стен, пола, потолка и массивных колонн. У южной стены расположена широкая лестница, ведущая вниз. Выход из зала находится на востоке."
    if not disabled'дверь':
      say Дверь в твою комнату находится в северной стене.
  ~~~
  enter(s): ~~~do
    if s:once():
      line Набравшись мужества ты вошла внутрь и оказалась в длинном коридоре.
      say Голем последовал за тобой. Его шаги гулко отражались от изломанных стен и сводчатого потолка.
      line Через некоторое время коридор кончился и вы вошли в большой зал.
      line Зал был огромен! В его центре ты увидела трон, на котором сидела женщина... Твоя... мама?
      line -- Я ждала тебя! Подойди же и поцелуй меня! -- голос матери, отраженный от ледяных стен зала показался тебе чужим.
      DaemonStart 'королева'
      remove 'сова'
      pic_set '30'
  ~~~
  in_to(s): ~~~do
    if not disabled 'дверь':
      return 'дверь'
    pass
  ~~~
  n_to(s): ~~~do
    if disabled 'дверь' and visited 'королева-диалог':
      return 'голем'
    if not disabled 'дверь':
      return 'дверь'
    pass
  ~~~
  near: false
  onexit(s, to): ~~~do
    if to ^ 'королева-диалог' or to ^ 'badend2' or to ^ 'badend4':
      stop
    if not s.near:
      if браслет:hasnt worn:
        if to ^ 'Зал с зеркалами':
          say Сейчас не лучшее время для прогулок.
          pass
        say Поддавшись смутному интуитивному чувству, ты покидаешь тронный зал.
        DaemonStop 'королева'
        stop
      say Ты нашла свою маму! Не время уходить!
      pass
    if seen 'голем':
      if not visited 'королева-диалог':
        say Ты пытаешься уйти из зала, но ледяной голем преграждает тебе путь.
        pass
  ~~~
  out_to,e_to: ворота
  s_to,d_to: #лестница
  u_to(s): ~~~do
    if visited 'комната' then return 'дверь' end
    pass
  ~~~
  with:
    obj #трон:
      words: трон|кресло
      attrs: scenery, supporter
      on:
        enter, climb(s): ~~~do
          if seen 'королева':
            say Трон занят.
          else:
            say Тебе не нужна власть. Тебе нужна мама.
        ~~~
        walk(s): ~~~do
          if _'Тронный зал'.near:
            pass
          say "Ты бежишь к трону. Твоё сердце от радости выпрыгивает из груди. Но что-то странное ты замечаешь в облике матери.\nВ нерешительности ты останавливаешься в нескольких шагах от неё."
          if браслет:hasnt worn:
            DaemonStop'королева'
            walk 'badend2'
            stop
          _'Тронный зал'.near = true
        ~~~
      description: Великолепный трон сделан, как и всё вокруг, из льда. Высокая прямая спинка украшена причудливыми узорами.
    Prop:
      words: узоры|спинка|колонны|стены
    door дверь:
      words: деревянная дверь|дверь
      attrs: scenery
      disabled: true
      description(s): ~~~do
        say "Небольшая деревянная дверь. Странно, что она сделана не из льда."
        pass
      ~~~
      door_to(s): ~~~do
        if here() ^ 'комната':
          return 'Тронный зал'
        else:
          return 'комната';
      ~~~
    obj:
      words: свет
      attrs: scenery
      on:
        default: Как ты сделаешь это с светом?
        exam: Свет кажется тебе каким то бледным. Он не приносит радости.
    obj:
      nam: #лестница
      attrs: scenery
      on:
        enter, walk, climb(s): ~~~do
          walk 'Зал с зеркалами';
        ~~~
      description: Широкая лестница начинается от южной стены и ведёт вниз.
  with: королева, ворота

talk "королева-диалог":
  title: false
  intro: -- Иди же и обними меня! -- глаза матери по прежнему закрыты и это пугает тебя.
  option:
    ask: Почему твои глаза закрыты?
    reply: -- Поцелуй меня и я открою их.
    goto: дальше
  option:
    ask: Ты точно моя мама?
    reply: -- Да, а ты моя дочь. Я так ждала тебя, иди и обними меня.
    goto: дальше
  exit: "^Твоя мама махнула рукой голему и тот, с грохотом, направился к северной стене зала. Дойдя до неё он остановился."
  label дальше:
    option:
      ask: Я не верю тебе! Ты не моя мама!
      reply: -- Ну зачем ты так? Ты стала такой грубой!
      option:
        ask: Хватит притворяться!
        reply: -- Я твоя {$fmt em|другая} мама. Я буду любить тебя вечно. Поцелуй меня, дитя.
      option:
        ask: Куда ты дела мою настоящую маму?
        reply: -- Здесь нет другой мамы, кроме меня. Зачем ты упрямишься? У нас есть целая вечность, чтобы полюбить друг-друга.
      option:
        ask: Открой свои... чёртовы глаза!
        reply: -- Хорошо, как скажешь... -- женщина открыла глаза. На месте глаз ты видишь чёрные отверстия. Тебе кажется, что ты сходишь с ума.
      onempty: ~~~do
        push '#дальше2'
      ~~~
    option:
      ask: Хорошо, сейчас.
      do: ~~~do
        walk 'badend'
      ~~~
  label дальше2:
    option:
      ask: Я знаю, ты забрала мою маму! Сейчас же верни её!
      reply: -- Хорошо, дитя. Жаль, что тебе нужно время, чтобы привыкнуть ко мне. Но я подожду. Мой слуга проводит тебя в твою комнату.
      option:
        ask: Я всё равно сбегу и найду свою настоящую маму! Я знаю -- она где-то здесь!
        reply: -- Глупышка, ты думаешь я тебя обманываю? Знай, ты свободна ходить туда, куда хочешь. И делать то, что хочешь. Можешь искать свою... {$fmt em|другую} маму. Но не отказывай мне, посмотри свою комнату. Отдохни. И приходи ко мне, когда забудешь о своих фантазиях.
        option:
          ask: А если я найду маму, ты нас отпустишь?
          reply: -- Ты никогда не найдёшь её. Но хорошо, я обещаю. Только и ты пообещай мне, что если отчаешься найти её, то станешь моей дочерью.
          option:
            ask: Хорошо, обещаю.
            do: ~~~do
              say -- Ну что же, чувствуй себя как дома. Дворец в твоём распоряжении.
              walkback'Тронный зал'
            ~~~
          option:
            ask: Похоже, у меня нет выбора. Я в твоей власти? Мне не выбраться отсюда?
            do: ~~~do
              say -- Хорошо, что мы поняли друг-друга. Дворец в твоём распоряжении.
              walkback 'Тронный зал'
            ~~~

story badend:
  text: "Ты поднимаешься по ступенькам пьедестала и обнимаешь свою мать.^^\n\t\tОт неё веет холодом, который сковывает тебя, но ты уже ничего не можешь изменить.^^\n\t\tГлаза Снежной Королевы открываются и ты смотришь в чёрную бездну...^^\n\t\t{$fmt b|{$fmt c|КОНЕЦ}}"
  text: {$fmt r|{$fmt em|Но всё могло закончиться по другому...}}
  exit(): ~~~do
    pic_pop()
  ~~~
  next_to: королева-диалог
  onenter(): ~~~do
    pic_push '99'
  ~~~
  title: Конец

story badend2:
  text: "-- Не бойся меня, беззащитное дитя. Я вижу, что на тебе нет {$fmt em|её} талисмана. Это лучше для нас обеих, всё закончится быстро...^^\n\t\tИ все сомнения вдруг уходят. Чувствуя в глубине ужас, ты поднимаешься по ступенькам пьедестала и обнимаешь свою мать.^^\n\t\tОт неё веет холодом, который сковывает тебя, и ты уже ничего не можешь изменить.^^\n\t\tТы смотришь внутрь черных дыр-глаз Снежной Королевы...^^\n\t\t{$fmt b|{$fmt c|КОНЕЦ}}"
  text: {$fmt r|{$fmt em|Но всё могло закончиться по другому...}}
  exit(): ~~~do
    pic_pop()
  ~~~
  next_to: Тронный зал
  onenter(): ~~~do
    pic_push '99'
  ~~~
  title: false

story badend4:
  text: "-- Спасибо, дитя. Ты правильно сделала, что сама отдала мне {$fmt em|её} талисман. Это лучше для нас обеих, всё закончится быстро...^^\n\t\tИ все сомнения вдруг уходят. Чувствуя в глубине ужас, ты поднимаешься по ступенькам пьедестала и обнимаешь свою мать.^^\n\t\tОт неё веет холодом, который сковывает тебя, и ты уже ничего не можешь изменить.^^\n\t\tТы смотришь внутрь черных дыр-глаз Снежной Королевы...^^\n\t\t{$fmt b|{$fmt c|КОНЕЦ}}"
  text: {$fmt r|{$fmt em|Но всё могло закончиться по другому...}}
  exit(): ~~~do
    pic_pop()
    enable 'королева'
  ~~~
  next_to: Тронный зал
  onenter(): ~~~do
    pic_push '99'
    disable 'королева'
  ~~~
  title: false

talk "сова2-диалог1":
  title: false
  enter: ~~~do
    pic_set '21'
  ~~~
  intro: -- Я хочу помочь тебе, дитя. -- сказала странная птица.
  option:
    ask: Как именно?
    reply: -- Я покажу тебе путь отсюда.
    option:
      ask: Но я нашла свою маму. Правда, она застряла в зеркале... Ты можешь помочь?
      reply: -- Глупое дитя. Ты так ничего и не поняла? Повесь зеркало на стену.

talk "сова2-диалог2":
  title: false
  enter: ~~~do
    pic_set '21'
  ~~~
  intro: -- Итак, дитя, ты уже поняла, что твоя мама находится в нормальном мире? А ты -- за зеркалом?
  option:
    ask: Да.
    reply: -- Хорошо, это сэкономит нам время. Итак, чтобы вернуться в нормальный мир, ты должна войти в зеркало...
    goto: дальше
  option:
    ask: Нет.
    reply: -- Всё просто, ты находишься за зеркалом. Твоя мама -- в обычном мире. Чтобы вернуться домой ты должна войти в зеркало...
    goto: дальше
  label дальше:
    option:
      ask: Просто войти в зеркало?
      reply: -- Да. Но сначала, его нужно разморозить. И это могу сделать я. Для тебя.
      option:
        ask: Так сделай это!
        reply: -- Я могу это сделать. Но для этого, мне нужны глаза.
        goto: дальше2
      option:
        ask: Что ты хочешь взамен?
        reply: -- Мне нужны глаза.
        goto: дальше2
    option:
      ask: Но я нашла свою маму. Значит, мы свободны!
      reply: -- Снежная Королева всё равно не отпустит тебя, дитя. Но я могу тебе помочь.
    option:
      ask: Зачем ты помогаешь мне?
      reply: -- Я хочу стать свободной, мне надоело служить госпоже.
  label дальше2:
    option:
      ask: Глаза?
      reply: -- Да. Существа, подобные мне, не могут даже коснуться зеркала. Но с настоящими глазами...
      option:
        ask: И где же я найду глаза?
        reply: -- У тебя есть глаза. В этом месте ты единственная, у кого они есть. Отдай их мне!
        option:
          ask: Нет!
          do: ~~~do
            say '-- Я возьму их не надолго. Больно не будет. Тебе просто нужно согласиться. И помни. Я одна могу помочь тебе вернуться домой и увидеть маму. Так "да", или "нет"?'
            push '#данет'
          ~~~
        option:
          tag: #данет
          ask: Хорошо.
          reply: -- Мне нужен ответ. Да или нет?
          option:
            ask: Да.
            do: ~~~do
              walk 'yes'
            ~~~
          option:
            ask: Нет!
            do: ~~~do
              say -- Ну что же. Я подожду, если ты передумаешь...
              walkout()
            ~~~

talk "сова2-диалог3":
  title: false
  enter: ~~~do
    pic_set '21'
  ~~~
  intro: -- Итак, дитя, что ты решила? Ты отдашь мне свои глаза?
  option:
    ask: Да.
    do: ~~~do
      walk 'yes'
    ~~~
  option:
    ask: Нет!
    do: ~~~do
      say -- Ну что же. Я подожду, если ты передумаешь...
      walkout()
    ~~~

obj сова2:
  words: полярная сова,сова,птица
  attrs: scenery, animate
  daemon(s): ~~~do
    s.num = s.num + 1
    if s.num < 3:
      stop
    if _'#окно':hasnt open:
      say Ты слышишь стук в окно.
    else:
      say Ты видишь, как в открытое окно влетает полярная сова и садится прямо на стол.
      s:daemonStop()
      s.finside = true
      move(s, '#стол')
      s:attr ~scenery
  ~~~
  description: Похоже, это та самая сова, которая привела тебя в это место. Ты боишься смотреть в её чёрные глаза.
  finside: false
  num: 0
  talk_to(s): ~~~do
    if not s.finside:
      say Она за стеклом.
      stop
    if visited 'сова2-диалог1' and not where'зеркало' ^ '#стена':
      say -- Повесь зеркало на стену, дитя. Скорее!
      stop
    if not visited 'сова2-диалог1' and not where'зеркало' ^'#стена':
      return 'сова2-диалог1'
    if not visited 'сова2-диалог2':
      return 'сова2-диалог2'
    return 'сова2-диалог3'
  ~~~
  with:
    obj:
      words: глаза совы,глаза,дыр*
      nam: #глаза совы
      on:
        default: Тебе не нравятся эти глаза.
        exam(s): На месте глаз у совы зияют чёрные дырки.

room комната:
  words: комната
  dsc(s): ~~~do
    say "Это действительно твоя комната. Комната, которую ты покинула ещё совсем недавно. Перед тем... как вы уехали с мамой...^^\nТы видишь те же: стол, шкаф, кровать и книжные полки... И даже окно!"
    if not visited 'gotmirror':
      say Правда, мебель стоит неправильно и на стене нет зеркала. Интересно, куда оно подевалось?
    else:
      say Правда, мебель стоит неправильно.
      if where 'зеркало' ^ '#стена':
        say На стене висит зеркало.
    if seen 'королева2':
      say ^^В комнате, прислонившись к стене, стоит Снежная Королева. Ты видишь как поверхность зеркала мерцает фиолетовым светом.
    if where 'сова2' and where 'сова2' ^ '#стол':
      say ^^Полярная сова по прежнему сидит на твоём столе.
  ~~~
  enter(s): ~~~do
    if s:once():
      say За дверью оказалась лестница, которая вела наверх. Ты поднялась по ней и оказалась в ... своей комнате.
      move('голем', 'У замка')
    if visited 'gotmirror' and зеркало.seen and not сова2.finside:
      сова2.num = 0
      DaemonStart 'сова2'
  ~~~
  exit(s): ~~~do
    DaemonStop 'сова2'
    if not сова2.finside:
      remove 'сова2'
  ~~~
  onexit(s, t): ~~~do
    if seen 'королева2' and not t ^ 'комната2':
      say Если переход в зеркале закроется, ты никогда не вернёшься домой. Надо спешить!
      pass
  ~~~
  s_to,out_to: дверь
  with:
    obj:
      words: книжные полки/жр,мн|полки/мн,жр|полка/жр
      attrs: scenery, supporter
      description(s): ~~~do
        say Полки висят на стене прямо над столом.
        if where'сказки' == s and disabled 'сказки':
          say Они завалены школьными учебниками и тетрадками.
          say ^Ты видишь на одной из полок сказки Андерсена. Ты узнала книгу по голубому цвету обложки и золотым буквам на корешке.
          enable 'сказки'
          stop
        pass
      ~~~
      with:
        Useless:
          words: учебники
        Useless:
          words: тетрадки
        obj сказки:
          words: сказки/мн|книга
          attrs: openable
          disabled: true
          on:
            consult, search, open, exam(s): ~~~do
              if not have(s):
                say Сначала книгу нужно взять.
                stop
              if s:once():
                line "Ты открыла книгу на случайной странице. Буквы были знакомыми, но текст не читался.\nНе сразу, но все-таки ты сообразила, что слова написаны наоборот. С трудом ты прочитала следующее:^"
              say "{$fmt em|Стенами чертогам были вьюги, окнами и дверями буйные ветры. Сто с лишним зал тянулись здесь одна за другой так, как наметала их вьюга. Все они освещались северным сиянием, и самая большая простиралась на много-много миль. Как холодно, как пустынно было в этих белых, ярко сверкающих чертогах!}"
              say ^^Как странно...
            ~~~
    obj #стол:
      words: стол
      attrs: scenery, supporter
      on:
        push, pull, transfer: Пусть стоит там, где ему место.
      description(s): ~~~do
        say "За этим столом ты обычно делаешь... делала уроки."
        pass
      ~~~
    obj:
      words: шкаф
      attrs: scenery, openable, container, enterable
      on:
        push, pull, transfer: Пусть стоит там, где ему место.
      description(s): ~~~do
        say Платяной шкаф с твоей одеждой.
        if s:has open:
          say Шкаф открыт.
        pass
      ~~~
      inside_dsc: Ты находишься внутри шкафа.
      title: В шкафу
      with:
        Useless:
          words: одежда
    obj:
      words: кровать
      attrs: enterable, supporter, scenery
      on:
        enter: Хотя ты валишься с ног, ещё не время спать.
        push, pull, transfer: Пусть стоит там, где ей место.
    obj:
      words: окно
      nam: #окно
      attrs: scenery, openable
      on:
        enter: Это слишком опасно.
      description(s): ~~~do
        say В окне ты видишь пустынный белый пейзаж.
        if сова2.num >= 3 and not сова2.finside:
          say Ты видишь за окном полярную сову.
          move('сова2', here())
        pass
      ~~~
      when_open: Окно открыто. В твою комнату залетают колючие снежинки.
    Prop:
      words: стена|шуруп
      nam: #стена
      on:
        exam(s): ~~~do
          if where 'зеркало' ~= s:
            say На стене у шкафа висело зеркало. Сейчас его нет.
          else:
            say На стене висит зеркало.
        ~~~
    Prop:
      words: стены|потолок|пол|снежинки
    Prop:
      words: мебель
      on:
        exam: Здесь есть: стол, кровать, шкаф и полки.
  with: дверь

Useless:
  words: одежда

room "Зал с зеркалами":
  words: зал
  on:
    drop, throwat(s, w): ~~~do
      if not w ^ 'перо':
        pass
      if mp:check_held(w):
        stop
      if s.know:
        say Ты снова выпускаешь перо из рук и убеждаешься ещё раз, что метель дует с запада.
      else:
        say Ты выпускаешь перо из рук и видишь, как оно улетает строго на восток. Это значит, что метель дует с запада.
      move(w, s)
      s.know = true
    ~~~
  cant_go(s): Ты можешь плутать по залу вечность. Ты раздавлена его масштабами и не видишь смысла блуждать между зеркалами в поисках чего-либо, кроме пустоты.
  d_to(s): "Интересно, есть ли другие лестницы ведущие ещё глубже?"
  daemon(s): ~~~do
    if rnd(100) < 25:
      local t = { "Ты чувствуешь на своём лице дуновение холодного ветра."; "Рой маленьких колких снежинок ударяется в щёки."; "Снежинки снова и снова ударяются о твоё лицо."; "Небольшая метель метёт тебе прямо в глаза."; }
      say t[rnd(#t)]
  ~~~
  dsc: "Ты находишься в громадном зале. Ты даже боишься представить его размеры. Километры ледяных стен подсвеченные всполохами полярных сияний.\nВысокие колонны пронзают пространство зала. Куда хватает взгляда ты видишь, что зал заполнен зеркалами. По залу кружатся мелкие колючие снежинки.^^\nЗдесь есть спиральная лестница, ведущая наверх."
  e_to(s): ~~~do
    if not s.know:
      pass
    say "Ты решила осмотреть восточное направление. Ведь именно туда дула метель. Ты долго шла на восток, сверяясь с компасом и вглядываясь в бесконечную\nчереду зеркал, но так ничего и не обнаружила. Разочарованная, ты вернулась к лестнице."
  ~~~
  enter(s, f): ~~~do
    if f ^ 'Тронный зал':
      say "Это была очень длинная лестница без перил. Закручиваясь спиралью вокруг массивной колонны, она вела глубоко вниз.^\nОпасный и долгий спуск по скользким ступенькам занял продолжительное время и открыл твоему взору грандиозный вид."
    s:daemonStart();
  ~~~
  exit(s, t): ~~~do
    if t ^ 'Тронный зал':
      say Не без труда преодолевая скользкие ступени, ты покидаешь громадный зал.
    s:daemonStop()
  ~~~
  know: false
  o_to: #лестница
  u_to: Тронный зал
  w_to(s): ~~~do
    if not s.know:
      pass
    return 'портал1'
  ~~~
  with:
    obj:
      words: лестница
      nam: #лестница
      attrs: scenery
      on:
        enter, walk, climb(s): ~~~do
          walk 'Тронный зал';
        ~~~
      description: Широкая лестница без перил, закрученная спиралью вокруг массивной колонны, ведёт наверх -- к тронному залу.
    obj:
      words: колонны
      attrs: scenery
      description: Ты думаешь, что высота колонн может достигать пятидесяти метров.
    obj:
      words: колонна
      attrs: scenery
      description: Ледяная колонна уходит вертикально вверх. Ты думаешь, что высота колонны может достигать пятидесяти метров.
    obj:
      words: потолок|потолки
      attrs: scenery
      description: Потолок подсвечивается всполохами, похожими на полярное сияние.
    obj:
      words: пол|поверхность
      attrs: scenery
      description: Поверхность пола -- абсолютно гладкая ледяная поверхность.
    obj:
      words: стены|стена
      attrs: scenery
      description: Километры стен подсвечиваются всполохами, похожими на полярное сияние.
    obj:
      words: зеркала|зеркало
      attrs: scenery
      on:
        attack: Ты не разобьешь их всех.
        push, pull, transfer: Стоит ли это делать?
        search(s): ~~~do
          say Ты подошла к одному из зеркал и заглянула в него. Странно, но вместо своего отражения ты видишь нечто другое....^^
          local t = { "Небольшая комната. В ней ты видишь мужчину и женщину. У обоих раздражение на лице. В комнате ты видишь детскую кроватку."; "Ванная комната. Мужчина лет 40 бреется. Уголки губ опущены вниз."; "Помещение, напоминающее школьный класс. Сейчас он пуст. Только молодая учительница сидит за столом. Рядом с ней -- стопка тетрадей."; "Большой зал торгового центра. Ты видишь магазин с одеждой, заполненный посетителями."; "Аптека. Полки с лекарствами. Ты видишь провизора в белом халате. Это пожилая женщина."; "Спортивный зал. Натянута сетка. Дети играют в волейбол."; "Танцевальный зал. Много молодых людей и девушка - инструктор."; "Тёмная комната завалена хламом и пустыми бутылками. На диване лежит мужчина."; "За поверхностью зеркала -- темнота."; "Салон легковой машины. На заднем сидении сидит мальчик с грустными глазами."; "Мужской туалет. Все писсуары свободны."; }
          line t[rnd(#t)]
          say Изображение в зеркале статично. Словно кто-то сделал стоп-кадр. Ты отходишь от зеркала.
        ~~~
        take: Зачем тебе это?
        touch: Ты коснулась одного из зеркал. Холодное.
      description: "Зеркала повсюду. Они разной формы, разного размера. Они висят на колоннах, вморожены в глыбы льда, закреплены на фрагментах стен.\nТы даже боишься представить сколько их может быть здесь, в этом громадном зале."
    obj:
      words: снежинки|метель|ветер
      attrs: scenery
      on:
        listen: Тихо...
      description: Интересно, откуда здесь снег? Странно, но тебе кажется, что метель дует с определённого направления...
    obj:
      words: всполохи|сияние
      attrs: scenery
      description: Это похоже на полярное сияние. Правда, ты никогда не видела полярное сияние по-настоящему...

story портал1:
  text: "Ты решаешь осмотреть западное направление. Ведь именно оттуда дует метель и эта загадка требует ответа.^^\n\t\tТы идёшь на запад, сверяясь с компасом и вглядываясь в бесконечные зеркала. Сила ветра всё возрастает.^^\n\t\tИдти становится всё труднее и ты почти отчаялась, когда вдруг, ты замечаешь впереди нечто странное..."
  next_to: ледяное-пламя
  title: false

room ледяное-пламя:
  on:
    after disrobe(s, w): ~~~do
      if w ^ 'браслет':
        s.warm = 0
      pass
    ~~~
  cant_go: Ты можешь плутать по залу вечность. Ты раздавлена его масштабами и не видишь смысла искать здесь что-нибудь кроме пустоты.
  daemon(s): ~~~do
    if браслет:has worn:
      s.warm = s.warm + 1
      if s.warm == 3:
        say Ты чувствуешь, как браслет согревает твою руку.
      elseif s.warm == 4:
        say Ты чувствуешь, как от браслета на твоей руке по телу начинает разливаться тепло.
      elseif s.warm == 5:
        say Ты чувствуешь, как от браслета на твоей руке по телу разливается тепло.
      elseif s.warm > 5:
        say Ты чувствуешь, как браслет согревает тебя.
  ~~~
  dsc(s): ~~~do
    say "Ты видишь перед собой мерцающее свечение. Словно пламя огромного фиолетового огня, пучки сияния вырываются из постамента\nи уходят высоко вверх. Переплетаясь между собой, языки странного пламени не греют."
    if s.warm <= 5:
      say Наоборот, ты чувствуешь сильный всепроникающий холод.^^
    else:
      say Наоборот, они излучают пронзительный холод. К счастью, ты чувствуешь как браслет защищает тебя от него.^^
    say Ты пришла сюда с востока.
  ~~~
  enter(s): ~~~do
    s.warm = 0
    s:daemonStart()
  ~~~
  exit(s): ~~~do
    s:daemonStop()
  ~~~
  out_to,e_to: Зал с зеркалами
  title: У ледяного огня
  warm: 0
  with:
    obj #постамент:
      words: постамент
      attrs: scenery, supporter, enterable
      on:
        enter, climb(s): ~~~do
          mp:xaction("Enter", _'#пламя')
        ~~~
      description(s): ~~~do
        say Массивный постамент представляет из себя ледяную глыбу квадратной формы.
        pass
      ~~~
      with:
        obj #пламя:
          words: сияние|пламя|огонь|свечение
          on:
            default(s, ev, w): ~~~do
              if ev == 'ThrownAt' or ev == 'Receive':
                say "Тебе жаль расставаться с ", w:noun'тв', '. Ведь ты не сможешь забрать ', w:it'вн', ' назад.'
              else:
                say Как ты сделаешь это?
            ~~~
            enter(s): ~~~do
              if visited 'gotmirror':
                say Ты уже взяла то, что тебе было нужно.
                stop
              if here().warm <= 5:
                walk 'badend3'
              else:
                walk 'gotmirror'
            ~~~
            exam: Языки странного огня излучают холод.
            listen: Ты слышишь потрескивание.
            take: Это невозможно взять.
            touch(s): ~~~do
              if here().warm <= 5:
                say Твоя рука моментально начинает замерзать. Лучше не пытаться это делать.
              else:
                say Ты чувствуешь прохладу.
            ~~~
          dsc: На постаменте пылает ледяное пламя.

story badend3:
  text: "Превозмогая холод, ты поднимаешься на пьедестал и входишь в ледяное пламя.^^\n\t\tНепонятно, на какое чудо ты надеялась? Ледяное пламя охватывает тебя.^^\n\t\tТы успеваешь заметит, как твое тело превращается в лёд...^^\n\t\t{$fmt b|{$fmt c|КОНЕЦ}}"
  text: {$fmt r|{$fmt em|Но всё могло закончиться по другому...}}
  exit(): ~~~do
    pic_pop()
  ~~~
  next_to: ледяное-пламя
  onenter(): ~~~do
    pic_push '99'
  ~~~
  title: Конец

obj зеркало:
  words: зеркало
  on:
    attack(s): ~~~do
      if s.seen:
        say Там твоя мама!
      else:
        say Зачем разбивать зеркало, которое ты так долго искала?
    ~~~
    enter(s): ~~~do
      if seen 'королева2':
        walk 'комната2'
      else:
        pass
    ~~~
    puton(s, w): ~~~do
      if mp:check_held(s):
        stop
      if w ^ '#стена' and here() ^ 'комната':
        move(s, w)
        say Ты нашла в стене одинокий шуруп и повесила на него зеркало.
        stop
      pass
    ~~~
    search(s): ~~~do
      if here() ^ 'комната' and not сова2.finside and not s.seen:
        сова2.num = 0
        DaemonStart 'сова2'
      s.seen = true
      say "Вместо своего отражения, ты видишь в зеркале свою маму! {$fmt em|Настоящую} маму."
      if s:where() ^ '#стена':
        say Ты видишь в зеркале комнату. Все вещи в ней находятся на своих местах.
      if seen 'королева2':
        say Поверхность зеркала сияет фиолетовым светом.
    ~~~
    take(s): ~~~do
      if seen 'королева2':
        say Лучше как можно быстрее бежать отсюда!
        stop
      say Ты забираешь зеркало.
      move(s, pl)
    ~~~
    touch(s): ~~~do
      if seen 'королева2':
        say Твоя рука свободно проходит сквозь поверхность зеркала.
      else:
        say Какое оно холодное...
    ~~~
  description(s): ~~~do
    say Небольшое овальное зеркало.
    if seen 'королева2':
      say Поверхность зеркала сияет фиолетовым светом.
  ~~~
  seen: false

story gotmirror:
  text: "Ты входишь в ледяное пламя и странное свечение окутывает тебя со всех сторон.^^\n\t\tНичто живое не смогло бы пережить этот холод, но ты чувствуешь, как тебя согревает браслет матери.^^\n\t\tТы вглядываешься в фиолетовые языки ледяного пламени и вдруг замечаешь, что можешь охватить взором весь этот громадный зал.^^\n\t\tСотни тысяч зеркал, среди которых есть то, что ты ищешь...^^\n\t\tТы протягиваешь руки и вот -- ты уже держишь его! Зеркало из твоей комнаты. Ты выходишь из ледяного пламени."
  exit(s): ~~~do
    take 'зеркало'
    remove 'королева'
  ~~~
  next_to: ледяное-пламя
  title: false

story happyend:
  text: -- Ты что -- совсем рехнулась?
  text: ... Что ты устраиваешь?
  text: ... Я понимаю, ты не хочешь этого переезда, но надо держать себя в руках!
  text: ... Определённо, тебя надо показать психологу!
  text: ... Ты бы видела себя! Ты же способна сделать что угодно!
  text: -- Всё хорошо, мама. Я собрала вещи мы можем ехать.
  text: -- Что?
  text: -- Всё хорошо. У нас теперь всё будет хо-ро-шо!...
  exit(s): ~~~do
    pic_set '81'
  ~~~
  next_to: titles
  onenter(s): ~~~do
    pic_set '31'
  ~~~
  title: Конец

story yes:
  text: Звук твоих слов еще отражался от стен комнаты, когда ты услышала смех {$fmt em|другой} мамы.
  text: -- Как просто! Тебе так и не помог {$fmt em|её} талисман! Теперь я свободна!
  text: Ты снова услышала её дьявольский смех. А потом наступила тьма...
  next_to: Тьма
  title: false

room Тьма:
  attrs: ~light
  on:
    default: Отчаяние захватило тебя. Всё, что ты можешь делать это думать и плакать.
    think: Ты думаешь, что навсегда останешься здесь. Мама! Забери меня отсюда!
    wait: Проходит немного времени.
  before cry(s): ~~~do
    s.num = s.num + 1
    if s.num < 5 or have 'скрипка':
      say Тебя душат рыдания.
      if s.num == 1:
        say Но у тебя нет глаз, чтобы плакать.
      elseif s.num == 2:
        say Отчаяние захватило тебя.
      elseif s.num == 3:
        say Но можно ли плакать без глаз?
      else:
        say Ты едва сдерживаешься.
        if have 'скрипка':
          say Ты чувствуешь в своих руках скрипку.
    else:
      walk 'cry'
  ~~~
  before play(s, w): ~~~do
    if not w:
      w = скрипка
    if not w ^ 'скрипка':
      pass
    if not instead.tiny:
      snd.music ('mus/violin.ogg', 1)
    walk 'cry2'
  ~~~
  num: 0

story cry2:
  text: "Ты берёшь в руки скрипку и извлекаешь первые ноты.^^\n\t\tКомната наполнятся звуками.^^\n\t\tОтчаяние всё ещё душит тебя. Но постепенно под натиском музыки оно отступает.^^\n\t\tТы чувствуешь как музыка проникает сквозь стены, уносится вверх, спускается глубоко вниз. В самые глубины ледяного замка, в каждый его уголок...^^\n\t\t\"Дрянь! Дрянь! Дрянь!\" -- раздаётся искорёженный ненавистью голос.^^\n\t\t\"Дрянная девчонка!\" -- это {$fmt em|её} голос."
  text: {$fmt b|{$fmt c|ВСПЫШКА}}
  exit(): ~~~do
    remove 'сова2'
    move('королева2', 'комната')
    королева2.violin = true
    зеркало:attr enterable
  ~~~
  next_to: комната
  title: false

story cry:
  text: "Наконец, рыдания прорываются наружу и ты плачешь. Несмотря на то, что у тебя нет глаз, ты чувствуешь как по лицу текут тёплые слёзы.^^\n\t\t\"Дрянь! Дрянь! Дрянь!\" -- раздаётся искорёженный ненавистью голос.^^\n\t\t\"Дрянная девчонка!\" -- это {$fmt em|её} голос."
  text: {$fmt b|{$fmt c|ВСПЫШКА}}
  exit(): ~~~do
    remove 'сова2'
    move('королева2', 'комната')
    зеркало:attr enterable
  ~~~
  next_to: комната
  title: false

obj королева2:
  words: Снежная Королева|королева|женщина|другая мама
  attrs: scenery
  on:
    default: Лучше держаться от неё подальше.
    exam(s): ~~~do
      if s.violin:
        say Она закрывает уши руками. Ты видишь под её ладонями кровь.
      else:
        say Она закрывает лицо руками. Ты видишь под её ладонями кровь.
    ~~~
  each_turn(s): ~~~do
    local t = { "-- Дрянь! -- шипит Снежная Королева."; "Снежная Королева стонет."; "-- Я до тебя доберусь! -- произносит Снежная Королева."; }
    say t[rnd(#t)]
  ~~~
  violin: false

obj мама2:
  words: мама|мать
  attrs: animate
  on:
    touch, kiss: "Ты бросаешься маме на шею и обнимаешь её.^\n-- Мамочка!"
  description: Это твоя мама. Милая, родная мама!
  init_dsc: В комнате находится твоя мама. Немой вопрос застыл на её губах.
  talk_to(s): ~~~do
    if seen 'зеркало2':
      say Сначала нужно завершить кое-какое дело.
    else:
      walk 'happyend'
  ~~~

obj зеркало2:
  words: зеркало
  on:
    attack, take, remove(s): ~~~do
      say "Ты берёшь зеркало в руки и с размаху бросаешь на пол. Сотни мелких осколков разлетаются по всей комнате.^^\n-- Что, черт возьми, ты себе позволяешь? -- слышишь ты, наконец, голос мамы."
      remove(s)
    ~~~
    search: Тебе кажется, что ты видишь за зеркалом Снежную Королеву!
  description: Ты видишь, что поверхность зеркала имеет фиолетовый оттенок.
  init_dsc: На стене висит зеркало.

room комната2:
  dsc: Ты находишься в своей настоящей комнате. Все вещи находятся там, где и должны быть.
  enter(s): ~~~do
    line Ты бросаешься к зеркалу понимая, что это твой последний шанс на спасение.
    say Фиолетовое свечение заполняет всё и ты оказываешься... В своей комнате.
  ~~~
  out_to(): Сначала нужно завершить кое-какое дело.
  title: Комната
  with:
    Prop:
      words: вещи|кровать|стол|стул|шкаф|стена|осколки
  with: зеркало2, мама2

verb LookIn:
  words: смотреть
  patterns:
    - в|во {noun}/вн : Search

verb Sit:
  words: сесть
  patterns:
    - на {noun}/вн : Enter

lua:
~~~lua
if false then
global 'hint_num' (5)
function use_hint()
end
function mp:before_Think()
  if here() ^ 'Тьма' then
    return false
  end
  if here() ^ 'В машине' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову ]];
    if not visited'разговор1' then
      p [[поговорить с матерью.]]
    elseif not _'телефон'.seen then
      p [[смотреть в телефон.]]
    elseif have 'телефон' then
      p [[отдать телефон матери.]]
    elseif blizzard == 0 then
      p [[смотреть в окно.]]
    elseif blizzard == 1 then
      p [[поговорить с матерью.]]
    elseif blizzard < 11 then
      p [[ждать.]]
    else
      p [[выйти из машины.]]
    end
    return
  end
  if here() ^ 'поле' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову ]];
    if not have 'телефон' or not have 'браслет' then
      p [[осмотреть машину.]]
      if not _'бардачок':has'open' then
        p [[Затем открыть бардачок.]]
      else
        p [[взять всё из бардачка.]]
      end
    elseif not have 'скрипка' then
      p [[взять скрипку.]]
    elseif not _'телефон'.compass then
      p [[посмотреть в телефон. В нём есть компас.]]
    elseif not _'сова'.talked then
      if not seen 'сова' then
        p [[идти в лес.]]
      else
        if _'сова'.seen then
          p [[поговорить с совой.]]
        else
          p [[осмотреть сову.]]
        end
      end
    elseif not have 'перо' then
      p [[взять перо.]]
    else
      p [[идти в лес.]]
    end
    return
  end
  if here() ^ 'В лесу' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову ]];
    if not _'сова'.talked then
      if where'сова' ^ 'В лесу' then
        p [[ждать.]];
      else
        p [[идти на восток.]];
      end
    elseif not seen 'олень' or disabled 'олень' then
      p [[идти на запад.]]
    elseif not _'олень'.sit then
      p [[дать оленю перо.]]
    else
      p [[сесть на оленя.]]
    end
    return
  end
  if here() ^ 'Ледяные горы' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову ]]
    if _'#стена'.light == 0 then
      p [[дотронуться стены.]]
    else
      p [[войти в свечение.]]
    end
    return
  end
  if here() ^ 'пещера' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову ]]
    if mp:thedark() then
      p [[посветить телефоном.]]
    elseif disabled '#кристаллы' then
      p [[осмотреть свечение.]]
    elseif _'#кристаллы'.try < 2 then
      p [[постучать по кристаллам.]]
    elseif not _'#кристаллы'.broken then
      p [[играть на скрипке.]]
    elseif seen 'осколки' then
      p [[взять осколки.]]
    else
      p [[идти на северо-запад.]]
    end
    return
  end
  if here() ^ 'пещера2' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову ]]
    if not seen 'осколки' then
      if not have'осколки' then
        p [[идти на юго-восток.]]
      else
        p [[бросить осколки.]]
      end
    elseif mp:thedark() then
      p [[включить фонарик.]]
    else
      p [[идти на юго-запад.]]
    end
    return
  end
  if here() ^ 'обрыв' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову перепрыгнуть через обрыв.]]
    return
  end
  if here() ^ 'Другая сторона' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову выйти наружу.]]
    return
  end
  if here() ^ 'За ледяной стеной' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову идти к скале.]]
    return
  end
  if here() ^ 'У замка' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову ]]
    if disabled 'ворота' then
      p [[дать перо статуе.]]
    else
      p [[войти внутрь.]]
    end
    return
  end
  if here() ^ 'Тронный зал' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову ]]
    if visited 'gotmirror' and not _'зеркало'.seen then
      p [[посмотреть в зеркало.]]
    elseif _'браслет':hasnt'worn' then
      p [[надеть браслет.]]
    elseif not _'Тронный зал'.near then
      p [[подойти к матери.]]
    elseif not _'королева'.queen then
      p [[осмотреть мать.]]
    elseif not visited 'королева-диалог' then
      p [[поговорить с матерью.]]
    elseif disabled 'дверь' then
      p [[идти к голему.]]
    elseif not visited 'gotmirror' then
      p [[идти вниз.]]
    elseif _'дверь':has'open' then
      p [[идти в дверь.]]
    else
      p [[открыть дверь.]]
    end
    return
  end
  if here() ^ 'Зал с зеркалами' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову ]]
    if not _'Зал с зеркалами'.know then
      p [[бросить перо.]]
    elseif not have 'перо' then
      p [[взять перо.]]
    elseif visited 'gotmirror' then
      p [[идти наверх.]]
    else
      p [[идти на запад.]]
    end
    return
  end
  if here() ^ 'ледяное-пламя' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову ]]
    if visited 'gotmirror' then
      if not _'зеркало'.seen then
        p [[посмотреть в зеркало.]]
      else
        p [[идти на восток.]]
      end
    elseif _'ледяное-пламя'.warm <= 5 then
      p [[ждать.]]
    else
      p [[войти в пламя.]]
    end
    return
  end
  if here() ^ 'комната' then
    if use_hint() then
      return
    end
    p [[Тебе приходит в голову ]]
    if seen 'королева2' then
      p [[войти в зеркало.]]
      return
    end
    if not seen 'зеркало' and not have 'зеркало' then
      if not visited 'gotmirror' then
        p [[выйти из комнаты.]]
      else
        p [[идти и забрать зеркало оттуда, где ты его оставила.]]
      end
    elseif not _'зеркало'.seen then
      p [[Посмотреть в зеркало.]]
    elseif not _'сова2'.finside and _'сова2'.num < 3 then
      p [[ждать.]]
    elseif _'#окно':hasnt'open' and not _'сова2'.finside then
      p [[открыть окно.]]
    elseif not visited 'сова2-диалог1' and not visited 'сова2-диалог1' then
      p [[поговорить с совой.]]
    elseif not _'зеркало':where() ^ '#стена' then
      p [[повесить зеркало на стену.]]
    else
      p [[поговорить с совой.]]
    end
    return
  end
  if here() ^ 'Тьма' then
    return false
  end
  return false
end
end
~~~

lua:
~~~lua
function mp:Sing()
  p [[То, что ты учишься в музыкальной школе не означает, что ты хорошо поёшь.]]
end
~~~

verb Ring:
  words: [|по]звон/ить
  patterns:
    - Ring
  on(s): ~~~do
    if not have 'телефон':
      say У тебя нет телефона.
      stop
    if seen '#мама':
      say Тебе сейчас некому звонить.
      stop
    if телефон.compass:
      say Нет приёма.
      stop
    say Странно, нет приёма.
  ~~~

verb SwitchOn2:
  words: завести/,завед/и
  patterns:
    - ~ {noun}/вн :SwitchOn

verb WalkThrough:
  words: идти,иди
  patterns:
    - ~ сквозь {noun}/вн,scene :Enter

verb Give:
  words: дать,отда/ть,предло/жить,предла/гать,дам,даю,дадим
  patterns:
    - {noun}/вн,held {noun}/дт,scene : Give
    - ~ {noun}/дт,scene {noun}/вн,held : Give reverse
