lua:
~~~lua
function mp:Sing()
  p [[То, что ты учишься в музыкальной школе не означает, что ты хорошо поёшь.]]
end
~~~

verb Ring:
  words: "[|по]звон/ить"
  patterns:
    - "Ring"
  on(s): ~~~do
    if not have 'телефон':
      p "У тебя нет телефона."
      return
    if seen '#мама':
      p "Тебе сейчас некому звонить."
      return
    if _'телефон'.compass:
      p "Нет приёма."
      return
    p "Странно, нет приёма."
  ~~~

verb SwitchOn2:
  words: "завести/,завед/и"
  patterns:
    - "~ {noun}/вн :SwitchOn"

verb WalkThrough:
  words: "идти,иди"
  patterns:
    - "~ сквозь {noun}/вн,scene :Enter"

verb Give:
  words: "дать,отда/ть,предло/жить,предла/гать,дам,даю,дадим"
  patterns:
    - {noun}/вн,held {noun}/дт,scene : Give
    - ~ {noun}/дт,scene {noun}/вн,held : Give reverse
