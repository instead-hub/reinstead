name: t
lang: ru
include: stdlib

extend type attr: seen

class Tree:
  attrs: scenery

fn pick(s: obj) -> str: |
  when s:isa Tree:
    return [[дерево]]
  when s:has scenery:
    return [[декорация]]
  default:
    return [[прочее]]

obj box:
  words: коробка
  on Take: |
    local o = seen 'box'
    when o:
      o:attr seen
      say(pick(s))
    default:
      say [[не видно]]

extend type event: Gaze

impl box:
  on Gaze: |
    say [[смотрят]]
    local style = light
    if style == light:
      pass
    local e = Exam
    if e == Wear:
      say [[одежда]]
