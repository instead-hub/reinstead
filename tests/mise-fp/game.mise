game "t"

lang ru

include stdlib

extend type attr = seen

class Tree : scenery

fn mark(w: obj)
  w:attr seen

Tree tree "дерево"

impl tree
  before Take =
    for_plural s &mark
    trace s &mark
    if s:isa Tree
      [[дерево]]

# --- тестовая комната: транскрипт должен что-то видеть ---

room test_room "тестовая комната"
  dsc = "Тестовая комната."

impl tree
  found_in = test_room

fn start(load)
  player:move test_room
