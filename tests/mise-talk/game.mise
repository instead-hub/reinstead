name: talk
lang: ru
include: stdlib

global:
  met: false
  q1: 0

fn знакомы(s: obj) -> bool: |
  return met

setup:
  start: |
    player:move hall

room hall:
  words: зал
  dsc: [[Большой зал.]]

obj guide:
  words: гид,проводник
  dsc: [[Суровый гид.]]
  found_in: hall
  talk_to: разговор_с_гидом

talk разговор_с_гидом:
  intro: [[-- Здравствуйте, путник.]]

  option:
    when: not met
    ask: Что тут случилось?

    reply: -- Обвал в шахте.
    option:
      ask: Кто виноват?
      reply: -- Никто.
      do: |
        q1 += 1
    option:
      hidden: true
      ask: Секретный вариант
      reply: -- Тс-с-с.
      do: |
        q1 += 10
    option:
      only: true
      ask: Только один раз
      next: финал
  option:
    always: true
    say: Я скоро вернусь.
    do: |
      met = true
      walkout()
  option:
    ask: Расспросить
    reply: -- О чём?

    option:
      ask: О погоде
      reply: -- Ветрено.

    option:
      ask: О работе
      reply: -- Тяжело.

    onempty: |
      say -- Гид угрюмо молчит.
      met = true
      walkout()
  option:
    when: true
    ask: Всегда доступно
    reply: -- Да, всегда.
  option:
    when: false
    ask: Никогда
    reply: -- И не увидите.
  option:
    when: |
      return met
    ask: После знакомства
    reply: -- Мы уже виделись.
  option:
    when: &знакомы
    ask: Знакомы ли мы?
    reply: -- Похоже, да.

  label финал:
    say: -- Продолжение следует.
    option:
      ask: Спасибо.
      do: |
        met = true
        walkout()
