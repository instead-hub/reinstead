name: multi
lang: ru
include: stdlib

obj box:
  words: коробка

fn minmax(a: num, b: num) -> num, num: |
  if a < b:
    return a, b
  else:
    return b, a

fn swap(x: obj) -> obj, obj: |lua
  return x, x

fn fwd() -> num, num: |
  return minmax(1, 2)

fn single() -> num: |
  return minmax(1, 2)

fn cb(f: fn(n: num) -> num, num): |
  f(1)

fn caller(): |
  cb(&fwd)

fn demo(): |
  local lo, hi = minmax(3, 4)
  local a, b = minmax(1, 2), 9
  local c = minmax(5, 6)
  local p, q = swap(box)
  local o, i = lookup(where_list(box), box)
  p(minmax(7, 8))
