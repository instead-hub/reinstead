game "Вильгельм Телль"

lang ru

include stdlib

lua
  mp.undo = 5
  mp.score = 0
  mp.detailed_inv = true
  instead.notitle = false

const
  MAX_SCORE = 3

fn score_up()
  lua
    mp.score = mp.score + 1

fn cur_score() -> num = `mp.score`

fn BowOrArrow(o: obj?) -> bool
  if not o or o == bow or o.arrow
    return true
  "Это не похоже на оружие, не правда ли?^"
  pass

impl game
  hint_verbs = { "#Exam", "#Walk", "#Take", "#Drop", "#FireAt", "#Salute", "#Talk" }

class Prop : scenery
  before Exam pass
  before Default =
    say 'Вам нет нужды беспокоиться о ' (s:noun {пр}) '.'

class Furniture : static, supporter
  before Take, Pull, Push, PushDir = "Слишком тяжело."

class Arrow "стрела,стрел*"
  arrow = true
  description = "Все твои стрелы верны и остры."
  before Drop, Give, ThrowAt = "Ты не хочешь расставаться со своими острыми стрелами."

class NPC : animate
  life Answer,Ask,AskTo,AskFor,Tell =
    say 'Введите просто "говорить с ' (s:noun {тв}) '".'

impl game
  dsc = [[^Пример простой игры на Inform
^Авторы: Роджер Фирт (Roger Firth) и Соня Кессерих (Sonja Kesserich).
^Перевод Александра Мосьпана a.k.a. Ugo^
^Перенос на МЕТАПАРСЕР 3 выполнил Пётр Косых^^
Место: Альтдорф, кантон Ури, Швейцария. Год 1307. Швейцария под командованием Императора Альбрехта Габсбурга.
Его наместник -- фогт -- жестокий Герман Гесслер, повесил свою шляпу на вершине столба, установленного посередине
городской площади. Каждый проходящий мимо должен был кланяться этому ненавистному символу Императорского могущества.
^^
Ты, вместе с сыном, спустился от своего домика, расположенного высоко в горах, чтобы купить провизии. Ты -- гордый и
независимый мужчина, охотник и проводник, известный мастерством владения луком, и неумением скрывать своё презрение
к фогту, что, конечно, неумно, учитывая, сколько вокруг его солдат.
^^
Сегодня базарный день -- город забит людьми с окрестных деревень и селений.^]]

impl pl
  description = "Ты одет в традиционную одежду швейцарского горца."

fn init()
  player:move street
  bow:move player
  quiver:move player
  quiver:attr worn

room street "улица"
  title = "Улица Альтдорфа"
  n_to = below_square
  s_to =
    "Поток народа, движущийся на север, к площади, не даёт тебе пройти."
  Prop ворота "ворота"
    description = "Огромные деревянные ворота в городской стене. Они широко распахнуты."

Prop прилавки "прилавки|прилавок" @ street, below_square
  description = "Еда, инструменты, одежда -- обычное барахло."

Prop товары "товары|товар|еда|одежда|инструмент|барахло" @ street, below_square
  description = "Ничто не приковывает твой взгляд."

Prop торговцы "торговцы,купцы,продавцы,лавочники" : animate @ street, below_square
  description = [[Несколько жуликоватых, но довольно прилично выглядящих торговцев, откровенно преувеличивая,
расхваливают свой товар.]]

Prop жители "жители|люди|народ|толпа"
  description = "Горный народ, такой же, как и ты."
  found_in =
    return true

room below_square "улица"
  title = "Улица"
  dsc = [[Народ проталкивается от южных ворот к городской площади, располагающейся немного севернее.
Ты узнаёшь торговку за прилавком фруктово-овощной лавки.]]
  n_to = south_square
  s_to = street

Furniture stall "овощная лавка|лавка|прилавок,стол" : scenery @ below_square
  description = "Это всего лишь маленький стол с большой кучей картошки, кучкой морковки и репы, и парой яблок."
  before Search =
    xaction Exam s

Prop картошка "картошка|картофель" @ below_square
  description = "Должно быть, какой-то особенно ранний сорт... лет так на триста!"

Prop фрукты "фрукты/~од|овощи|морковь,морковка|репа,репка" @ below_square
  description = "Отличные местные овощи."

NPC stallholder "Хельга|торговка,продавщица,женщина|платье|шарф" @ below_square
  description = "Хельга -- полноватая жизнерадостная женщина, одетая в бесформенное платье и пёстрый платок."
  times_spoken_to = 0
  life Kiss = '"Ох, а ты дерзкий тип!"'

room south_square
  title = "Южный край площади"
  dsc = [[Узкая улица выходит на южный край городской площади, продолжаясь на дальней её стороне.
Чтобы продолжить путь к месту назначения -- сыромятне Йохансона -- ты должен пройти на север, через площадь,
в центре которой ты видишь отвратительный столб со шляпой Гесслера на верхушке. Если ты пойдёшь прямо,
придётся пройти мимо него. Солдаты императора грубо толкаются среди толпы, раздавая тумаки и громко ругаясь.]]
  n_to = mid_square
  s_to = below_square

Prop шляпа "шляпа,шапка|шест,столб" @ south_square, north_square
  before Default, Exam = "Издали плохо видно."

NPC guard "солдаты,стражники" : animate, scenery @ south_square, mid_square, north_square, marketplace
  description = "Неотёсанные, жестокие люди не из этих мест."
  before FireAt, Attack = "Их намного больше."
  before Talk = "Разговаривать с этими мерзавцами -- ниже твоего достоинства."

room mid_square "центр|площадь"
  title = "Центр площади"
  dsc = [[В центре площади давка совсем не такая сильная. Большинство людей предпочитают держаться подальше от столба,
на который нахлобучена эта нелепая церемониальная шапка. Группа солдат стоит неподалёку, осматривая всех, кто проходит.]]
  n_to = north_square
  s_to = south_square
  warnings_count = 0

Furniture pole "шляпа|столб|перо|шапка" : scenery @ mid_square
  description = [[Столб из соснового ствола диаметром в несколько дюймов и высотой в девять или десять футов.
На самой верхушке надёжно закреплена нелепая шляпа Гесслера из черной и красной кожи, с широкими
изогнутыми полями и пучком перьев из мёртвого гуся.]]
  has_been_saluted = false
  before FireAt = "Заманчиво, но ты не хочешь неприятностей."
  before Salute =
    s.has_been_saluted = true
    [[Ты отдаёшь честь шляпе на столбе.^^
"Благодарю вас, сэр", -- ухмыляется солдат.]]

room north_square
  title = "Северный край площади"
  dsc = "Узкая улочка ведёт на север от мощёной площади, в центре которой едва виднеется столб и шапка."
  n_to =
    "Вместе с Уолтером ты уходишь с площади, направляясь к сыромятне Йохансона."
    walk theend
  s_to =
    "Ты не можешь себя заставить снова пройти через это."

room marketplace
  title = "Рыночная площадь"
  dsc = [[Рыночная площадь Альтдорфа примыкает к центральной площади. Она была поспешно очищена от прилавков.
Группа солдат расталкивает людей, чтобы очистить место перед липой, которая растет тут с незапамятных
времён. Обычно в её тени собираются старики, чтобы посплетничать, поглазеть на девушек и поиграть в карты.
Но сегодня под ней никого нет, кроме Уолтера, которого привязали к стволу. Двое солдат удерживают тебя примерно
в сорока метрах от него.]]
  cant_go = "Что? Оставить своего сына связанным здесь?"

obj tree "липа|дерево" : scenery @ marketplace
  description = "Обычное большое дерево."

NPC governor "герцог|Гесслер,фогт,Герман" @ marketplace
  description = "Невысокий, коренастый, с противным лицом, Гесслер наслаждается властью, которую он имеет над этим городком."
  before Attack = "Как ты думаешь это сделать?"
  life Talk = "Ты не можешь заставить себя заговорить с ним."
  dict = { ["Гесслер/вн"] = "Геслера", ["Гесслер/рд"] = "Геслера", ["Гесслер/дт"] = "Гесслеру", ["Гесслер/тв"] = "Гесслером", ["Гесслер/пр"] = "Геслере" }

obj bow "лук" : clothing
  description = "Твой верный лук из тиса, с натянутой льняной тетивой."
  before Drop, Give, ThrowAt = "Ты никогда не расстаёшься со своим верным луком."

obj quiver "колчан" : container, open, clothing
  description = "Он сделан из козьей кожи и обычно висит за твоим левым плечом. В колчане есть стрелы."
  before Drop, Give, ThrowAt = "Но это ведь подарок твоей жены Хедвиг."

Arrow @ quiver

Arrow @ quiver

Arrow @ quiver

NPC son "сын,мальчик,мальчишка,парень|Уолтер" : transparent, scenery
  before Exam, Listen, Salute, Talk pass
  found_in =
    return true

obj apple "яблоко,яблочко"
  before Drop = "Вполне съедобное яблоко, не стоит его выбрасывать."
  before Eat = "Хельга дала его для Уолтера..."

impl mp : FireAt
  on FireAt =
    if not w
      "Ты не хочешь просто стрелять куда зря."
      stop
    if BowOrArrow wh
      "Немыслимо!"
    pass

verb FireAt
  words = "стреля/ть,стрельн/уть,целить/ся,застрели/ть,выстрел/ить"
  patterns =
    - "в {noun}/вн,scene : FireAt"
    - "~ {noun}/вн,scene : FireAt"
    - "~ ?в {noun}/вн,scene из {noun}/рд,held : FireAt"
    - "~ из {noun}/рд,held в {noun}/вн,scene : FireAt reverse"
    - "~ {noun}/тв,held в {noun}/вн,scene : FireAt reverse"

impl mp : Salute
  on Salute =
    if w:has animate
      if w:hint 'мн'
        say (w:Noun) ' приветствуют тебя.'
      else
        say (w:Noun) ' приветствует тебя.'
    else
      if w:hint 'мн'
        say (w:Noun) ' не замечают этого.'
      else
        say (w:Noun) ' не замечает этого.'

verb Salute
  words = "поклони/ться,честь"
  patterns =
    - "{noun}/дт,scene : Salute"

verb Salute2
  words = "мах/ать,помах/ать,помаш/и,маш/и"
  patterns =
    - "{noun}/дт,scene : Salute"

impl mp : Untie
  on Untie =
    "Ты не можешь развязать это."

verb Untie
  words = "развяз/ать,отвяз/ать,освобод/ить"
  patterns =
    - "{noun}/вн,scene : Untie"

impl street
  dsc =
    line [[Узкая улочка тянется на север, к городской площади. Местные жители стекаются в город через ворота на юге.
Они выкрикивают приветствия, предлагают товары, обмениваются новостями, с наигранным недоверием торгуются с
лавочниками, чьи прилавки сильно затрудняют движение.]]
    if s:once
      line '^"Держись поближе ко мне, сынок, -- говоришь ты. -- Иначе потеряешься в этой толпе".'

impl stallholder
  init_dsc =
    line "Хельга отвлекается от сортировки картошки, чтобы уделить тебе внимание."
    if s:once
      apple:move player
      line [[^"Привет, Вильгельм! Отличный денёк для торговли! Это твой Уолтер? О, как он вырос! Держи яблоко для него --
тут один край немного подгнил, но всё остальное хорошее. Как там фрау Телль? Передавай ей привет".]]
  life Talk =
    s.times_spoken_to += 1
    if s.times_spoken_to == 1
      score_up
      "Ты тепло благодаришь Хельгу за яблоко."
    elseif s.times_spoken_to == 2
      "Ещё увидимся!"
    else
      pass

impl mid_square
  before Walk =
    if compass_dir w == s_to
      s.warnings_count = 0
      pole.has_been_saluted = false
    if compass_dir w == n_to
      if pole.has_been_saluted
        [[^"Хорошего дня".^]]
        pass
      s.warnings_count += 1
      if s.warnings_count == 1
        [[Солдат преграждает тебе дорогу.^^
"Эй ты, сноб, забыл хорошие манеры? Как насчёт того, чтобы поклониться шляпе фогта?"]]
      elseif s.warnings_count == 2
        [["Я тебя знаю, ты Телль, мятежник, не правда ли?
Ладно, мы не хотим начинать тут драку, так что будь хорошим мальчиком,
отдай честь этой чёртовой шляпе, в третий раз я просить не буду".]]
      else
        [["Ладно, {$fmt u|господин} Телль, у вас серьёзные неприятности.
Я вежливо попросил, но вы оказались слишком гордым
и слишком глупым. Думаю, фогт захочет с вами немного побеседовать".^^
С этими словами солдаты хватают тебя и Уолтера, и пока сержант бежит докладывать Гесслеру,
они грубо тащат вас к старому липовому дереву, растущему на рыночной площади.^]]
        apple:move son
        player:move marketplace
      stop
    pass

impl tree
  before FireAt =
    if BowOrArrow w
      "Твоя рука слегка дрожит, и стрела входит в ствол на несколько дюймов выше головы Уолтера."
      walk theend

impl governor
  init_dsc =
    line "Гесслер с глумливым лицом наблюдает за происходящим с безопасного расстояния."
    if s:once
      line ([[^"Похоже, нужно преподать тебе урок, глупец. Никто не смеет проходить через площадь, не отдав дань
уважения Его Императорскому Высочеству Альберту. Никто, ты слышишь? Я мог бы лишить тебя головы за измену,
но проявлю снисхождение. Не жди моей милости, если снова проявишь подобную глупость, но в этот раз я отпущу
тебя... после того, как ты продемонстрируешь своё мастерство владения луком. Попади в это яблоко с того места,
где ты стоишь. Это не должно быть слишком сложным. Сержант, лови. Поставь его на голову этого мелкого ублюдка".]])
  before FireAt =
    if BowOrArrow w
      [[Прежде, чем солдаты успевают среагировать, ты разворачиваешься, и выпускаешь стрелу в Гесслера.
Она пронзает его сердце, и герцог оседает на землю. На мгновение толпа замирает в недоумении, но тут же
разражается криками ликования.]]
      walk theend

impl son
  description =
    if here == marketplace
      [[Он смотрит на тебя, пытаясь выглядеть спокойным и смелым. Его руки связаны за спиной.
Яблоко лежит в его светлых волосах.]]
      stop
    "Тихий светлый мальчик восьми лет, он быстро учится сельской работе."
  life Give =
    score_up
    w:move s
    [["Спасибо, пап".]]
  life Talk =
    if here == marketplace
      [["Стой спокойно, сынок, Господь нам поможет".]]
    else
      "Ты показываешь сыну несколько интересных мест в городе."
  before FireAt =
    if here == marketplace
      if BowOrArrow w
        "Упс! Наверняка вы имели в виду не это?"
        walk theend
      stop
    pass
  before Default =
    if here == marketplace
      "Солдаты не позволят тебе этого."
      stop
    pass

impl apple
  description =
    if here == marketplace
      "Отсюда ты едва видишь его."
    else
      "Яблоко зелёное, с коричневым пятном."
  before Default =
    if where s == son
      if here == marketplace
        "Отсюда ты едва видишь его."
        stop
      "Лучше оставить яблоко сыну."
      stop
    pass
  before FireAt =
    if here == marketplace
      if BowOrArrow w
        score_up
        [[Мягко и спокойно ты кладёшь стрелу на тетиву, оттягивая её, и, предельно
сконцентрировавшись, берёшь прицел. Задержав дыхание, не мигая, ты в ужасе
отправляешь стрелу в цель. Она летит через площадь к твоему сыну, и, пронзая яблоко, впивается
в дерево. Толпа взрывается криками радости. Гесслер остаётся разочарованным.]]
        walk happyend
      stop
    pass

ending theend
  title = "Конец"
  dsc =
    line 'Вы испортили любимую народную легенду.'
    say 'Ваш счет: ' (cur_score) ' из ' (MAX_SCORE)

ending happyend
  title = "Конец"
  dsc =
    line 'Поздравляю, вы прошли игру!'
    say 'Ваш счет: ' (cur_score) ' из ' (MAX_SCORE)
