name: Серое Сердце
version: 1.0
author: по мотивам новелл А. Грина и анимации П. Гримо
info: Романтическая фантасмагория о море, памяти и машине. Петроград, зима 1920 года.
lang: ru
fmt: dash, quotes
include: stdlib

setup:
  start: |
    move(player, 'набережная')

global:
  candle_lit: false
  matches_warm: false
  code_known: false
  clerk_saved: false
  guard_out: false
  lantern_lit: false
  corridor_shock: false
  phone_heard: false
  rats_cleared: false
  hall_unlocked: false
  arch_open: false
  poet_saved: false
  poet_lost: false
  bird_freed: false
  boss_banished: false
  doll_true: false
  corinna_awake: false
  type_done: false
  brand_spoken: false
  dep_open: false
  fake_tested: false
  medallion_shown: false
  tube_hit: false
  dnevnik: false

verb Type:
  words: [|на]печат/ать,отстуч/ать
  patterns:
    - {noun}/вн : Type

verb Rewrite:
  words: [пере|на]писать,нанести,[вы|на]бить
  patterns:
    - {noun}/вн : Rewrite

verb Play:
  words: играть,сыграть,исполнить
  patterns:
    - на {noun}/пр,held : Play
    - {noun}/вн,held : Play

class Path:
  attrs: scenery, enterable
  before Walk, Enter: |lua
    if mp:check_inside(std.ref(s.walk_to)) then return end
    walk(s.walk_to)
  Default: |lua
    if s.desc then p(s.desc) return end
    p([[Ты можешь пойти в ]], std.ref(s.walk_to):noun('вн'), '.')
  default_Event: Walk

room набережная:
  words: набережная,мойка,улица
  title: Набережная Мойки
  dsc(s): |
    say Петроград, глухая ночь января 1920 года. Мороз сорок градусов. Белый стылый сумрак над промёрзшей Мойкой. За чугунной оградой — гранитная громада бывшего Ссудного Банка, опутанная трубами. Над ней мерцает рубиновый глазок семафора. В ограде — приоткрытая калитка; за ней — высокое крыльцо с гранитным портиком. И странно: в мёртвом воздухе, в вое паропроводов, слышится глухой рокот прибоя. Здесь моря нет и быть не может. Но оно — есть. Три дня назад Сюзанна ушла сюда заложить материнский медальон и не вернулась.
    if not have 'спички':
      say На обледенелых ступенях подле пилона лежит фигура в рваном пальто. Пальцы мертвеца сжимают спичечный коробок.
  on:
    Listen(s, w): |
      say Ветер воет в растяжках труб. Под мостовой глухо ухает поршень. А поверх — далёкий рокот, которого здесь не должно быть. Море.
    Exam(s, w): |
      if w ^ 'труп':
        say Лицо — синяя маска. На искусанных губах — застывшая розовая пена. На шее — тёмный укус с медным отливом по краям.
      else:
        pass
  with:
    scenery труп:
      words:
        - труп,мертвец
        - фигура
        - пальто
      attrs: scenery
    obj спички:
      words:
        - спички
        - коробок
      on:
        Take(s, w): |
          say Вы разжали закоченевшие пальцы. Коробок заиндевел.
          pass
    Path путь_набережная_крыльцо:
      words:
        - крыльцо
        - портик
        - ступени
        - калитка
      walk_to: крыльцо
    scenery прочь:
      words:
        - прочь
        - уйти
      attrs: scenery
      on:
        Walk(s, w): |
          walk 'badend'
        Enter(s, w): |
          walk 'badend'

room крыльцо:
  words:
    - крыльцо
    - портал,портик
  title: Портал Банка
  dsc(s): |
    say Высокий гранитный портик. Массивные дубовые двери с бронзовыми львами приоткрыты. В пастях львов — латунные переговорные раструбы. Из щели тянет тёплым. В сорокаградусный мороз это странно. За спиной остаётся калитка на набережную.
  on:
    Exam(s, w): |
      if w ^ 'двери':
        say Створка подпёрта изнутри картонной пластиной с просечками. Кто-то вошёл и не вернулся.
      elseif w ^ 'раструб':
        say Из медных глоток — треск реле и сухое покашливание дежурного.
      else:
        pass
    Talk(s, w): |
      if w ^ 'раструб':
        say "Вход по нарядам канцелярии утилизации. Ожидайте вызова." И — тише, будто из-под воды: "...помогите..."
      else:
        pass
  with:
    scenery двери:
      words:
        - двери
        - дверь
        - львы
      attrs: scenery
    scenery раструб:
      words:
        - раструбы
        - раструб
        - глотки
      attrs: scenery
    scenery путь_крыльцо_набережная:
      words: набережная,калитка
      attrs: scenery
      on:
        Walk, Enter(s, w): |
          move(player, 'набережная')
    Path путь_крыльцо_вестибюль:
      words:
        - вестибюль
        - внутрь
        - вход
      walk_to: вестибюль

room вестибюль:
  words: вестибюль,зал,холл
  title: Парадный вестибюль
  dsc(s): |
    say Зал-колодец из белого мрамора, тронутый сажей. Потолок теряется в темноте, где в латунных трубах с шипением пролетают гильзы пневмопочты. Вдоль стен поднимаются чугунные шахты лифтов со шкалами до минус сорокового горизонта. В центре — остывшая буржуйка. На стене — высокие часы с маятником-гильотиной. За конторкой — чиновник в суконном вицмундире. Слева — тёмный проём гардеробной. Справа — низкая дверь караулки. За барьером, у стены, — буфетная. А в глубине, за шахтами лифтов, наверх ведёт широкая лестница — в галерею второго яруса.
    if not candle_lit and not have 'свеча':
      say На краю полированного барьера — толстая стеариновая свеча.
    if not candle_lit and have 'свеча':
      say Свеча у вас в руке. Белый толстый фитиль холоден.
    if candle_lit:
      say Огонёк выхватывает из мрака круг пола в два шага. Дальше — свинцовый полумрак, где за шахтами лифтов шевелятся тени.
  on:
    Listen(s, w): |
      say Ваш сапог скрипнул по крошке — и в вышине галереи щёлкнул соленоид. Распределитель пневмопочты перевёл стрелку, отмечая вас.
    Exam(s, w): |
      if w ^ 'часы':
        say Стрелки замерли на 4:12. Внутри — лихорадочный бег храповика: пружина взведена до предела. Маятник-гильотина блестит, как лезвие.
        set code_known = true
      elseif w ^ 'пневмопочта':
        say Латунные трубы втягивают воздух и со стуком выплёвывают гильзы с сургучной печатью. Каждая — чей-то приговор.
      else:
        pass
    Talk(s, w): |
      if w ^ 'клерк':
        if not clerk_saved:
          say Глаза чиновника отливают ртутной мутью. Он перфорирует ленту ручным компостером: "Приём прекращён. Души отписаны в амортизационный фонд Его Величества Механизма."
        else:
          say Он утыкается лбом в конторку: "Смотрите под ноги в галереях. Там провальные люки для недовольных."
      else:
        pass
    Show(s, w, wh): |
      if w ^ 'карточка' and have 'карточка':
        if not clerk_saved:
          say Компостер падает. Глаза расширяются. "Маша Бранд... Ордер на разборку за моим личным номером! Я подписал его за осьмушку чая и облатку сахарина. Возьмите ключ. Он отпирает парадный зал на втором этаже. Спасите тех, кого ещё не пустили на шестерни!"
          set clerk_saved = true
          enable ключ_клерка
          take ключ_клерка
        else:
          say Клерк уже видел карточку. Он лишь беззвучно вздрагивает, глядя в стол.
      else:
        pass
  with:
    obj свеча:
      words:
        - свеча
        - стеарин
      on:
        Burn(s, w): |
          if matches_warm and not candle_lit:
            say Спичка чиркнула жарко и сухо. Жёлтый огонёк встал над фитилём, оттеснив холодную тьму.
            set candle_lit = true
          elseif have 'спички' and not matches_warm and not candle_lit:
            say Серная головка обледенела и крошится. Спички нужно отогреть у тепла.
        Take(s, w): |
          say Вы взяли свечу. В городе, где жгут книги ради тепла, фунт стеарина — залог выживания.
          pass
    scenery часы:
      words:
        - часы
        - маятник
        - гильотина
      attrs: scenery
    scenery пневмопочта:
      words:
        - пневмопочта
        - трубы,гильзы
      attrs: scenery
    obj клерк:
      words: клерк,чиновник,дежурный
      attrs: animate
    scenery путь_вестибюль_крыльцо:
      words: крыльцо
      attrs: scenery
      on:
        Walk, Enter(s, w): |
          move(player, 'крыльцо')
    Path путь_вестибюль_гардероб:
      words: гардероб,гардеробная,проём
      walk_to: гардероб
    Path путь_вестибюль_охрана:
      words: охрана,караулка,дверь
      walk_to: охрана
    Path путь_вестибюль_буфет:
      words:
        - буфет
        - буфетная
        - барьер
      walk_to: буфет
    scenery путь_вестибюль_коридор:
      words:
        - коридор
        - лестница,галерея
        - наверх
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not candle_lit:
            say Лестница обрывается в темноту. Шагнуть без огня — сорваться в провал.
            stop
          move(player, 'коридор')

room гардероб:
  words: гардероб,гардеробная
  title: Парадный гардероб
  dsc(s): |
    say Ряды чугунных крючьев уходят в ледяную полутьму. Механические вешалки со скрипом перебирают пустоту. С лепного карниза свисают иглы сосулек, под ногами хрустит чёрная наледь. Позади — дверь в вестибюль.
    if not have 'осколок':
      say В лёд под разбитым трюмо вмёрз крупный осколок зеркала в серебряном ободе.
  on:
    Exam(s, w): |
      if w ^ 'вешалки':
        say Механические плечики перебирают пустоту. Лишь на одной стойке в глубине сиротливо качается забытая офицерская шинель.
      elseif w ^ 'пальто':
        say Шинель изъедена снизу мелкими зубами. В кармане — горсть сухих зёрен овса и обрывок морской карты: бухта, мыс, название города — Зурбаган.
      else:
        pass
    Listen(s, w): |
      say Сухой скрип промёрзшего камня. За панелями — тиканье десятков таймеров.
  with:
    obj осколок:
      words:
        - осколок
        - зеркало,стекло
      on:
        Take(s, w): |
          say Вы откололи тяжёлое стекло. В его амальгаме свет кажется обнажающим, сдирая с вещей искусственный лоск.
          pass
    scenery вешалки:
      words:
        - вешалки
        - плечики
        - крючья
      attrs: scenery
    scenery пальто:
      words:
        - пальто
        - шинель
        - карман
      attrs: scenery
    scenery путь_гардероб_вестибюль:
      words: вестибюль
      attrs: scenery
      on:
        Walk(s, w): |
          move(player, 'вестибюль')
        Enter(s, w): |
          move(player, 'вестибюль')

room буфет:
  words:
    - буфет
    - буфетная
  title: Офицерский буфет
  dsc(s): |
    say Разграбленные буфеты орехового дерева. На цинковой стойке — пустые коробки монпансье «Жорж Борман». У дальней стены гудит стальной калорифер с манометром. Под перевёрнутой чашкой прижат обрывок перфокарты. Позади — дверь в вестибюль.
  on:
    Exam(s, w): |
      if w ^ 'записка':
        say Торопливый почерк Сюзанны: «Они заперли меня на третьем подземном горизонте. Их предводитель носит золотую заводную корону. Я спрятала мамин медальон в прачечной. Если найдёшь — помни обо мне. Не верь их соловьям...»
      elseif w ^ 'калорифер':
        say Манометр подрагивает. Стальные рёбра вибрируют от пара из нижних котлов.
      elseif w ^ 'стойка':
        say Среди черепков — жестянка с сушёными морковными очистками. Суррогат чая голодного года.
      else:
        pass
    PutOn(s, w, wh): |
      if w ^ 'спички' and wh ^ 'калорифер' and not matches_warm:
        say Вы разложили коробок на горячих трубах калорифера. Лёд сошёл, серные головки оттаяли.
        remove спички
        set matches_warm = true
      else:
        pass
  with:
    scenery записка:
      words: записка,перфокарта,чашка
      attrs: scenery
    scenery калорифер:
      words:
        - калорифер,манометр
        - трубы
      attrs: scenery
    scenery стойка:
      words:
        - стойка
        - буфеты
        - коробки
      attrs: scenery
    scenery путь_буфет_вестибюль:
      words: вестибюль
      attrs: scenery
      on:
        Walk(s, w): |
          move(player, 'вестибюль')
        Enter(s, w): |
          move(player, 'вестибюль')

room охрана:
  words:
    - охрана,караулка
    - пост
  title: Дежурный пост
  dsc(s): |
    say Караулка с низким сводом. На стене вздрагивают латунные клапаны коммутатора. В полу — люк с решёткой, откуда тянет маслом, гарью и зерновой пылью. В железном шкафу, за спиной караульного, видна ветрозащитная лампа «Летучая мышь» в проволочном каркасе. За спиной — дверь в вестибюль.
    if not guard_out:
      say На табурете — караульный в форменной шинели. На голове — медный шлем с решётчатым забралом. Челюсти непрерывно жуют табак.
    if guard_out and not have 'лампа':
      say Железный шкаф распахнут. Лампа исчезла.
    if guard_out and have 'лампа' and not lantern_lit:
      say Лампа в руке. За толстым стеклом плещется керосин.
    if guard_out and lantern_lit:
      say Лампа горит ровным, устойчивым жёлтым пламенем, защищённым от сквозняков.
  on:
    Talk(s, w): |
      if w ^ 'сторож' and not guard_out:
        say Из-под шлема — глухой хрип: "Наряд аннулирован. Вы приписаны к механическому переплаву. Ждите сигнала."
      else:
        pass
    Exam(s, w): |
      if w ^ 'сторож' and not guard_out:
        say Из-под суконного рукава виднеются серые суставчатые пальцы с плоскими когтями.
      else:
        pass
    Show(s, w, wh): |
      if w ^ 'осколок' and have 'осколок' and not guard_out:
        say В зеркале отразилась крысиная морда, впаянная в шестерни шлема. Тварь зашлась визгом, бросила винтовку и скользнула в люк пневмосброса.
        set guard_out = true
      else:
        pass
  with:
    obj сторож:
      words: сторож,караульный,охранник
      attrs: animate
    obj лампа:
      words:
        - лампа
        - фонарь,летучая мышь
      on:
        Burn(s, w): |
          if candle_lit and not lantern_lit:
            say Вы поднесли свечу к фитилю. Керосин занялся ровным ярким пламенем.
            set lantern_lit = true
          elseif not candle_lit and not lantern_lit:
            say Не от чего зажечь фитиль. Сначала нужен открытый огонь.
        Take(s, w): |
          if not guard_out:
            say Сторож заслоняет шкаф, скаля резцы: "Руки прочь от казённого добра!"
            stop
          say Вы сняли с крюка фонарь. Проволочная корзина защитит стекло, а пламя — от тяги.
          pass
    scenery путь_охрана_вестибюль:
      words: вестибюль
      attrs: scenery
      on:
        Walk, Enter(s, w): |
          move(player, 'вестибюль')
    scenery путь_охрана_подвал:
      words:
        - подвал,люк
        - решётка
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not lantern_lit:
            say Ледяная тяга из шахты собьёт пламя свечи. Без закрытого фонаря — гибель.
            stop
          move(player, 'подвал')

room коридор:
  words:
    - коридор
    - галерея,анфилада
  title: Анфилада присутствий
  dsc(s): |
    say Парадная галерея второго яруса. Ковёр глушит шаги. Вдоль стен — ниши со статуями слепых богинь, держащих раструбы акустической проводки. На стене — чёрный аппарат «Эриксон» с двумя медными чашами звонков. Анфилада тянется мимо дверей: библиотека, архив, кабинет, будуар, бухгалтерия. В самом конце — высокие створки парадного зала. Позади, за поворотом, — лестница вниз, в вестибюль.
    if not corridor_shock:
      say Зловещая, гулкая тишина. Слышно лишь, как в висках молотом бьёт кровь.
    if corridor_shock and not phone_heard and not rats_cleared:
      say Оглушительный звон! Медные чаши взрываются набатом над головой.
    if phone_heard and not rats_cleared:
      say Трубка сорвана с медного рычага и качается на бронированном шнуре.
    if rats_cleared:
      say Телефон разворочен: обезумевшая стая вырвала его из стены.
  on:
    Look(s, w): |
      if not corridor_shock:
        say Вы вглядываетесь в своды — и тишину разрывает телефонный набат!
        set corridor_shock = true
        stop
      say Холодный мрамор, позолота, тишина.
    Listen(s, w): |
      if not corridor_shock:
        say Вы замерли у раструба — и прямо в ухо ударил яростный звонок!
        set corridor_shock = true
        stop
      say Только шорох ковра да далёкий гул в шахтах.
    Exam(s, w): |
      if w ^ 'статуи':
        if not corridor_shock:
          say Вы шагнули к нише, но телефон взорвался трезвоном над головой!
          set corridor_shock = true
          stop
        say Слепые богини с пустыми глазницами держат раструбы, вслушиваясь в каждый шорох.
      else:
        pass
    Open(s, w): |
      if w ^ 'путь_коридор_зал':
        if not corridor_shock:
          say Вы потянулись к замку, но медный звон оборвал сердце!
          set corridor_shock = true
          stop
        if have 'ключ_клерка' and not hall_unlocked:
          say Ключ провернулся. Створки зала ушли в пазы.
          set hall_unlocked = true
        elseif not have 'ключ_клерка' and not hall_unlocked:
          say Замок с фигурным пазом. Нужен специальный ключ.
      else:
        pass
    Play(s, w): |
      if w ^ 'флейта':
        if not corridor_shock:
          say Вы подняли инструмент, но треск звонков сорвал дыхание!
          set corridor_shock = true
          stop
        if have 'флейта' and not hall_unlocked:
          say Створки заперты броневыми жалюзи. Звук разобьётся о сталь.
        elseif have 'флейта' and hall_unlocked and not rats_cleared:
          say Вы поднесли флейту к губам и извлекли пронзительную ноту. В зале — вой. Механические люки распахнулись, и сотни серых теней с визгом посыпались через пробитые витражи наружу, в метель.
          set rats_cleared = true
      else:
        pass
  with:
    scenery трубка:
      words:
        - трубка
        - телефон,аппарат,рычаг
      attrs: scenery
      on:
        Take(s, w): |
          if not corridor_shock:
            say Вы сорвали трубку, заглушая звон. В мембране — механический голос: "Канцелярия брака. Код списания партии кукол — 709. Повторяю: семьсот девять. Сбросить в изолятор." И — тише, будто из-под воды: "...помогите..."
            set corridor_shock = true
            set phone_heard = true
            set code_known = true
            stop
          if not phone_heard and not rats_cleared:
            say Вы прижали трубку. Механический голос: "Канцелярия брака. Код списания партии кукол — 709." И тише: "...помогите..."
            set phone_heard = true
            set code_known = true
    scenery статуи:
      words: статуи,богини,ниши
      attrs: scenery
    scenery путь_коридор_вестибюль:
      words:
        - вестибюль
        - лестница
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not corridor_shock:
            say Вы попятились, но телефон взорвался звоном!
            set corridor_shock = true
            stop
          move(player, 'вестибюль')
    scenery путь_коридор_библиотека:
      words: библиотека
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not corridor_shock:
            say Вы шагнули к дверям, но раскатистый трезвон отшатнул вас!
            set corridor_shock = true
            stop
          move(player, 'библиотека')
    scenery путь_коридор_архив:
      words: архив
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not corridor_shock:
            say В тишине разорвался набат, эхом ударив по камню!
            set corridor_shock = true
            stop
          move(player, 'архив')
    scenery путь_коридор_кабинет:
      words: кабинет
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not corridor_shock:
            say Вы взялись за ручку, но визг аппарата за спиной замер!
            set corridor_shock = true
            stop
          move(player, 'кабинет')
    scenery путь_коридор_будуар:
      words: будуар
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not corridor_shock:
            say Звон хлестнул по ушам, сбив шаг!
            set corridor_shock = true
            stop
          move(player, 'будуар')
    scenery путь_коридор_бухгалтерия:
      words:
        - бухгалтерия
        - расчётная
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not corridor_shock:
            say Треск медных чаш сотряс галерею!
            set corridor_shock = true
            stop
          move(player, 'бухгалтерия')
    scenery путь_коридор_зал:
      words:
        - зал
        - створки
        - заседания
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not corridor_shock:
            say Звон сорвал тишину в клочья!
            set corridor_shock = true
            stop
          if not rats_cleared:
            say За дверями — чавкающий пир. Войти — гибель.
            stop
          move(player, 'зал')

room библиотека:
  words: библиотека
  title: Библиотека Правления
  dsc(s): |
    say Высокий зал с винтовыми чугунными лестницами. По рельсам вдоль полок скользят стремянки с захватами. На пюпитре — прикованный цепью фолиант чертежей. Пахнет пылью и кожей переплётов. Позади — дверь в галерею.
    if not dnevnik:
      say Между листами со схемами пневмоприводов зажат черновик записки с пятнами сажи.
  on:
    Exam(s, w): |
      if w ^ 'дневник' and not dnevnik:
        say «Они именуют себя Избавителями от страданий. Их логика проста: живой человек голодает, мёрзнет и мыслит. Заводной автомат, оживлённый человеческим сердцем, сыт и покорен. Сюзанну увели на нижний горизонт...»
        set dnevnik = true
      elseif w ^ 'полки':
        say Атласы по часовым механизмам, анатомия гидравлических кукол, финансовые гроссбухи. Среди них — старые морские карты: Зурбаган, Лисс, Гель-Гью. Схемы подключения живых вен к золотниковым коробкам помечены «Одобрено к производству».
      else:
        pass
  with:
    scenery дневник:
      words:
        - дневник,черновик
        - записка
      attrs: scenery
    scenery полки:
      words:
        - полки,атласы
        - карты
        - стеллажи
      attrs: scenery
    scenery путь_библиотека_коридор:
      words:
        - коридор
        - галерея
      attrs: scenery
      on:
        Walk(s, w): |
          move(player, 'коридор')
        Enter(s, w): |
          move(player, 'коридор')

room архив:
  words: архив
  title: Секретный архив
  dsc(s): |
    say Каземат без окон, освещённый дуговой лампой. Вдоль стен — стальные шкафы. За столом — женщина с землистым лицом и короткими волосами. На стене — огромное полотно в позолоченной раме. Позади — дверь в галерею.
    if arch_open:
      say Полотно сдвинуто по рельсам. В нише — круглая дверца сейфа, как корабельный люк.
  on:
    Exam(s, w): |
      if w ^ 'картина':
        say Залитый солнцем Зурбаган. Белые террасы, лазурная бухта, клипера на волне, акации. От полотна веет солью и теплом нагретого камня.
      elseif w ^ 'рама':
        if not have 'осколок' and not arch_open:
          say Рама сплошная, вмурованная в кладку.
        elseif have 'осколок' and not arch_open:
          say Сквозь скол видна зубчатая передача за позолотой. Полотно — на скрытых рельсах сейфа.
        else:
          say Полотно уже отъехало, открывая нишу с сейфом.
      else:
        pass
    Turn(s, w): |
      if w ^ 'код_архив' and not arch_open:
        if code_known:
          say Вы провернули лимб: 4-12-709. Свист воздуха, и картина отъехала в сторону.
          set arch_open = true
        else:
          say Вы вертите лимб наугад. Механизм молчит — нужно знать комбинацию.
      else:
        pass
    Talk(s, w): |
      if w ^ 'женщина' and not poet_saved and not poet_lost:
        say Она пишет карандашом на обороте ведомости. "Я записываю живой мир, пока город не переплавили в чугун. Пока звучит строка — автоматоны не победили."
      else:
        pass
    Yes(s, w): |
      if not poet_saved and not poet_lost:
        say "Пишите. Ваше слово сильнее всех шестерёнок". Женщина поднимает глаза: "Возьмите песнь о Зурбагане и карандаш. Она — для тех, чьё сердце не согласно стать механизмом."
        set poet_saved = true
        enable поэма
        take поэма
      else:
        pass
    No(s, w): |
      if not poet_saved and not poet_lost:
        say "Бросьте рифмы. В этом мире выживают сталью и пайками". Женщина гасит лампу и уходит во тьму.
        set poet_lost = true
      else:
        pass
    Enter(s, w): |
      if w ^ 'сейф_архив':
        if arch_open and have 'поэма':
          move(player, 'зурбаган')
        elseif arch_open and not have 'поэма':
          say Вы шагнули в люк, но упёрлись в глухую заслонку. Без живой мечты этот ход мёртв.
        else:
          say Сейф ещё закрыт.
      else:
        pass
  with:
    scenery картина:
      words:
        - картина
        - полотно
        - зурбаган
      attrs: scenery
    scenery рама:
      words: рама,позолота
      attrs: scenery
    obj женщина:
      words: женщина,поэтесса
      attrs: animate
    scenery стихи:
      words:
        - стихи
        - песнь,строка
      attrs: scenery
    scenery смирение:
      words:
        - смирение
        - покой,порядок
      attrs: scenery
    scenery сейф_архив:
      words:
        - сейф,люк
        - дверца
      attrs: scenery, enterable
    scenery код_архив:
      words:
        - код
        - комбинация
        - лимб,412709,709
        - цифры
      attrs: scenery
    scenery путь_архив_коридор:
      words:
        - коридор
        - галерея
      attrs: scenery
      on:
        Walk(s, w): |
          move(player, 'коридор')
        Enter(s, w): |
          move(player, 'коридор')

room кабинет:
  words: кабинет
  title: Кабинет Председателя
  dsc(s): |
    say Овальный зал в стиле ампир. В камине горят дрова. Вдоль стен — двадцать портретов хозяина: на каждом следующем он выше и величественнее. За пультом из красного дерева сидит господин в цилиндре и визитке. Под его ладонью — тяжёлая серебряная печать Правления. Рядом — модель парусника под стеклом, тонкая, как паутина. Позади — дверь в галерею.
    if not bird_freed:
      say На каминной полке в золочёной клетке — заводной соловей. Рубиновые глаза.
    if bird_freed:
      say Клетка пуста, дверца распахнута.
    if boss_banished:
      say Камин чадит. В кресле — цилиндр, опавшая визитка и горсть пепла.
    if boss_banished and not have 'печать':
      say На пульте — тяжёлая серебряная печать Правления.
  on:
    Exam(s, w): |
      if w ^ 'клетка':
        if not bird_freed:
          say В клетке — искусная латунная птица. При шаге её пружина сухо щёлкает, имитируя щебет.
        else:
          say Дверца распахнута настежь. Клетка пуста.
      elseif w ^ 'парусник':
        if not boss_banished:
          say Тонкая работа. Паруса — из пергамента, рангоут — из меди. На борту — имя: «Зурбаган». Хозяин держит его под стеклом, как держат сердце.
        else:
          say Модель парусника «Зурбаган» цела. Стекло треснуло от жара камина, но корабль уцелел.
      else:
        pass
    Open(s, w): |
      if w ^ 'клетка':
        if boss_banished and not bird_freed:
          say Вы откинули крючок. Соловей встрепенулся, издал чистую трель — словно свобода вдохнула душу в металл — и спорхнул на карниз открытой форточки, растворившись серебряным отблеском в метели.
          set bird_freed = true
        elseif bird_freed:
          say Клетка уже открыта, птица на свободе.
        else:
          say Хозяин кладёт ладонь на дверцу: "Не трогайте соловья. Он поёт только по моим законам."
      else:
        pass
    Talk(s, w): |
      if w ^ 'господин':
        if not boss_banished:
          say Он улыбается тонкой, нарисованной улыбкой. "Добро пожаловать. На улице — голод, тиф, тьма. А здесь — идеальный покой. Отдайте мне ваше зеркало, выпейте чаю с сахаром. Сюзанна вернётся к вам в фарфоре и шелках, совершенная и вечно молодая."
        else:
          say В кресле — лишь помятый цилиндр и опавшая визитка. Говорить не с кем.
      else:
        pass
    Show(s, w, wh): |
      if w ^ 'осколок' and have 'осколок' and not boss_banished:
        say Вы вскинули осколок перед его глазами. В амальгаме — плешивая крыса в золотой короне из шестерён. Тварь завизжала, дёрнула рычаг люка и провалилась в жерло мусоросброса.
        set boss_banished = true
      else:
        pass
    Give(s, w, wh): |
      if w ^ 'осколок' and have 'осколок' and not boss_banished:
        walk 'dollend'
      else:
        pass
  with:
    scenery клетка:
      words:
        - клетка
        - соловей
        - птица
      attrs: scenery
    scenery парусник:
      words:
        - парусник
        - модель
        - корабль
      attrs: scenery
    obj господин:
      words: господин,председатель,хозяин
      attrs: animate
    obj печать:
      words: печать
      on:
        Take(s, w): |
          if not boss_banished:
            say Господин накрывает печать ладонью: "Это печать Правления. Не торопите события."
            stop
          say Тяжёлая печать Правления: шестерня, обвитая колосьями, и корона.
          pass
    scenery путь_кабинет_коридор:
      words:
        - коридор
        - галерея
      attrs: scenery
      on:
        Walk(s, w): |
          move(player, 'коридор')
        Enter(s, w): |
          move(player, 'коридор')

room будуар:
  words: будуар
  title: Будуар кукол
  dsc(s): |
    say Будуар с лиловыми шелковыми обоями. В резном кресле — девушка фарфоровой красоты, пастушка из придворной сказки. Пахнет миндальным кремом, розовым маслом и часовой смазкой. Налево — дверь в галерею. В глубине комнаты — шёлковый альков, затянутый тяжёлой портьерой.
    if not doll_true:
      say Глаза опущены, веки сомкнуты, пальцы сжимают веер.
    if doll_true and not corinna_awake:
      say На затылке откинута золочёная крышка: внутри вращается латунный барабан шкатулки со стальными штифтами.
    if corinna_awake:
      say Взгляд куклы обрёл осмысленность и грусть. "Я слышу вас. Меня зовут Коринна. Я больше не заводная кукла тирана."
  on:
    Exam(s, w): |
      if w ^ 'девушка' or w ^ 'кукла':
        if not doll_true:
          say Она кажется спящей, но грудь неподвижна, а на запястьях — шарнирные головки с винтами.
      elseif w ^ 'альков':
        if corinna_awake:
          say За портьерой — потайная панель, отъехавшая в сторону: за ней узкий ход в изолятор кукол.
        elseif doll_true:
          say За портьерой — потайная панель, запертая пружинным ригелем. Механизм молчит, сколько ни нажимай.
        else:
          say За портьерой — глухая стена. Ни шва, ни скважины.
      else:
        pass
    Show(s, w, wh): |
      if w ^ 'осколок' and have 'осколок':
        if not doll_true:
          say В зеркале вместо шёлка — латунный скелет, пружинные тяги и микропоршни.
          set doll_true = true
        else:
          say В зеркале всё тот же холодный латунный каркас. Скрывать больше нечего.
      else:
        pass
    Rewrite(s, w): |
      if w ^ 'строка':
        if doll_true and have 'поэма' and not corinna_awake:
          say Карандашом поэтессы вы нанесли строфу о Зурбагане на барабан шкатулки. Музыка ожила хрустальным перезвоном. Кукла повернула голову: "Вы подарили мне душу. Я открыла потайной люк в изолятор кукол. Спешите! А в машинном зале вложите стихи в считывающий валик органа — остальное я сделаю сама."
          set corinna_awake = true
        elseif doll_true and have 'поэма' and corinna_awake:
          say Строфа уже выбита на барабане. Механизм Коринны оживлён.
      else:
        pass
    Talk(s, w): |
      if w ^ 'девушка' and corinna_awake:
        say "Торопитесь в изолятор! Я проберусь по вентиляционным каналам к машинному отделению и перехвачу тяги клапана."
      else:
        pass
  with:
    obj девушка:
      words: девушка,кукла,коринна,пастушка
      attrs: animate
    scenery строка:
      words:
        - строка,строфа
        - барабан
        - шкатулка
      attrs: scenery
    scenery альков:
      words:
        - альков
        - портьера,панель
      attrs: scenery
    scenery путь_будуар_коридор:
      words:
        - коридор
        - галерея
      attrs: scenery
      on:
        Walk, Enter(s, w): |
          move(player, 'коридор')
    scenery путь_будуар_кладовая:
      words:
        - кладовая
        - изолятор
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if corinna_awake:
            move(player, 'кладовая')
          elseif doll_true:
            say Пружинный ригель заперт снаружи. Коринна должна открыть его изнутри — но она ещё спит.
            stop
          else:
            say Тайник ещё не обнаружен.
            stop

room бухгалтерия:
  words:
    - бухгалтерия
    - расчётная
    - палата
  title: Расчетная палата
  dsc(s): |
    say Зал конторских столов, засыпанных перфолентами. В центре — пишущая машинка «Ундервуд», соединённая тягами с замками конторки. Позади — дверь в галерею.
    if not have 'карточка':
      say Из лотка торчит учётная карточка.
  on:
    Type(s, w): |
      if w ^ 'имя' and have 'карточка' and not type_done:
        say Вы отстучали: М-А-Р-И-Я. Литеры ударили по бумаге, и в тумбе стола отскочила крышка тайника.
        set type_done = true
      else:
        pass
    Exam(s, w): |
      if w ^ 'тайник' and type_done and not have 'ключ_подвала':
        say В тайнике — тяжёлый трёхгранный ключ от жалюзи машинного зала.
        enable ключ_подвала
        take ключ_подвала
      else:
        pass
  with:
    obj карточка:
      words:
        - карточка
        - учётная
      on:
        Take(s, w): |
          say Карточка на имя Марии Бранд, перфораторщицы. В графе: «Передана для сборки ритмического узла котельной».
          pass
    scenery машинка:
      words:
        - машинка
        - ундервуд
        - литеры
      attrs: scenery
    scenery имя:
      words:
        - имя
        - буквы
        - мария
      attrs: scenery
    scenery тайник:
      words:
        - тайник
        - тумба,крышка
      attrs: scenery
    scenery путь_бухгалтерия_коридор:
      words:
        - коридор
        - галерея
      attrs: scenery
      on:
        Walk(s, w): |
          move(player, 'коридор')
        Enter(s, w): |
          move(player, 'коридор')

room подвал:
  words: подвал,коллектор,тоннель
  title: Подземный коллектор
  dsc(s): |
    say Сводчатый тоннель из кирпича. Под ногами — сточная жижа. Пар со свистом вырывается из фланцев. Вдоль стен — пучки гидравлических шлангов. Пять люков ведут во тьму: один — наверх, в караулку; четыре — в котельную, мастерскую, депозитарий и прачечную.
  with:
    Path путь_подвал_охрана:
      words:
        - охрана,караулка
        - наверх
      walk_to: охрана
    Path путь_подвал_котельная:
      words: котельная
      walk_to: котельная
    Path путь_подвал_мастерская:
      words: мастерская,лаборатория
      walk_to: мастерская
    Path путь_подвал_депозитарий:
      words: депозитарий
      walk_to: депозитарий
    Path путь_подвал_прачечная:
      words: прачечная
      walk_to: прачечная

room котельная:
  words:
    - котельная
    - водогрейная
  title: Водогрейная секция
  dsc(s): |
    say Огромные котлы дрожат от давления. В поддувалах гудит пламя. Манометры бьются, выпуская струи пара. У топки — сгорбленный седой старик в кожаном фартуке со стальной лопатой. Позади — дверь в коллектор.
  on:
    Talk(s, w): |
      if w ^ 'кочегар':
        if not brand_spoken:
          say Старик хрипит сквозь вой пламени: "Я Бранд, старший механик пара. Сорок лет топлю котлы этого банка-ловушки. Теперь здесь жгут книги и жизни. Где моя Маша? Она ушла наверх за талонами и не вернулась."
        else:
          say "Запомнил мелодию? Замки сейфа настроены на водяной метроном в прачечной."
      else:
        pass
    Show(s, w, wh): |
      if w ^ 'карточка' and have 'карточка':
        if not brand_spoken:
          say Старик роняет лопату. "Значит, разобрали мою девочку на шестерни... Слушай и запоминай ритм восстания: семь долей вверх, четыре вниз — так усыпляют стаю и сбивают ход гигантских поршней. Флейта мастера — в сейфе депозитария." Он тихо напевает древнюю мелодию Крысолова.
          set brand_spoken = true
        else:
          say Старик уже знает правду о Маше. Он молча смотрит в пламя топок.
      else:
        pass
  with:
    obj кочегар:
      words: кочегар,старик,бранд,механик
      attrs: animate
    scenery котлы:
      words:
        - котлы
        - топка
        - пламя
      attrs: scenery
    Path путь_котельная_подвал:
      words: подвал,коллектор
      walk_to: подвал

room мастерская:
  words: мастерская,лаборатория
  title: Механическая лаборатория
  dsc(s): |
    say Лаборатория часовщика. Под потолком на цепях — разобранные анатомические автоматоны. На верстаках — шестерни, реторты с глицерином, хирургические пилы. Позади — дверь в коллектор.
  on:
    Exam(s, w): |
      if w ^ 'чертежи':
        say Чертежи шагающего парового автоматона. Примечание инженера: клапан имеет обратный конус золотника; если заклинить им распределитель — скопившийся конденсат вызовет сокрушительный гидроудар и разорвёт паровую машину изнутри.
      else:
        pass
  with:
    obj клапан:
      words: клапан,лепесток
      on:
        Take(s, w): |
          say Шедевр точной механики. Лепесток пружинит под пальцами, как живое маленькое сердечко.
          pass
    scenery чертежи:
      words:
        - чертежи,верстаки
        - автоматоны
      attrs: scenery
    Path путь_мастерская_подвал:
      words: подвал,коллектор
      walk_to: подвал

room депозитарий:
  words: депозитарий
  title: Главный депозитарий
  dsc(s): |
    say Круглая бронированная комната. Посреди зала — тяжёлый сейф-монолит с зубчатыми передачами и кодовым штурвалом. Позади — дверь в коллектор.
    if not dep_open:
      say Сейф закрыт шестью ригелями.
    if dep_open and have 'флейта':
      say Сейф распахнут, лоток пуст.
    if dep_open and not have 'флейта':
      say В сейфе — резная чёрная флейта с чеканными серебряными кольцами.
  on:
    Turn(s, w): |
      if w ^ 'код_депо' and not dep_open:
        if code_known:
          say Диски провернулись: 4-12-709. Стальная плита отошла в сторону.
          set dep_open = true
          enable флейта
        else:
          say Вы вертите лимб наугад. Механизм молчит — нужно знать комбинацию.
      else:
        pass
  with:
    scenery сейф_депо:
      words: сейф,штурвал,монолит
      attrs: scenery
    obj флейта:
      words:
        - флейта
        - инструмент
      disabled: true
      on:
        Take(s, w): |
          say Вы взяли инструмент Крысолова. Чёрное дерево под пальцами кажется живым и слегка теплеет.
          pass
    scenery код_депо:
      words:
        - код
        - комбинация
        - штурвал,412709,709
        - цифры
      attrs: scenery
    Path путь_депозитарий_подвал:
      words: подвал,коллектор
      walk_to: подвал

room прачечная:
  words:
    - прачечная
    - санитарная
  title: Санитарная прачечная
  dsc(s): |
    say Каменные чаны с щелочной пеной. Потолок рассечён трещиной, сквозь которую хлещет вода. Как будто где-то рядом, за стеной, шумит прибой. Позади — дверь в коллектор.
    if not have 'медальон':
      say На краю цинкового лотка поблёскивает вещица.
  on:
    Exam(s, w): |
      if w ^ 'вода':
        say Струя бьёт в таз мерно, как заводной механизм: 4 резких удара, 12 глухих капель, после паузы — частый плеск на 709 ударов. Ритм гидроаккумулятора.
        set code_known = true
      elseif w ^ 'чаны':
        say В баках замочена гражданская одежда. Людей раздевали здесь перед отправкой на конвейер.
      else:
        pass
  with:
    obj медальон:
      words:
        - медальон
        - вещица
      on:
        Take(s, w): |
          say Медный медальон Сюзанны — тот самый, материнский. Внутри — засушенный василёк и прядка материнских русых волос. Пахнет её духами и полынью.
          pass
    scenery вода:
      words:
        - вода,струя
        - таз
      attrs: scenery
    scenery чаны:
      words:
        - чаны,баки
        - одежда
      attrs: scenery
    Path путь_прачечная_подвал:
      words: подвал,коллектор
      walk_to: подвал

room зал:
  words: зал,колонный
  title: Колонный зал
  dsc(s): |
    say Парадная зала под куполом. Вдоль стен — столы с золотой посудой, дичью и графинами. Слева — дверь в галерею. Справа — низкая дверь кладовой. В глубине, за тяжёлой решёткой, — спуск к машинному залу.
    if not rats_cleared:
      say За столами пируют серые тени во фраках и лохмотьях. Звон золота, лязг зубов, блеск сотен бусинок глаз.
    if rats_cleared:
      say Столы опрокинуты, посуда разбита. В выбитые витражи врывается метель.
  on:
    Exam(s, w): |
      if w ^ 'столы':
        if not rats_cleared:
          say Блюда источают дурманящий аромат мяса и хлеба.
        else:
          say Разбитая посуда, перевёрнутые блюда. Ветер задувает свечи одну за другой.
      else:
        pass
    Eat(s, w): |
      if w ^ 'столы':
        if not rats_cleared:
          walk 'death_eat1'
        else:
          walk 'death_eat2'
      else:
        pass
  with:
    scenery столы:
      words:
        - столы
        - яства,блюда
        - пир
      attrs: scenery
    Path путь_зал_коридор:
      words:
        - коридор
        - галерея
      walk_to: коридор
    scenery путь_зал_кладовая:
      words:
        - кладовая
        - изолятор
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not rats_cleared:
            say За дверью — чавкающий пир. Не пройти.
            stop
          move(player, 'кладовая')
    scenery путь_зал_сердце:
      words:
        - сердце
        - решётка
        - машинный
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not have 'ключ_подвала':
            say Доступ преграждает тяжёлая решётка. Замок не сдвинуть без ключа.
            stop
          if not have 'печать':
            say Решётка поднята, но пульт заблокирован щитом с гербовым гнездом под печать Правления.
            stop
          move(player, 'сердце')

room кладовая:
  words:
    - кладовая
    - изолятор
  title: Изолятор кукол
  dsc(s): |
    say Мрачный склад. На мешках из-под отрубей, среди сломанных шестерён, неподвижно лежит фигура в синем креповом платье. Справа — дверь в зал. Слева, за штабелем ящиков, — узкая щель потайного хода в будуар.
    if not fake_tested:
      say Это Сюзанна! Лицо бледно, ресницы опущены, руки скрещены на груди.
    if fake_tested:
      say Зеркальный скол снял морок: перед вами механический манекен-ловушка.
  on:
    Exam(s, w): |
      if w ^ 'фигура':
        if have 'осколок' and not fake_tested:
          say Под восковой кожей — латунный каркас и взведённая пружина. Приманка! Настоящая Сюзанна жива и заперта у главного привода машины.
          set fake_tested = true
        elseif not have 'осколок':
          say Девушка кажется спящей, но неподвижность пугает. На запястье нет пульса.
      else:
        pass
    Touch(s, w): |
      if w ^ 'фигура':
        if not fake_tested:
          walk 'death_embrace'
        else:
          say Вы знаете, что это смертоносный муляж. Прикасаться — безумие.
      else:
        pass
  with:
    scenery фигура:
      words:
        - фигура,сюзанна
        - манекен
        - девушка
      attrs: scenery
    scenery путь_кладовая_будуар:
      words: будуар,тайник
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not corinna_awake:
            say Пружинный ригель заперт снаружи.
            stop
          move(player, 'будуар')
    scenery путь_кладовая_зал:
      words: зал
      attrs: scenery, enterable
      on:
        Walk, Enter(s, w): |
          if not rats_cleared:
            say За дверью — чавкающий пир. Не пройти.
            stop
          move(player, 'зал')

room сердце:
  words:
    - сердце
    - машинное
  title: Машинное отделение: Серое Сердце
  dsc(s): |
    say Подземная пещера, похожая на нутро железного исполина. В центре высится Серое Сердце — пульсирующий медно-чугунный агрегат высотой в три этажа, соединённый с трубами парового органа. В кварцевой колбе с прозрачным соляным раствором парит живая Сюзанна. Её дыхание соединено трубками с центральным регулятором машины. Позади — ход в зал, через поднятую решётку.
  on:
    Exam(s, w): |
      if w ^ 'колба':
        say Сюзанна жива. Сквозь толщу кварца видно, как слабо вздрагивают её веки. Она беззвучно шевелит губами — и в этом движении вы вдруг узнаёте голос, который уже слышали: там, в раструбе и в трубке, сквозь треск реле, — «...помогите...» Это была она.
      else:
        pass
    Show(s, w, wh): |
      if w ^ 'медальон' and have 'медальон' and wh ^ 'сюзанна':
        if not medallion_shown:
          say Сюзанна видит тусклый блеск меди и прижимает ладонь к стеклу изнутри. По её щеке бежит слеза. Дыхание выравнивается.
          set medallion_shown = true
        else:
          say Сюзанна по-прежнему прижимает ладонь к стеклу, не отрывая от вас преданного взгляда.
      else:
        pass
    Attack(s, w): |
      if w ^ 'колба':
        if not tube_hit:
          say Вы ударили по кварцу кулаком. Кварц отозвался глухим гулом и острой болью в суставах пальцев.
          set tube_hit = true
        else:
          say Кварц не поддаётся. Кулак уже саднит, а толку нет.
      else:
        pass
    Play(s, w): |
      if w ^ 'флейта' and have 'флейта':
        if brand_spoken:
          walk 'win1'
        else:
          say Дерево молчит под пальцами: вы не знаете напева. Старик у топок помнит ритм бунта.
      else:
        pass
    Insert(s, w, wh): |
      if wh ^ 'валик' and have 'поэма':
        if corinna_awake:
          walk 'win3'
        else:
          say Вы не знаете, как перенастроить сложную гидравлику органа на ритм строфы. Нужна помощь Коринны — той, что знает устройство машины.
      elseif wh ^ 'распределитель' and have 'клапан':
        if have 'ключ_подвала':
          walk 'win2'
        else:
          say Клапан не вогнать в шестерни голыми руками. Нужен тяжёлый трёхгранный ключ.
      else:
        pass
  with:
    scenery колба:
      words:
        - колба
        - кварц,цилиндр
      attrs: scenery
    obj сюзанна:
      words: сюзанна
      attrs: animate
    scenery валик:
      words:
        - валик
        - стихи
        - строфа
      attrs: scenery, container
    scenery распределитель:
      words:
        - распределитель
        - шестерни
        - золотники
      attrs: scenery, container
    scenery агрегат:
      words: агрегат,орган,колосс
      attrs: scenery
    Path путь_сердце_зал:
      words: зал
      walk_to: зал

room зурбаган:
  words:
    - зурбаган
    - гавань,пристань
  title: Зурбаган (Пространство мечты)
  dsc(s): |
    say Знойный полдень над гаванью. Пахнет просмолёнными канатами, апельсинами и морем. Белые паруса бригантин колышутся на лазурной воде. Здесь нет пайков, тифозной сыпи, доносчиков и шестерёнок мёртвого короля. Но в этом солнечном покое вы одни: Сюзанны здесь нет, и полдень кажется призрачным и неполным. Позади — сияющая арка, ведущая обратно в архив.
  on:
    Exam(s, w): |
      if w ^ 'море':
        say Бирюзовая гладь уходит к самому горизонту, где тает дымок далёкого парохода.
      elseif w ^ 'гавань':
        say Моряки в холщовых рубахах катят бочки с мускатом, с террасы кофейни доносится перебор мандолины.
      else:
        pass
    Wait(s, w): |
      walk 'win4'
  with:
    scenery море:
      words:
        - море
        - гладь
        - горизонт
      attrs: scenery
    scenery гавань:
      words:
        - гавань
        - моряки
        - бригантины
      attrs: scenery
    Path путь_зурбаган_архив:
      words:
        - архив
        - арка
      walk_to: архив

obj ключ_клерка:
  words: ключ клерка,ключ от зала
  disabled: true

obj поэма:
  words:
    - поэма,песнь
    - листок
  disabled: true

obj ключ_подвала:
  words: трёхгранный ключ,ключ от жалюзи
  disabled: true

ending badend:
  dsc: Вы поворачиваетесь и уходите в морозную тьму. За спиной остаётся гранитная громада — и Сюзанна, которую вы не спасли. Каждую ночь вы будете слышать в вое труб глухой рокот прибоя и голос: «...помогите...»

ending dollend:
  dsc: Вы положили скол на пульт. Господин нажал кнопку — пол опустился. Чашка сладкого чая коснулась губ. Мороз, боль, Сюзанна — всё исчезло в шелесте шестерёнок. Вы стали винтиком великого дворца, забыв собственное имя.

ending death_eat1:
  dsc: Голод лишил вас рассудка. Вы впились в холодное мясо. Вкус божествен, но мысли погасли. Под столом сработал пружинный люк — и вы скатились в яму к стае.

ending death_eat2:
  dsc: Вы подобрали с пола кусок замерзшего мяса. Блюда были пропитаны карболкой и трупным ядом. Спазм скрутил желудок, сознание угасло.

ending death_embrace:
  dsc: Вы бросились к ней и сжали в объятиях. Из рукавов выскочили стальные иглы, вонзившись в сердце. Вы застыли рядом — два экспоната дворцового склада.

ending win1:
  dsc: Вы поднесли флейту к губам и вывели древний напев Бранда. Звуки наполнили трубы парового органа. Многотонный колосс дрогнул, поршни замедлили бег и застыли. Кварцевый цилиндр опустился на помост и раскрылся. Вы подхватили Сюзанну на руки. Стальной гигант склонил чугунную главу, пробив стену дворца и открывая путь наружу. Вы вышли на волю, на морозную набережную живого Петрограда!

ending win2:
  dsc: Вы вставили стальной клапан в шестерни распределителя и вогнали его трёхгранным ключом. Зубья смяло. Скопившийся конденсат запер золотники — и сокрушительный гидроудар разорвал паровые цилиндры! Грохот и облака перегретого пара наполнили зал. Обжигаясь брызгами кипятка, вы вытащили полуживую Сюзанну сквозь пролом в фундаменте прямо на лёд Мойки. Дворец-машина повержен, но город остался один на один со свободной, голодной зимой.

ending win3:
  dsc: Бесшумно выступив из тени паропроводных труб, Коринна приняла листок и заправила его в приёмный валик органа. Грохот гидравлики сменился хрустальным перезвоном колокольчиков и шумом морского прибоя. Каменные своды темницы растаяли лёгким туманом. Вы стоите на прогретом солнцем молу Зурбагана. Белые чайки кружат над синей водой, а рядом открывает глаза живая, улыбающаяся Сюзанна.

ending win4:
  dsc: Вы бросили морозный ад Петрограда. Вы остались на залитой солнцем пристани, растворившись в вечном сияющем полдне. Сюзанна осталась там, во тьме дворца, но вы больше не помните её имени.

lua: |lua
  function mp:Play(w, wh)
    p "Сейчас не время для музыки."
  end

  function mp:Type(w, wh)
    p "Печатать можно только на машинке."
  end

  function mp:Rewrite(w, wh)
    p "Переписать это невозможно."
  end
