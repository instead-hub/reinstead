name: class
lang: ru
include: stdlib

class path(obj):
  attrs: scenery, enterable

props path:
  walk_to: ref

class darkroom(room):
  attrs: ~light

props darkroom:
  hall_note: num

room hall:
  words: зал
  dsc: [[Зал.]]

path way:
  words: тропа
  walk_to: hall

darkroom cellar:
  words: подвал
  dsc: [[Подвал.]]
  hall_note: 1
