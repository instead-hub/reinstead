game "t"

lang ru

include stdlib

impl mp : Any
  before Any =
    match ev
      Walk when w ->
        w:has door
    pass
  on Any =
    match ev
      Exam when w ->
        if w:has scenery
          [[осмотр декорации]]
      Wear ->
        [[надели]]
    pass                       # без pass обработчик Any съедает все действия

fn by_number(n: num) -> str
  match n
    1 -> return "один"
    2, 3 -> return "два-три"
    _ -> return "много"

fn by_word(t: str, loud: bool) -> str
  match t
    "да" when loud -> return "ДА"
    "да" -> return "да"
    "нет" -> return "нет"
    _ -> return "?"

impl game
  before Inv =
    say (by_number 3)
    say (by_word "да" true)
    say (by_word "да" false)
    say (by_word "нет" true)
    say (by_word "иное" false)

impl mp : Default
  on Default = [[нет обработчика]]

# --- тестовая комната: транскрипт должен что-то видеть ---

room test_room "тестовая комната"
  dsc = "Тестовая комната."

fn start(load)
  player:move test_room
