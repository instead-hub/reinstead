game "t"

lang ru

include stdlib

impl mp : Any
  before Any =
    if ev == Walk and w:has door
      [[дверь]]
  on Any =
    if ev == Exam and w:has scenery
      [[осмотр декорации]]
    elseif ev == Wear
      [[надели]]

impl mp : Default
  on Default = [[нет обработчика]]

# --- тестовая комната: транскрипт должен что-то видеть ---

room test_room "тестовая комната"
  dsc = "Тестовая комната."

fn start(load)
  player:move test_room
