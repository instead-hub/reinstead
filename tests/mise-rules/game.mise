game "t"

lang ru

include stdlib

impl mp : Any
  before Any =
    match ev
      Walk when w ->
        w:has door
  on Any =
    match ev
      Exam when w ->
        if w:has scenery
          [[осмотр декорации]]
      Wear ->
        [[надели]]

impl mp : Default
  on Default = [[нет обработчика]]

# --- тестовая комната: транскрипт должен что-то видеть ---

room test_room "тестовая комната"
  dsc = "Тестовая комната."

fn start(load)
  player:move test_room
