name: t
lang: ru
include: stdlib

class Box:
  attrs: container
  weight: 0

fn label(w: obj, n: str|num?, nn: num?) -> str: |
  if n and nn:
    return w:noun(n, nn)
  if n:
    return w:noun(n)
  return w:noun()

fn label2(w: obj, n: num?|str) -> str: |
  return w:noun(n)

fn on_take(s: Box): |
  if s.weight + 1 > 0:
    say [[тяжёлый]]
  say(label(s))
  say(label(s, 'им'))
  say(label(s, вн))
  say(s:noun(вн))
  say(s:noun('рд,2'))
  say(s:noun 'вн,мн')
  say(label2(s, 2))
  label(s, 1, 2)

Box crate:
  words: ящик

impl crate:
  before Take: use on_take
