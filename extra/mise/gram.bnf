(* gram.bnf — грамматика DSL mise (только не-Lua часть;
   содержимое |lua / lua: — произвольный Lua, здесь не описано).

   Нотация: EBNF. Отступы значимы (таб = 3 пробела); блок начинается
   после ":" и заканчивается дедентентом (INDENT/DEDENT/NEWLINE — как
   в грамматике Python). Комментарий — "#" в начале строки или отдельным
   словом, окружённый пробелами. *)

(* ---------- лексика ---------- *)
NEWLINE   ::= <конец строки>
INDENT    ::= <увеличение отступа>
DEDENT    ::= <уменьшение отступа>
IDENT     ::= [A-Za-z_] { [A-Za-z0-9_] }
CLASS     ::= [A-Z] { [A-Za-z0-9_] }                 (* имя класса *)
NAME      ::= IDENT | "#" IDENT                     (* тег: #окно, #глаза_совы *)
STRING    ::= '"' { <символ с escape \n \t \" \' \\> } '"'
            | "'" { <символ с escape \n \t \" \' \\> } "'"
LONG      ::= "[[" ... "]]" | "[=[" ... "]=]" | "[==[" ... "]==]"
NUMBER    ::= [ "-" ] <цифры> [ "." <цифры> ]
BOOL      ::= "true" | "false"
NIL       ::= "nil"
BARE      ::= <текст без кавычек до конца значения>
key       ::= <текст до ':' нулевого уровня>         (* вне кавычек и скобок *)

(* ---------- файл ---------- *)
file      ::= { top }
top       ::= meta | lang | fmt | include | require | evdecl
            | vars | setup | impl | fn | class | mixin | verb | extend
            | custom_type
            | talk
            | lua_section | decl | NEWLINE

meta      ::= ("name" | "version" | "author" | "info") ":" BARE
lang      ::= "lang" ":" ("ru" | "en")
fmt       ::= "fmt" ":" name_list
include   ::= "include" ":" name_list
require   ::= "require" ":" name_list
evdecl    ::= "event" EVENT ":" block
(* поля evdecl: on (mp.Event — действие), before/after (mp.before_/after_Event);
   имя регистрируется автоматически; EVENT — CamelCase *)
name_list ::= NAME { "," NAME }

vars      ::= ("const" | "global") ":" block

(* ---------- декларации объектов ---------- *)
decl      ::= kind [ NAME ] ":" block
kind      ::= "obj" | "scenery" | "room" | "door" | "story" | "ending"
            | CLASS
(* имена деклараций — только NAME (идентификатор/тег), кавычки запрещены;
   with/inside перечисляют голые NAME; поля-ссылки (n_to/out_to/door_to/
   talk_to/found_in/...) — голое NAME, строка-имя объекта — ошибка *)
block     ::= NEWLINE INDENT { field } DEDENT
field     ::= key [ "(" [ param { "," param } ] ")" ] ":" value
param     ::= IDENT [ ":" type ] | "..."
type      ::= base [ "?" ]
base      ::= "obj" | "str" | "num" | "bool" | "any" | "event" | "tbl"
            | "fn" | "nil" | IDENT
(* IDENT — перечисление из type или имя класса; "?" — optional: T или nil *)
(* обработчики — "<фаза> <Event>", Event в движковом регистре (Walk, Enter,
   SwitchOn, ...; Any/Default — тоже события); фаза обязательна:
   on — метод события (X = function...), before/after/post/life — префикс
   ("after Put", "before Turn, Tune", "life Give, Show"); без фазы —
   ошибка, и comma-ключ в impl требует фазы.
   Спец-ключи: with/inside (вложенные
   декларации или список ссылок), words/word, attrs, dict, disabled,
   found_in, переходы (n_to, out_to, ...), тексты *)

fn        ::= "fn" IDENT [ "(" [ param { "," param } ] ")" ]
              [ "->" type ] ":" value
(* value: блок |/|lua или inline-выражение в бэктиках (`#v`) *)
class     ::= "class" CLASS [ "(" IDENT ")" ] ":" block
mixin  ::= "mixin" CLASS ":" block
(* набор полей/обработчиков; привязка `mixins: A, B` в obj/class/impl *)

verb      ::= "verb" CLASS ":" block
(* поля verb: tag, words, patterns (список "- ..."), prio, hint;
   действия/обработчики — только в evdecl ("event ...") *)

extend    ::= "extend" "#" IDENT ":" block
(* поля extend: words, patterns, prio, hint;
   words: -> VerbExtendWord, только patterns: -> VerbExtend *)

custom_type ::= ("type" IDENT | "extend" "type" IDENT) ":"
                (name_list | list)
(* значения — голые имена без пробелов; кавычки запрещены; пустой type —
   ошибка; extend type с неизвестным именем — ошибка; ведущий элемент "~"
   в type включает отрицания (~X проверяется как X) *)

talk        ::= "talk" NAME ":" NEWLINE INDENT { talk_item } DEDENT
talk_item   ::= "intro" ":" value
              | "option" ":" talk_option
              | "label" IDENT ":" talk_option
talk_option ::= NEWLINE INDENT { talk_field } DEDENT
talk_field  ::= key ":" value
(* talk_field: ask/say/reply/do/when/goto/always/hidden/only/option(рекурсия) *)

setup     ::= "setup" ":" block
(* поля setup: dsc, fmt, take, hero, on, game, init, start *)
impl     ::= "impl" PNAME ":" block
PNAME     ::= [@#.\w-]+                            (* цель impl; без кавычек *)

lua_section ::= "lua" ":" "|lua" NEWLINE INDENT { lua_line } DEDENT

(* ---------- значения ---------- *)
value     ::= BARE | scalar | block | list | data
scalar    ::= STRING | LONG | NUMBER | BOOL | NIL | IDENT
list      ::= NEWLINE INDENT { "-" [ value ] NEWLINE } DEDENT
data      ::= "{" <сбалансированный Lua-литерал> "}"
            | "[" <сбалансированный Lua-литерал> "]"
(* BARE — текст без кавычек: в текстовых ключах (description, dsc, text,
   say, ask, reply, intro, ...) всегда строка; в остальных —
   строка, если не распознано как выражение/ссылка.
   words: строка или список строк (элементы — синонимы через ",", между
   элементами ставится "|").
   RAW (`...`) — legacy escape, вне грамматики.
   Значение-обработчик: value, либо "pass", либо "use IDENT". *)

(* ---------- логика (|) ---------- *)
logic_line ::= stop | pass | ret | if | for | local | break | stmt
stop      ::= "stop"
pass      ::= "pass"
ret       ::= "return" [ expr_list ]
if        ::= "if" expr ":" INDENT { logic_line } DEDENT
              { "elseif" expr ":" INDENT { logic_line } DEDENT }
              [ "else" ":" INDENT { logic_line } DEDENT ]
            | "when" expr ":" INDENT { logic_line } DEDENT
              { "when" expr ":" INDENT { logic_line } DEDENT }
              [ "default" ":" INDENT { logic_line } DEDENT ]
for       ::= "for" for_header ":" INDENT { logic_line } DEDENT
for_header::= IDENT "=" expr "," expr [ "," expr ]     (* числовой *)
            | IDENT { "," IDENT } "in" expr            (* generic *)
local     ::= "local" IDENT { "," IDENT } [ "=" expr_list ]
break     ::= "break"
stmt      ::= lvalue ( "=" | "+=" | "-=" ) expr_list    (* присваивание *)
            | call                                      (* вызов *)
lvalue    ::= IDENT { "." IDENT | "[" expr "]" }

(* ---------- выражения ---------- *)
expr_list ::= expr { "," expr }
expr      ::= <подмножество Lua: литералы, имена, поля, индексы, вызовы,
               унарные not/-/#/& (&имя — fn-значение), бинарные
               or/and/==/~/</>/../+/-/*/... >
call      ::= IDENT call_args
            | IDENT ":" IDENT call_args      (* obj:fn arg -> fn(obj, arg) *)
call_args ::= "(" [ expr_list ] ")"
            | STRING | LONG | IDENT          (* один хвостовой аргумент *)

(* Примечания (сахар поверх Lua-выражений):
   - say/line/append — обычные fn из include: stdlib
     (say(text: str, ...), line(...), append(text: str, ...));
   - скобки необязательны при 0/1 параметре (line, box:once, go_to space2);
     нуль-параметровые fn в выражениях вызываются сами (here.rotate, player);
   - хвостовой аргумент без скобок — ровно один IDENT, по типу параметра:
     str — сырой текст (say привет, radio:hasnt on), перечисление — голое
     значение (s:has light), event — имя события, obj — голое имя
     (have телефон, w:move зал); выражения (s.xxx и т.п.) — только в скобках;
   - строковый литерал в позиции объекта — ошибка (объекты не строки);
   - return имени объекта — без кавычек (return Тронный_зал);
   - ^ запрещён: сравнение объектов только через == (w == имя);
   - event-параметр и сравнение принимают голое имя события
     (xaction(Wear, s), ev == Exam);
   - #тег — ссылка на объект; статическая _'…' в логике запрещена;
   - |/|lua — блоки логики и Lua;
   - кавычки в именах/тегах/событиях/attrs/элементах списков запрещены. *)
