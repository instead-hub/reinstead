# stdlib: russian language part; pulled in by `include: stdlib` (lang: ru)

include: stdlib

fn where_prep(w: obj) -> str: |
  if has(w, supporter):
    return 'на'
  return 'в'

fn path_dsc(w: obj) -> str: |
  return '{#Me} {#word/мочь,нст,#me} пойти ' .. where_prep(w) .. ' ' .. noun(w, вн) .. '.'

lua: |lua
  --"мочь"
