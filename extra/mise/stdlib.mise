obj none:

type attr:
  - ~, animate, clothing, concealed, container, cutscene, door,
  - edible, enterable, gameover, light, lockable, locked, luminous,
  - moved, multi, on, open, openable, scenery, static, supporter,
  - switchable, transparent, visited, worn

type direction: n_to, ne_to, e_to, se_to, s_to, sw_to, w_to, nw_to, d_to, u_to, in_to, out_to

type case: им, рд, дт, вн, тв, пр, зв

type gram: ед, мн, 2, од, но, мр, жр, ср, имя, фам, разг

props obj:
  daemon: fn(s: obj)
  description: str | bool | fn(s: obj) -> str
  dsc: str | bool | fn(s: obj) -> str
  title: str | bool | fn(s: obj) -> str
  inv: str | bool | fn(s: obj) -> str
  inside_dsc: str | bool | fn(s: obj) -> str
  init_dsc: str | bool | fn(s: obj) -> str
  dark_dsc: str | bool | fn(s: obj) -> str
  each_turn: fn(s: obj)
  when_open: str | bool | fn(s: obj) -> str
  when_closed: str | bool | fn(s: obj) -> str
  when_on: str | bool | fn(s: obj) -> str
  when_off: str | bool | fn(s: obj) -> str
  scope: list | fn(s: obj, w: list)
  found_in: ref | tbl[ref] | fn(s: obj) -> bool
  talk_to: ref | fn(s: obj) -> ref
  with_key: ref | fn(s: obj) -> ref
  walk_to: ref
  default_Event: event | fn(s: obj) -> event
  capacity: num | fn(s: obj) -> num
  disp: str | fn(s: obj) -> str
  help: str | fn(s: obj) -> str
  gfx: str | fn(s: obj) -> str
  word: str | fn(s: obj) -> str
  raw_word: str | fn(s: obj) -> str

props room:
  cant_go: str | bool | fn(s: obj, to: direction) -> str
  compass_look: fn(s: obj, to: direction)
  onenter: fn(s: obj, w: obj)
  onexit: fn(s: obj, w: obj)
  enter: fn(s: obj, w: obj)
  exit: fn(s: obj, w: obj)
  n_to: ref | fn(s: obj) -> ref
  ne_to: ref | fn(s: obj) -> ref
  e_to: ref | fn(s: obj) -> ref
  se_to: ref | fn(s: obj) -> ref
  s_to: ref | fn(s: obj) -> ref
  sw_to: ref | fn(s: obj) -> ref
  w_to: ref | fn(s: obj) -> ref
  nw_to: ref | fn(s: obj) -> ref
  d_to: ref | fn(s: obj) -> ref
  u_to: ref | fn(s: obj) -> ref
  in_to: ref | fn(s: obj) -> ref
  out_to: ref | fn(s: obj) -> ref
  prev_to: ref | fn(s: obj) -> ref
  next_to: ref | fn(s: obj) -> ref

props door:
  from: ref
  to: ref
  door_to: ref | fn(s: obj) -> ref

props story:
  text: str | tbl[str] | fn(s: obj, n: num) -> str

props option:
  intro: str | fn(s: obj) -> str
  ask: str | fn(s: obj) -> str
  say: str | fn(s: obj) -> str
  reply: str | fn(s: obj) -> str
  onempty: fn(s: obj)
  when: bool | fn(s: obj) -> bool

type event:
  - Answer, Any, Ask, AskFor, AskTo, Attack, Blow, Burn, Buy, Climb, Close,
  - Consult, Cut, Default, Dig, Disrobe, Drink, Drop, Eat, Enter, Exam,
  - Exit, Fill, GetOff, Give, Insert, Inv, Jump, JumpOver, Kiss, LetGo,
  - LetIn, Listen, Lock, Look, LookUnder, Next, No, Open, Pull, Push,
  - PushDir, PutOn, Receive, Remove, Rub, Search, Show, Sing, Sleep,
  - Smell, Swim, SwitchOff, SwitchOn, Take, Talk, Taste, Tear, Tell,
  - Think, ThrowAt, ThrownAt, Tie, Touch, Transfer, Turn, Unlock, Use,
  - Wait, Wake, WakeOther, Walk, Wave, WaveHands, Wear, Yes

type phase: after, before, life, post

fn here() -> obj: |lua
  return here()

fn player() -> obj: |lua
  return me()

fn time(t: num?) -> num: |lua
  return time(t)

fn has(s: obj, a: attr) -> bool: |lua
  return s:has(a)

fn hasnt(s: obj, a: attr) -> bool: |lua
  return s:hasnt(a)

fn move(s: obj, where: obj): |lua
  move(s, where)

fn attr(s: obj, a: attr): |lua
  s:attr(a)

fn inside(w: obj, x: obj) -> bool: |lua
  return w:inside(x)

fn compass_dir(w: obj) -> direction?: `mp:compass_dir(w) or nil`

fn once(s: obj, t: str?) -> bool: |lua
  return s:once(t)

fn say(text: str|num|bool|obj|event, ...: str|num|bool|obj|event): |lua
  p(text, ...)

fn line(...: str|num|bool|obj|event): |lua
  pn(...)

fn append(text: str|num|bool|obj|event, ...: str|num|bool|obj|event): |lua
  pr(text, ...)

fn rnd(n: num) -> num: |lua
  return rnd(n)

fn xaction(ev: event, ...: obj): |lua
  mp:xaction(ev, ...)

fn subaction(ev: event, ...: obj): |lua
  mp:subaction(ev, ...)

fn daemonStart(w: obj): |lua
  DaemonStart(w)

fn daemonStop(w: obj): |lua
  DaemonStop(w)

fn enable(w: obj): |lua
  enable(w)

fn disable(w: obj): |lua
  disable(w)

fn place(w: obj): |lua
  place(w)

fn isDaemon(w: obj) -> bool: |lua
  return isDaemon(w)

fn getDaemons() -> list: |lua
  return getDaemons()

fn disabled(w: obj) -> bool: |lua
  return disabled(w)

fn for_plural(s: obj, f: fn(w: obj)): |lua
  s:for_plural(f)

fn trace(s: obj, f: fn(w: obj)): |lua
  return mp:trace(s, f)

fn isa(s: obj, cls: str) -> bool: `(((function(o) local m = getmetatable(s) while m do if m == o then return true end m = getmetatable(m) end return false end)(_G[cls])))`

fn seen(w: any) -> obj?: |lua
  return seen(w)

fn walk(where: obj): |lua
  walk(where)

fn walkin(where: obj): |lua
  walkin(where)

fn take(w: obj): |lua
  take(w)

fn drop(w: obj): |lua
  drop(w)

fn content(w: obj): |lua
  mp:content(w)

fn inv() -> list: |lua
  return inv()

fn len(v: tbl) -> num: `#v`

fn pairs(t: tbl): |lua
  return pairs(t)

fn ipairs(t: tbl): |lua
  return ipairs(t)

fn walkout(): |lua
  walkout()

fn visits(w: obj) -> num: |lua
  return visits(w)

fn event() -> event?: `mp.event`

fn xevent() -> event?: `mp.xevent or nil`

fn have(w: obj) -> obj?: |lua
  return have(w)

fn visited(w: obj) -> bool: |lua
  return visited(w)

fn access(s: obj) -> bool: |lua
  return s:access()

fn offerslight(w: obj) -> bool: |lua
  return mp:offerslight(w)

fn visible_scope(where: obj) -> obj?: |lua
  return mp:visible_scope(where)

fn where(w: obj) -> obj?: |lua
  return where(w)

fn inroom(w: obj) -> obj: |lua
  return inroom(w)

fn thedark(what: obj) -> bool: |lua
  return mp:thedark(what)

fn noun(s: obj, n: tbl[case|gram]|case|num?, nn: num?) -> str: |lua
  return s:noun_hint(n, nn)

fn Noun(s: obj, n: tbl[case|gram]|case|num?, nn: num?) -> str: |lua
  return s:Noun_hint(n, nn)

fn It(s: obj) -> str: |lua
  return s:It()

fn it(s: obj) -> str: |lua
  return s:it()

fn This(s: obj) -> str: |lua
  return s:This()

fn this(s: obj) -> str: |lua
  return s:this()

fn hint(s: obj, h: str): |lua
  s:hint(h)

fn multi_alias(s: obj) -> num: |lua
  return s:multi_alias()

fn gram(s: obj) -> tbl: |lua
  return s:gram()

fn walkback(w: obj?): |lua
  walkback(w)

fn remove(w: obj): |lua
  remove(w)

fn add(w: list, wh: obj): |lua
  w:add(wh)

fn del(w: list, wh: obj): |lua
  w:del(wh)

fn push(w: obj, ww: obj?): |lua
  push(w, ww)

fn pop(w: obj?, ww: obj?): |lua
  pop(w, ww)

fn empty(w: obj?) -> bool: |lua
  return empty(w)

fn from() -> obj: |lua
  return from()

fn check_held(w: obj) -> bool: |lua
  return mp:check_held(w)

fn check_live(w: obj) -> bool: |lua
  return mp:check_live(w)

fn check_touch() -> bool: |lua
  return mp:check_touch()

fn check_worn(w: obj) -> bool: |lua
  return mp:check_worn(w)

fn check_inside(w: obj) -> bool: |lua
  return mp:check_inside(w)

fn clear(): |lua
  mp:clear()

fn cls_prompt(): |lua
  mp:cls_prompt()

fn need_scene(s: obj, v: bool): |lua
  s:need_scene(v)

fn player_moved(): |lua
  player_moved()

fn lifeon(w: obj): |lua
  lifeon(w)

fn lifeoff(w: obj): |lua
  lifeoff(w)

fn call_before(s: obj, ev: event): |lua
  return std.call(s, 'before_' .. ev)

fn runmethods(what: phase, meth: event, ...: obj): |lua
  mp:runmethods(what, meth, ...)

fn runorval(w: obj, name: str, ...) -> any: |lua
  return mp:runorval(w, name, ...)

fn theme_name() -> str: |lua
  return theme.name()

fn pclr(): |lua
  std.pclr()

fn ref(name: str) -> obj?: |lua
  return std.ref(name)

fn arg_word(i: num) -> str: `(mp.args[i] or {}).word or ''`

fn tiny() -> bool: `instead.tiny`

fn music(name: str, ...): |lua
  snd.music(name, ...)

class Door(door):
  attrs: static
  walk_to: none
  description: |
    when here == s.from:
      say(way_dsc(s, s.to))
    when here == s.to:
      say(way_dsc(s, s.from))
  from: none
  to: none
  door_to: |
    if here == s.from:
      return s.to
    if here == s.to:
      return s.from
    pass

fn desc(s: obj) -> str?: `s.desc`

class Path:
  attrs: scenery, enterable
  walk_to: none
  before Walk, Enter: |
    if check_inside(s.walk_to):
      stop
    walk(s.walk_to)
  before Default: |
    local d = desc(s)
    if d:
      say d
      stop
    say(path_dsc(s.walk_to))
  default_Event: Walk
