obj none:

type attr: ~, alive, animate, broken, burning, clothing, coded, concealed, container, cutscene, device, door, drinkable, edible, enterable, fed, female, fixed, gameover, light, lockable, locked, luminous, male, moved, multi, noparser, on, open, openable, read, ring, scenery, seen, static, supporter, switchable, talkable, transparent, tuned, visited, worn

type direction: n_to, ne_to, e_to, se_to, s_to, sw_to, w_to, nw_to, d_to, u_to, in_to, out_to

fn here() -> obj: |lua
  return here()

fn player() -> obj: |lua
  return me()

fn has(s: obj, a: attr) -> bool: |lua
  return s:has(a)

fn hasnt(s: obj, a: attr) -> bool: |lua
  return s:hasnt(a)

fn move(s: obj, where: obj): |lua
  move(s, where)

fn attr(s: obj, a: attr): |lua
  s:attr(a)

fn inside(w: obj, x: obj) -> bool: |lua
  return w:inside(x)

fn compass_dir(w: obj) -> direction?: `mp:compass_dir(w) or nil`

fn once_tag(s: obj, t: str) -> bool: |lua
  return s:once(t)

fn once(s: obj) -> bool: |lua
  return s:once()

fn say(text: str, ...): |lua
  p(text, ...)

fn line(...): |lua
  pn(...)

fn append(text: str, ...): |lua
  pr(text, ...)

fn rnd(n: num) -> num: |lua
  return rnd(n)

fn xaction(ev: event, ...): |lua
  mp:xaction(ev, ...)

fn daemonStart(w: obj): |lua
  DaemonStart(w)

fn daemonStop(w: obj): |lua
  DaemonStop(w)

fn enable(w: obj): |lua
  enable(w)

fn disable(w: obj): |lua
  disable(w)

fn place(w: obj): |lua
  place(w)

fn isDaemon(w: obj) -> bool: |lua
  return isDaemon(w)

fn disabled(w: obj) -> bool: |lua
  return disabled(w)

fn seen(w: any) -> obj?: |lua
  return seen(w)

fn walk(where: obj): |lua
  walk(where)

fn walkin(where: obj): |lua
  walkin(where)

fn take(w: obj): |lua
  take(w)

fn drop(w: obj): |lua
  drop(w)

fn content(w: obj): |lua
  mp:content(w)

fn inv() -> tbl: |lua
  return inv()

fn len(v: tbl) -> num: `#v`

fn pairs(t: tbl): |lua
  return pairs(t)

fn ipairs(t: tbl): |lua
  return ipairs(t)

fn walkout(): |lua
  walkout()

fn visits(w: obj) -> num: |lua
  return visits(w)

fn event() -> event?: `mp.event`

fn have(w: obj) -> obj?: |lua
  return have(w)

fn visited(w: obj) -> bool: |lua
  return visited(w)

fn where(w: obj) -> obj?: |lua
  return where(w)

fn thedark(what: obj) -> bool: |lua
  return mp:thedark(what)

fn noun(s: obj, ...) -> str: |lua
  return s:noun(...)

fn Noun(s: obj, ...) -> str: |lua
  return s:Noun(...)

fn it(s: obj) -> str: |lua
  return s:It()

fn hint(s: obj, h: str): |lua
  s:hint(h)

fn multi_alias(s: obj) -> num: |lua
  return s:multi_alias()

fn walkback(...): |lua
  walkback(...)

fn remove(w: obj): |lua
  remove(w)

fn push(w: any): |lua
  push(w)

fn from() -> obj: |lua
  return from()

fn check_held(w: obj) -> bool: |lua
  return mp:check_held(w)

fn check_live(w: obj) -> bool: |lua
  return mp:check_live(w)

fn clear(): |lua
  mp:clear()

fn need_scene(s: obj, v: bool): |lua
  s:need_scene(v)

fn player_moved(): |lua
  player_moved()

fn lifeon(w: obj): |lua
  lifeon(w)

fn lifeoff(w: obj): |lua
  lifeoff(w)

fn call_before(s: obj, ev: event): |lua
  return std.call(s, 'before_' .. ev)

fn theme_name() -> str: |lua
  return theme.name()

fn pclr(): |lua
  std.pclr()

fn ref(name: str) -> obj?: |lua
  return std.ref(name)

fn arg_word(i: num) -> str: `(mp.args[i] or {}).word or ''`

fn tiny() -> bool: `instead.tiny`

fn music(name: str, ...): |lua
  snd.music(name, ...)

class Door(door):
  attrs: open
  from: none
  to: none
  door_to: |
    if here == s.from:
      return s.to
    if here == s.to:
      return s.from
    pass

class Path:
  attrs: scenery, enterable
  before Walk, Enter: |lua
    if mp:check_inside(std.ref(s.walk_to)) then return end
    walk(s.walk_to)
  Default: |lua
    if s.desc then p(s.desc) return end
    p([[Ты можешь пойти в ]], std.ref(s.walk_to):noun('вн'), '.')
  default_Event: Walk
