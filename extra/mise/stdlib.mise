fn here() -> obj: |lua
  return here()

fn player() -> obj: |lua
  return me()

fn has(s: obj, a: str) -> bool: |lua
  return s:has(a)

fn hasnt(s: obj, a: str) -> bool: |lua
  return s:hasnt(a)

fn move(s: obj, where: obj): |lua
  move(s, where)

fn attr(s: obj, a: str): |lua
  s:attr(a)

fn inside(w: obj, x: obj) -> bool: |lua
  return w:inside(x)

fn compass_dir(w: obj) -> str: |lua
  return mp:compass_dir(w)

fn once_tag(s: obj, t: str) -> bool: |lua
  return s:once(t)

fn once(s: obj) -> bool: |lua
  return s:once()

fn say(text: str, ...): |lua
  p(text, ...)

fn line(...): |lua
  pn(...)

fn append(text: str, ...): |lua
  pr(text, ...)

fn rnd(n: num) -> num: |lua
  return rnd(n)

fn xaction(ev: event, ...): |lua
  mp:xaction(ev, ...)

fn daemonStart(w: obj): |lua
  DaemonStart(w)

fn daemonStop(w: obj): |lua
  DaemonStop(w)

fn enable(w: obj): |lua
  enable(w)

fn disable(w: obj): |lua
  disable(w)

fn place(w: obj): |lua
  place(w)

fn isDaemon(w: obj) -> bool: |lua
  return isDaemon(w)

fn disabled(w: obj) -> bool: |lua
  return disabled(w)

fn seen(w: any) -> bool: |lua
  return seen(w)

fn walk(where: obj): |lua
  walk(where)

fn walkin(where: obj): |lua
  walkin(where)

fn take(w: obj): |lua
  take(w)

fn drop(w: obj): |lua
  drop(w)

fn content(w: obj): |lua
  mp:content(w)

fn walkout(): |lua
  walkout()

fn visits(w: obj) -> num: |lua
  return visits(w)

fn event() -> event: |lua
  return mp.event

fn have(w: obj) -> bool: |lua
  return have(w)

fn visited(w: obj) -> bool: |lua
  return visited(w)

fn where(w: obj) -> obj: |lua
  return where(w)

fn thedark(what: obj) -> bool: |lua
  return mp:thedark(what)

fn noun(s: obj, c: str) -> str: |lua
  return s:noun(c)

fn Noun(s: obj) -> str: |lua
  return s:Noun()

fn it(s: obj) -> str: |lua
  return s:It()

fn hint(s: obj, h: str): |lua
  s:hint(h)

fn multi_alias(s: obj) -> num: |lua
  return s:multi_alias()

fn walkback(...): |lua
  walkback(...)

fn remove(w: obj): |lua
  remove(w)

fn push(w: any): |lua
  push(w)

fn from() -> obj: |lua
  return from()

fn check_held(w: obj) -> bool: |lua
  return mp:check_held(w)

fn check_live(w: obj) -> bool: |lua
  return mp:check_live(w)

fn clear(): |lua
  mp:clear()

fn need_scene(s: obj, v: bool): |lua
  s:need_scene(v)

fn player_moved(): |lua
  player_moved()

fn lifeon(w: obj): |lua
  lifeon(w)

fn lifeoff(w: obj): |lua
  lifeoff(w)

fn call_before(s: obj, ev: event): |lua
  s['before_' .. ev](s)

fn theme_name() -> str: |lua
  return theme.name()

fn pclr(): |lua
  std.pclr()

fn ref(name: str) -> obj: |lua
  return std.ref(name)

fn arg_word(i: num) -> str: |lua
  return mp.args[i] and mp.args[i].word or ''

fn tiny() -> bool: |lua
  return instead.tiny

fn music(name: str, ...): |lua
  snd.music(name, ...)
